--[[
    VX_Visuals v3.2.2
    - RacingChaseCamera: Ultra-smooth 3-axis car-following chase camera (Pitch, Yaw, Roll),
      low centered perspective (~15 deg lower angle, car in middle of screen),
      PC right-click + Mobile touch look-around with 2s post-release smooth auto-return,
      speed pullback & anti-clip raycast
    - 15s Idle Showcase Camera (active whenever RacingChaseCamera is ON):
      4-shot cinematic orbit cycle with smooth dolly transitions, telephoto FOV & seamless drive exit
    - Camera FOV dynamics, RPM vibration, shift/launch jolts, body tilt & exhaust flames
]]

local VX = _G.VX
if not VX or not VX.Framework then error("VX_Visuals requires VX_Kernel") end

local Players          = game:GetService("Players")
local RunService       = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local Camera           = workspace.CurrentCamera

local Module = VX.Framework.Module.new({
    Name = "Visuals",
    Dependencies = { "Core", "Authority", "Powertrain", "DriveSystem" },
    Version = "3.2.2",
})

local STUDS_TO_MPH = 0.626
local DEFAULT_FOV  = 70
local BASE_PITCH_RAD = -math.rad(6)
local RECENTER_DELAY = 2.0
local IDLE_SHOWCASE_DELAY = 15.0
local SHOWCASE_SHOT_DURATION = 6.5

local SHOWCASE_SHOTS = {
    { yawStart = 0.65,  yawRate = 0.20, pitch = -math.rad(6),  distMult = 0.88, roll = math.rad(3.0),  fov = 62, focusSide = 0.0, focusFwd = 0.5 },
    { yawStart = 1.35,  yawRate = 0.14, pitch = -math.rad(3),  distMult = 0.74, roll = math.rad(-2.0), fov = 58, focusSide = 0.4, focusFwd = 1.0 },
    { yawStart = 2.65,  yawRate = 0.18, pitch = -math.rad(13), distMult = 1.02, roll = math.rad(2.5),  fov = 65, focusSide = 0.0, focusFwd = -0.6 },
    { yawStart = -1.20, yawRate = 0.16, pitch = -math.rad(20), distMult = 1.18, roll = 0.0,            fov = 68, focusSide = 0.0, focusFwd = 0.0 },
}

local function _wrapAngle(a)
    return ((a + math.pi) % (2 * math.pi)) - math.pi
end

local function _lerpAngle(a, b, t)
    local diff = _wrapAngle(b - a)
    return a + diff * t
end

function Module:Construct()
    self.lastCameraUpdate = 0
    self.currentFOV = DEFAULT_FOV
    self.vibPhase = 0
    self.joltOffset = Vector3.new()
    self.joltVelocity = Vector3.new()
    self.tiltC0 = nil
    self.lastFlameTime = 0
    self.lastRemotePulseTime = 0
    self._flameSeq = 0
    self._renderBound = false
    self._conns = {}

    -- Racing Chase Camera state
    self._chaseActive = false
    self._chaseRot = nil
    self._chasePos = nil
    self._smoothLook = nil
    self._smoothUp = nil
    self._smoothSpeedPull = 0
    self._orbitYaw = 0
    self._orbitPitch = 0
    self._isOrbiting = false
    self._orbitTouch = nil
    self._orbitReleaseTime = 0

    -- Idle Showcase state
    self._idleTimer = 0
    self._showcaseActive = false
    self._scShotIndex = 1
    self._scShotTimer = 0
    self._scOrbitOffset = 0
    self._scYaw = 0
    self._scPitch = BASE_PITCH_RAD
    self._scDistMult = 1.0
    self._scRoll = 0
    self._scFov = DEFAULT_FOV
    self._scFocusSide = 0
    self._scFocusFwd = 0

    self._rayParams = RaycastParams.new()
    self._rayParams.FilterType = Enum.RaycastFilterType.Exclude
    self._rayParams.IgnoreWater = true
end

function Module:Init(deps)
    self.core       = deps.Core
    self.authority  = deps.Authority
    self.powertrain = deps.Powertrain
    self.drive      = deps.DriveSystem
end

function Module:_trackConn(conn)
    if conn then table.insert(self._conns, conn) end
end

function Module:Start()
    _G.VX.Visuals = self
    self:_registerDiagnostics()

    self:_trackConn(_G.VX.bus:on("vehicle.stateChanged", function(evt)
        if evt.to == "Ready" or evt.to == "Idle" then
            self:_bindCamera()
        elseif evt.to == "Exiting" or evt.to == "Disabled" then
            self:_unbindCamera()
        end
    end))

    self:_trackConn(_G.VX.bus:on("vehicle.shift", function(evt)
        self:_onShift(evt)
    end))

    self:_trackConn(_G.VX.bus:on("vehicle.launchRelease", function(evt)
        if evt.quality == "perfect" or evt.quality == "good" then
            local cfg = self.core.config.launch
            self.joltVelocity = self.joltVelocity + Vector3.new(0, 0, cfg.joltMagnitude * 30)
            self:fireExhaustFlame()
        end
    end))

    self:_trackConn(_G.VX.bus:on("vehicle.backfire", function()
        self:fireExhaustFlame()
    end))

    self:_trackConn(_G.VX.bus:on("vehicle.twostepStart", function()
        self:fireExhaustFlame()
    end))

    self:_trackConn(_G.VX.bus:on("settings.changed", function(evt)
        if evt and evt.path == "racingChaseCamera" and evt.new == false then
            self:_restoreDefaultCamera()
        end
    end))

    self:_trackConn(UserInputService.InputBegan:Connect(function(input, gp)
        if gp or not self._chaseActive then return end
        if input.UserInputType == Enum.UserInputType.Touch and not self._orbitTouch then
            self._orbitTouch = input
            self._isOrbiting = true
            self._idleTimer = 0
            if self._showcaseActive then self:_exitShowcase() end
        elseif input.UserInputType == Enum.UserInputType.MouseButton2 then
            self._isOrbiting = true
            self._idleTimer = 0
            if self._showcaseActive then self:_exitShowcase() end
        end
    end))

    self:_trackConn(UserInputService.InputChanged:Connect(function(input)
        if not self._chaseActive then return end
        if input == self._orbitTouch and input.UserInputType == Enum.UserInputType.Touch then
            self._orbitYaw = math.clamp(self._orbitYaw - input.Delta.X * 0.007, -math.pi, math.pi)
            self._orbitPitch = math.clamp(self._orbitPitch - input.Delta.Y * 0.005, -0.55, 0.35)
            self._isOrbiting = true
            self._idleTimer = 0
        elseif input.UserInputType == Enum.UserInputType.MouseMovement and UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) then
            self._orbitYaw = math.clamp(self._orbitYaw - input.Delta.X * 0.006, -math.pi, math.pi)
            self._orbitPitch = math.clamp(self._orbitPitch - input.Delta.Y * 0.0045, -0.55, 0.35)
            self._isOrbiting = true
            self._idleTimer = 0
        end
    end))

    self:_trackConn(UserInputService.InputEnded:Connect(function(input)
        if input == self._orbitTouch then
            self._orbitTouch = nil
            self._isOrbiting = false
            self._orbitReleaseTime = os.clock()
        elseif input.UserInputType == Enum.UserInputType.MouseButton2 then
            if not self._orbitTouch then
                self._isOrbiting = false
                self._orbitReleaseTime = os.clock()
            end
        end
    end))

    local auth = self.authority
    if auth and auth:getHandle() then
        self:_bindCamera()
    end
end

function Module:Stop()
    self:_unbindCamera()
    for _, c in ipairs(self._conns) do
        if typeof(c) == "RBXScriptConnection" then
            c:Disconnect()
        elseif type(c) == "table" and c.Disconnect then
            c:Disconnect()
        end
    end
    self._conns = {}
    if _G.VX.Visuals == self then _G.VX.Visuals = nil end
end

function Module:heartbeat()
    return true
end

function Module:_registerDiagnostics()
    local D = _G.VX.diagnostics
    pcall(function()
        D.register("visuals.fov", {
            fn = function() return { value = string.format("%.1f", self.currentFOV), unit = "deg", status = "normal" } end,
            category = "Visuals",
        }, "Visuals")
        D.register("visuals.chaseCam", {
            fn = function()
                local status = self._showcaseActive and "SHOWCASE" or (self._chaseActive and "ON" or "OFF")
                return { value = status, unit = "", status = "normal" }
            end,
            category = "Visuals",
        }, "Visuals")
    end)
end

-- ==================== CAMERA BIND & RESTORE ====================
function Module:_restoreDefaultCamera()
    if not self._chaseActive then return end
    self._chaseActive = false
    self._showcaseActive = false
    self._idleTimer = 0
    self._chaseRot = nil
    self._chasePos = nil
    self._smoothLook = nil
    self._smoothUp = nil
    self._smoothSpeedPull = 0
    self._orbitYaw = 0
    self._orbitPitch = 0
    self._isOrbiting = false
    self._orbitTouch = nil

    if not Camera then Camera = workspace.CurrentCamera end
    if Camera then
        Camera.CameraType = Enum.CameraType.Custom
        local player = Players.LocalPlayer
        local char = player and player.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if hum then
            Camera.CameraSubject = hum
        end
    end
end

function Module:_bindCamera()
    if self._renderBound then return end
    self._renderBound = true
    self.currentFOV = Camera and Camera.FieldOfView or DEFAULT_FOV
    self.lastCameraUpdate = os.clock()
    self._chaseRot = nil
    self._chasePos = nil
    self._smoothLook = nil
    self._smoothUp = nil
    self._smoothSpeedPull = 0
    self._orbitYaw = 0
    self._orbitPitch = 0
    self._isOrbiting = false
    self._orbitTouch = nil
    self._idleTimer = 0
    self._showcaseActive = false

    RunService:BindToRenderStep("VX_Camera", Enum.RenderPriority.Camera.Value + 5, function(dt)
        pcall(function() self:_updateCamera(dt) end)
    end)
    print("[VX] Visuals camera bound")
end

function Module:_unbindCamera()
    if not self._renderBound then return end
    self._renderBound = false
    pcall(function() RunService:UnbindFromRenderStep("VX_Camera") end)

    self:_restoreDefaultCamera()

    if Camera then Camera.FieldOfView = DEFAULT_FOV end
    self.joltOffset = Vector3.new()
    self.joltVelocity = Vector3.new()

    local handle = self.authority:getHandle()
    if handle and handle.tiltWeld and handle.neutralC0 then
        pcall(function() handle.tiltWeld.C0 = handle.neutralC0 end)
    end
    print("[VX] Visuals camera unbound")
end

-- ==================== IDLE SHOWCASE TRANSITIONS ====================
function Module:_enterShowcase()
    self._showcaseActive = true
    self._scShotIndex = 1
    self._scShotTimer = 0
    self._scOrbitOffset = 0
    self._scYaw = self._orbitYaw
    self._scPitch = BASE_PITCH_RAD + self._orbitPitch
    self._scDistMult = 1.0
    self._scRoll = 0
    self._scFov = self.currentFOV or DEFAULT_FOV
    self._scFocusSide = 0
    self._scFocusFwd = 0
end

function Module:_exitShowcase()
    if not self._showcaseActive then return end
    self._showcaseActive = false
    self._idleTimer = 0
    self._orbitYaw = _wrapAngle(self._scYaw)
    self._orbitPitch = math.clamp(self._scPitch - BASE_PITCH_RAD, -0.55, 0.35)
    self._orbitReleaseTime = os.clock() - RECENTER_DELAY
    self.currentFOV = self._scFov
end

-- ==================== 3-AXIS RACING CHASE + SHOWCASE CAMERA ====================
function Module:_updateChaseCamera(dt, handle, carPart, speed)
    if not Camera then return end
    if Camera.CameraType ~= Enum.CameraType.Scriptable then
        Camera.CameraType = Enum.CameraType.Scriptable
    end
    self._chaseActive = true

    local carCF = carPart.CFrame
    local carLook = carCF.LookVector
    local carUp = carCF.UpVector

    -- Blend car nose with forward velocity direction (never flips when stationary or reversing)
    local vel = carPart.AssemblyLinearVelocity
    local velMag = vel.Magnitude
    local desiredLook = carLook
    if velMag > 8 then
        local velDir = vel / velMag
        if carLook:Dot(velDir) > 0.25 then
            local velBlend = math.clamp((speed - 5) / 35, 0, 0.55)
            desiredLook = carLook:Lerp(velDir, velBlend).Unit
        end
    end

    -- All-axis car pitch, yaw & roll following
    local rollWeight = math.clamp(self.core.settings.chaseCameraRoll or 0.7, 0, 1)
    local worldUp = Vector3.new(0, 1, 0)
    local desiredUp
    if carUp:Dot(worldUp) < 0.15 then
        desiredUp = carUp
    else
        desiredUp = worldUp:Lerp(carUp, rollWeight).Unit
    end
    if math.abs(desiredLook:Dot(desiredUp)) > 0.98 then
        desiredUp = carUp
    end

    if not self._chaseRot or not self._chasePos then
        self._smoothLook = desiredLook
        self._smoothUp = desiredUp
        self._chaseRot = CFrame.lookAt(Vector3.zero, desiredLook, desiredUp)
        self._chasePos = carCF.Position
    else
        local vecAlpha = 1 - math.exp(-5.5 * dt)
        local upAlpha  = 1 - math.exp(-6.5 * dt)
        local rotAlpha = 1 - math.exp(-7.0 * dt)
        local posAlpha = 1 - math.exp(-12.5 * dt)

        self._smoothLook = self._smoothLook:Lerp(desiredLook, vecAlpha).Unit
        self._smoothUp = self._smoothUp:Lerp(desiredUp, upAlpha).Unit
        if math.abs(self._smoothLook:Dot(self._smoothUp)) > 0.98 then
            self._smoothUp = carUp
        end

        local targetRot = CFrame.lookAt(Vector3.zero, self._smoothLook, self._smoothUp)
        self._chaseRot = self._chaseRot:Lerp(targetRot, rotAlpha)
        self._chasePos = self._chasePos:Lerp(carCF.Position, posAlpha)
    end

    -- Check idle/stationary state for 15s Auto-Showcase
    local input = _G.VX.Modules and _G.VX.Modules.Input
    local rawThr = input and input:getRawThrottle() or 0
    local rawStr = input and input:getRawSteer() or 0
    local launchState = self.powertrain and self.powertrain:getLaunchState() or "idle"
    local twostep = self.powertrain and self.powertrain:isTwostepActive() or false
    local isStationary = (speed < 2.0) and (math.abs(rawThr) < 0.05) and (math.abs(rawStr) < 0.05)
        and (launchState == "idle") and (not twostep) and (not self._isOrbiting)

    if isStationary then
        self._idleTimer = self._idleTimer + dt
        if self._idleTimer >= IDLE_SHOWCASE_DELAY and not self._showcaseActive then
            self:_enterShowcase()
        end
    else
        self._idleTimer = 0
        if self._showcaseActive then
            self:_exitShowcase()
        end
    end

    local baseDist = math.clamp(self.core.settings.chaseCameraDistance or 15, 8, 26)
    local camRot, dist, focusPoint

    if self._showcaseActive then
        -- 4-Shot Cinematic Showcase Cycle
        self._scShotTimer = self._scShotTimer + dt
        if self._scShotTimer >= SHOWCASE_SHOT_DURATION then
            self._scShotTimer = 0
            self._scOrbitOffset = 0
            self._scShotIndex = (self._scShotIndex % #SHOWCASE_SHOTS) + 1
        end

        local shot = SHOWCASE_SHOTS[self._scShotIndex]
        self._scOrbitOffset = self._scOrbitOffset + shot.yawRate * dt
        local targetYaw = shot.yawStart + self._scOrbitOffset

        local dollyAlpha = 1 - math.exp(-1.8 * dt)
        local orbitAlpha = 1 - math.exp(-3.5 * dt)

        self._scYaw = _lerpAngle(self._scYaw, targetYaw, orbitAlpha)
        self._scPitch = self._scPitch + (shot.pitch - self._scPitch) * dollyAlpha
        self._scDistMult = self._scDistMult + (shot.distMult - self._scDistMult) * dollyAlpha
        self._scRoll = self._scRoll + (shot.roll - self._scRoll) * dollyAlpha
        self._scFov = self._scFov + (shot.fov - self._scFov) * dollyAlpha
        self._scFocusSide = self._scFocusSide + (shot.focusSide - self._scFocusSide) * dollyAlpha
        self._scFocusFwd = self._scFocusFwd + (shot.focusFwd - self._scFocusFwd) * dollyAlpha

        camRot = self._chaseRot
            * CFrame.Angles(0, self._scYaw, 0)
            * CFrame.Angles(self._scPitch, 0, self._scRoll)

        dist = baseDist * self._scDistMult
        focusPoint = self._chasePos
            + self._chaseRot.UpVector * 0.9
            + self._chaseRot.RightVector * self._scFocusSide
            + self._chaseRot.LookVector * self._scFocusFwd
    else
        -- Standard Chase Cam + Smooth Auto-Return after RECENTER_DELAY
        if not self._isOrbiting and (os.clock() - self._orbitReleaseTime) >= RECENTER_DELAY then
            local recenterAlpha = 1 - math.exp(-3.0 * dt)
            self._orbitYaw = self._orbitYaw * (1 - recenterAlpha)
            self._orbitPitch = self._orbitPitch * (1 - recenterAlpha)
            if math.abs(self._orbitYaw) < 0.001 then self._orbitYaw = 0 end
            if math.abs(self._orbitPitch) < 0.001 then self._orbitPitch = 0 end
        end

        camRot = self._chaseRot
            * CFrame.Angles(0, self._orbitYaw, 0)
            * CFrame.Angles(BASE_PITCH_RAD + self._orbitPitch, 0, 0)

        local targetPull = math.clamp(speed / 180, 0, 1) * 2.0
        self._smoothSpeedPull = self._smoothSpeedPull + (targetPull - self._smoothSpeedPull) * (1 - math.exp(-4.0 * dt))
        dist = baseDist + self._smoothSpeedPull
        focusPoint = self._chasePos + self._chaseRot.UpVector * 0.9
    end

    local idealCamPos = focusPoint - camRot.LookVector * dist

    -- Anti-clip raycast excluding vehicle & player character
    local excludes = { handle.root }
    local char = Players.LocalPlayer and Players.LocalPlayer.Character
    if char then table.insert(excludes, char) end
    self._rayParams.FilterDescendantsInstances = excludes

    local finalCamPos = idealCamPos
    local ray = workspace:Raycast(focusPoint, idealCamPos - focusPoint, self._rayParams)
    if ray then
        local hitDist = (ray.Position - focusPoint).Magnitude
        local safeDist = math.max(3.0, hitDist - 0.6)
        finalCamPos = focusPoint + (idealCamPos - focusPoint).Unit * safeDist
    end

    Camera.CFrame = CFrame.lookAt(finalCamPos, focusPoint, camRot.UpVector)
end

-- ==================== CAMERA UPDATE ====================
function Module:_updateCamera(dt)
    if not Camera then Camera = workspace.CurrentCamera end
    if not Camera then return end
    if dt > 0.1 then dt = 0.016 end

    local handle = self.authority:getHandle()
    if not handle or not handle.root then
        self:_restoreDefaultCamera()
        return
    end

    local settings = self.core.settings
    local cfg = self.core.config.cameraFx
    local part = handle.root.PrimaryPart or handle.platform or handle.chassis or handle.seat
    local speed = 0
    if part then
        local v = part.AssemblyLinearVelocity
        speed = Vector3.new(v.X, 0, v.Z).Magnitude * STUDS_TO_MPH
    end

    if settings.racingChaseCamera and part then
        self:_updateChaseCamera(dt, handle, part, speed)
    else
        self:_restoreDefaultCamera()
    end

    if self._showcaseActive then
        self.currentFOV = self._scFov
        Camera.FieldOfView = self.currentFOV
    elseif settings.fovDynamicsEnabled then
        local t = math.clamp(speed / cfg.fovSpeedThreshold, 0, 1)
        local targetFOV = cfg.fovIdle + t * (cfg.fovMax - cfg.fovIdle)
        self.currentFOV = self.currentFOV + (targetFOV - self.currentFOV) * math.min(cfg.fovSmoothness * dt, 1)
        Camera.FieldOfView = self.currentFOV
    end

    if settings.vehicleShaking and not self._showcaseActive then
        local rpm = self.powertrain:getRPM()
        if rpm > cfg.vibRpmMin then
            local factor = math.clamp((rpm - cfg.vibRpmMin) / (cfg.vibRpmMax - cfg.vibRpmMin), 0, 1)
            local amp = cfg.vibMaxOffset * factor
            self.vibPhase = self.vibPhase + dt * (rpm * cfg.vibFreqMultiplier)
            local ox = math.sin(self.vibPhase * 1.1) * amp
            local oy = math.cos(self.vibPhase * 1.7) * amp * 0.7
            local oz = math.sin(self.vibPhase * 0.7) * amp * 0.5
            Camera.CFrame = Camera.CFrame * CFrame.new(ox, oy, oz)
        end
    end

    if self.joltOffset.Magnitude > 0.001 or self.joltVelocity.Magnitude > 0.001 then
        local stiffness = 120
        local damping = 18
        local force = -self.joltOffset * stiffness - self.joltVelocity * damping
        self.joltVelocity = self.joltVelocity + force * dt
        self.joltOffset = self.joltOffset + self.joltVelocity * dt
        Camera.CFrame = Camera.CFrame * CFrame.new(self.joltOffset)
    end

    self:_updateTilt(dt)
end

-- ==================== SHIFT SHOCK ====================
function Module:_onShift(evt)
    if not self.core.settings.shiftingJolt then return end
    local cfg = self.core.config.cameraFx
    local shock
    if evt.emergency then shock = cfg.shiftEmergency
    elseif evt.up then shock = cfg.shiftUp
    else shock = cfg.shiftDown end
    self.joltVelocity = self.joltVelocity + Vector3.new(0, 0, shock.mag * 18)
end

-- ==================== BODY TILT ====================
function Module:_updateTilt(dt)
    local handle = self.authority:getHandle()
    if not handle or not handle.tiltWeld or not handle.neutralC0 then return end

    local levelName = self.core.settings.physicsTiltLevel or "Off"
    local levelCfg = self.core.config.tiltLevels[levelName]
    if not levelCfg or levelName == "Off" then
        handle.tiltWeld.C0 = handle.neutralC0
        return
    end

    local throttle = self.powertrain:getSmoothedThrottle()
    local input = _G.VX.Modules and _G.VX.Modules.Input
    local steer = input and input:getRawSteer() or 0

    local pitch = math.clamp(throttle, -1, 1) * levelCfg.maxX
    local roll  = math.clamp(steer, -1, 1) * levelCfg.maxZ

    local targetC0 = handle.neutralC0 * CFrame.Angles(pitch, 0, roll)
    local cur = handle.tiltWeld.C0
    handle.tiltWeld.C0 = cur:Lerp(targetC0, math.min(dt * 8, 1))
end

-- ==================== EXHAUST FLAMES ====================
function Module:fireExhaustFlame()
    if self.core.settings.backfireEnabled == false then return end
    local now = os.clock()
    if now - self.lastFlameTime < 0.03 then return end
    self.lastFlameTime = now

    local handle = self.authority:getHandle()
    if not handle then return end

    local emitter = nil
    if handle.vfxAttach then
        emitter = handle.vfxAttach:FindFirstChild("fire") or handle.vfxAttach:FindFirstChildWhichIsA("ParticleEmitter")
    end
    if not emitter and handle.nitrous then
        emitter = handle.nitrous:FindFirstChild("fire", true) or handle.nitrous:FindFirstChildWhichIsA("ParticleEmitter", true)
    end
    if not emitter and handle.root then
        emitter = handle.root:FindFirstChild("fire", true)
    end

    self._flameSeq = self._flameSeq + 1
    local mySeq = self._flameSeq

    if emitter and emitter:IsA("ParticleEmitter") then
        emitter.Enabled = true
        pcall(function() emitter:Emit(math.random(5, 9)) end)
        task.delay(0.09, function()
            if self._flameSeq == mySeq and emitter and emitter.Parent then
                emitter.Enabled = false
            end
        end)
    end

    if _G.VX.Remote and (now - self.lastRemotePulseTime >= 0.03) then
        self.lastRemotePulseTime = now
        pcall(function() _G.VX.Remote:fireBoostPulse(0.08) end)
    end
end

return Module
