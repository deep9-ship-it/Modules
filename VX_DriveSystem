--[[
    VX_DriveSystem.lua — Mass-Calibrated HP/RPM Tractive Force, Second-Half-Gear Drag Resistance,
                         Auto/Custom HP, Realistic Turbo Lag/Flutter/Blowoff & Ackermann Steering
    Version: 3.5.1
]]

local VX = _G.VX
if not VX or not VX.Framework then
    error("VX_DriveSystem requires VX_Kernel")
end

local Module = VX.Framework.Module.new({
    Name = "DriveSystem",
    Dependencies = { "Core", "Profiles", "Authority", "Powertrain", "VehicleState" },
    Version = "3.5.1",
})

local TICK_NORMAL = 60
local TICK_LOW = 30
local STUDS_TO_MPH = 0.626
local MPH_TO_STUDS = 1 / 0.626
local DEFAULT_WHEEL_RADIUS = 1.65
local DEFAULT_VEHICLE_MASS = 150
local BASE_TORQUE_CALIBRATION = 26000
local BASE_BRAKE_TORQUE = 150000

function Module:Construct()
    self.boostPressure = 0
    self.turboStage = 1
    self.brakeTemp = 0
    self.steerAngle = 0
    self.wheelSpeed = 0

    self._wheelRadius = DEFAULT_WHEEL_RADIUS
    self._vehicleMass = DEFAULT_VEHICLE_MASS
    self._effectiveTopSpeed = 100
    self._currentHP = 145
    self._absActivations = 0
    self._absPulsePhase = 0
    self._prevThrottle = 0
    self._prevBoost = 0
    self._launchBurstUntil = 0
    self._launchBurstMult = 1.0

    self._running = false
    self._loopThread = nil
    self._launchBurstThread = nil
    self._conns = {}
end

function Module:Init(deps)
    self.core = deps.Core
    self.profiles = deps.Profiles
    self.authority = deps.Authority
    self.powertrain = deps.Powertrain
    self.state = deps.VehicleState

    pcall(function()
        _G.VX.registry:set("settings", "drivetrain", {
            type = "enum",
            default = "AWD",
            options = { "FWD", "RWD", "AWD" },
            category = "Dynamics",
            label = "Drivetrain",
        }, "DriveSystem")
    end)
end

function Module:_trackConn(conn)
    if conn then
        table.insert(self._conns, conn)
    end
end

function Module:Start()
    _G.VX.DriveSystem = self

    self:_trackConn(_G.VX.bus:on("vehicle.stateChanged", function(evt)
        if not evt then return end
        if evt.to == "Ready" or evt.to == "Idle" then
            self:_syncSeatTurbo()
            self:_start()
        elseif evt.to == "Exiting" or evt.to == "Disabled" then
            self:_stop()
        end
    end))

    self:_trackConn(_G.VX.bus:on("vehicle.launchRelease", function(evt)
        self:_handleLaunchRelease(evt)
    end))

    self:_trackConn(_G.VX.bus:on("settings.changed", function(evt)
        if evt and evt.path == "turboStage" then
            self:_syncSeatTurbo()
        end
    end))

    self:_registerDiagnostics()

    if self.authority and self.authority:getHandle() then
        self:_syncSeatTurbo()
        self:_start()
    end
end

function Module:Stop()
    self:_stop()
    for _, c in ipairs(self._conns) do
        if typeof(c) == "RBXScriptConnection" then
            c:Disconnect()
        elseif type(c) == "table" and c.Disconnect then
            c:Disconnect()
        end
    end
    self._conns = {}
    if _G.VX.DriveSystem == self then
        _G.VX.DriveSystem = nil
    end
end

function Module:heartbeat()
    if not self._running then return true end
    return self._loopThread ~= nil
end

function Module:_registerDiagnostics()
    local D = _G.VX.diagnostics
    pcall(function()
        D.register("drive.horsepower", {
            fn = function() return { value = math.floor(self._currentHP + 0.5), unit = "HP", status = "normal" } end,
            category = "DriveSystem",
        }, "DriveSystem")
        D.register("drive.boost", {
            fn = function() return { value = string.format("%.1f", self.boostPressure), unit = "psi", status = "normal" } end,
            category = "DriveSystem",
        }, "DriveSystem")
        D.register("drive.brakeTemp", {
            fn = function() return { value = math.floor(self.brakeTemp * 100), unit = "%", status = self.brakeTemp > 0.7 and "warn" or "normal" } end,
            category = "DriveSystem",
        }, "DriveSystem")
        D.register("drive.absActivations", {
            fn = function() return { value = self._absActivations, unit = "", status = "normal" } end,
            category = "DriveSystem",
        }, "DriveSystem")
        D.register("drive.wheelSpeed", {
            fn = function() return { value = string.format("%.1f", self.wheelSpeed), unit = "mph", status = "normal" } end,
            category = "DriveSystem",
        }, "DriveSystem")
        D.register("drive.steerAngle", {
            fn = function() return { value = string.format("%.1f", self.steerAngle), unit = "deg", status = "normal" } end,
            category = "DriveSystem",
        }, "DriveSystem")
    end)
end

function Module:_measureVehicle(handle)
    local sumR, countR = 0, 0
    for _, w in ipairs((handle and handle.wheels) or {}) do
        if w.physical and w.physical:IsA("BasePart") then
            local sz = w.physical.Size
            local r = math.max(sz.Y, sz.Z) * 0.5
            if r > 0.2 then
                sumR = sumR + r
                countR = countR + 1
            end
        end
    end
    local radius = (countR > 0) and (sumR / countR) or DEFAULT_WHEEL_RADIUS

    local mass = 0
    if handle and handle.root then
        for _, desc in ipairs(handle.root:GetDescendants()) do
            if desc:IsA("BasePart") then
                mass = mass + desc:GetMass()
            end
        end
    end
    if mass < 20 then
        mass = DEFAULT_VEHICLE_MASS
    end

    return radius, math.clamp(mass, 30, 5000)
end

function Module:_start()
    if self._running then return end
    self._running = true
    self.boostPressure = 0
    self.brakeTemp = 0
    self.steerAngle = 0
    self.wheelSpeed = 0
    self._prevThrottle = 0
    self._effectiveTopSpeed = self.core.settings.topSpeed or 100

    local handle = self.authority and self.authority:getHandle()
    self._wheelRadius, self._vehicleMass = self:_measureVehicle(handle)

    self._loopThread = task.spawn(function()
        local perf = self.core.settings._effectivePerformance
        local tickRate = (perf == "low") and TICK_LOW or TICK_NORMAL
        local interval = 1 / tickRate
        local lastTick = os.clock()
        while self._running do
            local now = os.clock()
            local dt = now - lastTick
            lastTick = now
            if dt <= 0 or dt > 0.1 then dt = interval end
            pcall(function() self:_update(dt) end)
            local toSleep = interval - (os.clock() - now)
            if toSleep > 0 then task.wait(toSleep) end
        end
    end)
    print(string.format("[VX] DriveSystem started (mass=%.0f, wheelR=%.2f)", self._vehicleMass, self._wheelRadius))
end

function Module:_stop()
    if not self._running then return end
    self._running = false
    if self._loopThread then
        pcall(function() task.cancel(self._loopThread) end)
        self._loopThread = nil
    end
    if self._launchBurstThread then
        pcall(function() task.cancel(self._launchBurstThread) end)
        self._launchBurstThread = nil
    end
    self.boostPressure = 0
    self.steerAngle = 0
    self.wheelSpeed = 0

    local handle = self.authority and self.authority:getHandle()
    if handle and handle.wheels then
        for _, w in ipairs(handle.wheels) do
            if w.cylinder then
                pcall(function()
                    w.cylinder.AngularActuatorType = Enum.ActuatorType.None
                    w.cylinder.AngularVelocity = 0
                    w.cylinder.MotorMaxTorque = 0
                end)
            end
        end
    end
    print("[VX] DriveSystem stopped")
end

function Module:_syncSeatTurbo()
    local stage = math.clamp(math.floor(self.core.settings.turboStage or 1), 1, 3)
    self.turboStage = stage
    local cfg = self.core.config.turboStages[stage]
    if not cfg then return end

    local handle = self.authority and self.authority:getHandle()
    local seat = handle and handle.seat
    if not seat then return end

    pcall(function()
        local turboObj = seat:FindFirstChild("Turbo")
        if turboObj and (turboObj:IsA("StringValue") or turboObj:IsA("IntValue") or turboObj:IsA("NumberValue")) then
            turboObj.Value = turboObj:IsA("StringValue") and tostring(cfg.seatValue) or tonumber(cfg.seatValue)
        end
        if seat:GetAttribute("Turbo") ~= nil then
            seat:SetAttribute("Turbo", cfg.seatValue)
        end
    end)
end

function Module:_handleLaunchRelease(evt)
    if not evt or not evt.quality then return end
    local cfg = self.core.config.launch
    if not cfg then return end

    if evt.quality == "perfect" then
        self._launchBurstMult = cfg.perfectBonusMult or 1.20
        self._launchBurstUntil = os.clock() + (cfg.perfectBonusDuration or 0.5)
    elseif evt.quality == "good" then
        self._launchBurstMult = cfg.goodBonusMult or 1.10
        self._launchBurstUntil = os.clock() + (cfg.goodBonusDuration or 0.3)
    else
        return
    end

    if self._launchBurstThread then
        pcall(function() task.cancel(self._launchBurstThread) end)
    end
    self._launchBurstThread = task.spawn(function()
        local count = math.random(cfg.burstMin or 15, cfg.burstMax or 25)
        local dur = cfg.burstDuration or 0.4
        local interval = dur / math.max(count, 1)
        for i = 1, count do
            if not self._running then break end
            _G.VX.bus:emit("vehicle.backfire", { source = "launch", count = 1 })
            task.wait(interval)
        end
    end)
end

function Module:_getBodySpeedMPH(handle)
    if not handle then return 0 end
    local velPart = (handle.root and handle.root.PrimaryPart) or handle.platform or handle.chassis or handle.seat
    if not velPart then return 0 end
    local v = velPart.AssemblyLinearVelocity
    return Vector3.new(v.X, 0, v.Z).Magnitude * STUDS_TO_MPH
end

function Module:_getDrivenWheelMPH(handle, drivetrain)
    local sumOmega, count = 0, 0
    for _, w in ipairs((handle and handle.wheels) or {}) do
        local isDriven = (drivetrain == "AWD")
            or (drivetrain == "FWD" and w.isFront)
            or (drivetrain == "RWD" and not w.isFront)
        if isDriven and w.physical and w.physical.Parent then
            sumOmega = sumOmega + w.physical.AssemblyAngularVelocity.Magnitude
            count = count + 1
        end
    end
    if count == 0 then
        return self:_getBodySpeedMPH(handle)
    end
    return (sumOmega / count) * self._wheelRadius * STUDS_TO_MPH
end

function Module:_computeEffectiveHP(effTop, prof, stageCfg)
    local settings = self.core.settings
    local baseHP
    if settings.customHorsepower then
        baseHP = math.clamp(tonumber(settings.horsepower) or 500, 100, 2500)
    else
        baseHP = 145 * ((math.max(effTop, 40) / 100) ^ 2.15)
    end

    local hasTurbo = (prof and prof.hasTurboSounds ~= false)
    local boostHPBonus = 0
    if hasTurbo and stageCfg then
        local mult = settings.turboCustomMultiplier or 1.0
        local maxPSI = math.max((stageCfg.targetBoostPSI or 21) * mult, 1)
        local boostFrac = math.clamp(self.boostPressure / maxPSI, 0, 1.5)
        boostHPBonus = (stageCfg.hpBonus or 0.12) * boostFrac * mult
    end

    return baseHP * (1 + boostHPBonus)
end

function Module:_updateSteering(dt, handle, speed)
    local input = _G.VX.Modules and _G.VX.Modules.Input
    local rawSteer = input and input:getRawSteer() or 0
    local settings = self.core.settings
    local phys = settings.physics or {}

    local maxAngle = phys.maxSteerAngle or 35
    local sens = settings.steeringSensitivity or 1.0
    local turnSpeed = phys.turnSpeed or 8

    if settings.highSpeedSteerReduction then
        local redFactor = settings.reductionFactor or 0.5
        local topSpd = math.max(self._effectiveTopSpeed, 1)
        local speedFrac = math.clamp(speed / topSpd, 0, 1)
        maxAngle = maxAngle * (1 - speedFrac * (1 - redFactor))
    end

    if phys.steeringDecay then
        local decay = 1 / (1 + speed * 0.008)
        maxAngle = maxAngle * math.max(0.35, decay)
    end

    -- Polarity fix: Left=-1 -> +Y (Left), Right=+1 -> -Y (Right)
    local targetAngle = -math.clamp(rawSteer * maxAngle * sens, -maxAngle, maxAngle)
    self.steerAngle = self.steerAngle + (targetAngle - self.steerAngle) * math.min(turnSpeed * dt, 1)

    local ackermannFade = 1 - math.clamp((speed - 45) / 35, 0, 1)

    for _, w in ipairs(handle.wheels or {}) do
        if w.isFront and w.attach then
            local wheelAngle = self.steerAngle
            if ackermannFade > 0.01 and math.abs(wheelAngle) > 0.5 then
                local turningLeft = wheelAngle > 0
                local isInside = (turningLeft and w.isLeft) or ((not turningLeft) and (not w.isLeft))
                local mult = isInside and (1 + 0.12 * ackermannFade) or (1 - 0.06 * ackermannFade)
                wheelAngle = wheelAngle * mult
            end

            local invert = false
            pcall(function()
                invert = w.model and w.model:GetAttribute("Invert") == true
            end)
            local angle = invert and -wheelAngle or wheelAngle
            pcall(function()
                w.attach.Orientation = Vector3.new(0, angle, -90)
            end)
        end
    end
end

function Module:_updateTurbo(dt, prof, rpm, throttle)
    local stage = math.clamp(math.floor(self.core.settings.turboStage or 1), 1, 3)
    self.turboStage = stage
    local cfg = self.core.config.turboStages[stage]
    if not cfg then return cfg end

    local settings = self.core.settings
    local mult = settings.turboCustomMultiplier or 1.0
    local baseSpoolRPM = prof.turboSpoolRPM or 3500
    local boostThreshold = math.max(1200, baseSpoolRPM + (cfg.spoolRpmOffset or 0))
    local redline = prof.redlineRPM or 8200
    local rpmFactor = math.clamp((rpm - boostThreshold) / math.max(redline - boostThreshold, 1), 0, 1)

    local targetBoost = 0
    if throttle > 0.1 and prof.hasTurboSounds ~= false then
        targetBoost = cfg.targetBoostPSI * mult * rpmFactor * math.clamp(throttle, 0, 1)
    end

    local rate = cfg.spoolRate or 1.25
    if settings.realisticTurboEnabled then
        rate = rate * 0.65
    end
    self.boostPressure = self.boostPressure + (targetBoost - self.boostPressure) * math.min(rate * dt, 1)

    if self._prevThrottle > 0.30 and throttle < 0.12 and prof.hasTurboSounds ~= false then
        local thresh = (cfg.blowoffThreshold or 6.3) * mult
        local maxPSI = math.max(cfg.targetBoostPSI * mult, 1)

        if self.boostPressure >= thresh * 1.35 and settings.turboBlowoffEnabled then
            local intensity = math.clamp(self.boostPressure / maxPSI, 0.3, 1.0)
            _G.VX.bus:emit("turbo.blowoff", { boost = self.boostPressure, intensity = intensity })
            self.boostPressure = self.boostPressure * 0.40
        elseif self.boostPressure >= math.max(2.0, thresh * 0.40) and settings.turboFlutterEnabled then
            local intensity = math.clamp(self.boostPressure / maxPSI, 0.2, 0.85)
            _G.VX.bus:emit("turbo.flutter", { boost = self.boostPressure, intensity = intensity })
            self.boostPressure = self.boostPressure * 0.65
        end
    end

    self._prevBoost = self.boostPressure
    self._prevThrottle = throttle
    return cfg
end

function Module:_updateBrakes(dt, braking, speed)
    local phys = self.core.settings.physics or {}
    if phys.brakeFadeEnabled and braking > 0.1 and speed > 5 then
        self.brakeTemp = math.min(1.0, self.brakeTemp + braking * (speed / 200) * 0.25 * dt)
    else
        self.brakeTemp = math.max(0, self.brakeTemp - 0.08 * dt)
    end

    local fadeMult = 1.0
    if phys.brakeFadeEnabled and self.brakeTemp > 0.6 then
        fadeMult = math.max(0.45, 1.0 - (self.brakeTemp - 0.6) * 1.1)
    end

    local absMult = 1.0
    if phys.absEnabled and braking > 0.3 and speed > 10 then
        local chassis = _G.VX.Chassis
        if chassis and chassis.spinActive then
            self._absPulsePhase = self._absPulsePhase + dt * 16
            if math.sin(self._absPulsePhase * math.pi * 2) > 0 then
                absMult = 0.35
                self._absActivations = self._absActivations + 1
            end
        end
    end

    return fadeMult * absMult
end

function Module:_update(dt)
    local st = self.state:getVehicleState()
    if st == "Disabled" or st == "Exiting" then return end

    local handle = self.authority and self.authority:getHandle()
    if not handle then return end

    local prof = self.profiles:current()
    local settings = self.core.settings
    local phys = settings.physics or {}
    local drivetrain = settings.drivetrain or "AWD"

    local bodySpeed = self:_getBodySpeedMPH(handle)
    self.wheelSpeed = self:_getDrivenWheelMPH(handle, drivetrain)

    local targetTop = math.max(settings.topSpeed or 100, 10)
    if bodySpeed < 3 then
        self._effectiveTopSpeed = targetTop
    else
        self._effectiveTopSpeed = self._effectiveTopSpeed + (targetTop - self._effectiveTopSpeed) * math.min(2.0 * dt, 1)
    end
    local effTop = self._effectiveTopSpeed

    self:_updateSteering(dt, handle, bodySpeed)

    local rpm = self.powertrain:getRPM()
    local throttle = self.powertrain:getSmoothedThrottle()
    local gear = self.powertrain:getGear()
    local shiftState = self.powertrain:getShiftState()
    local launchState = self.powertrain:getLaunchState()
    local twostepActive = self.powertrain:isTwostepActive()
    local slopeLoad = self.powertrain:getSlopeLoadFactor()

    local posThr = math.max(0, throttle)
    local stageCfg = self:_updateTurbo(dt, prof, rpm, posThr)

    local braking = math.max(0, -throttle)
    local brakeMult = self:_updateBrakes(dt, braking, bodySpeed)

    local effHP = self:_computeEffectiveHP(effTop, prof, stageCfg)
    self._currentHP = effHP

    local ratios = prof.gearRatios or { 3.85, 2.20, 1.55, 1.20, 0.95, 0.80, 0.65 }
    local maxGear = #ratios
    local topRatio = ratios[maxGear] or 0.65
    local curRatio = ratios[math.clamp(math.abs(gear), 1, maxGear)] or topRatio

    local gearAngular = 0
    local governorBrake = 0

    if gear == -1 then
        local revTopMPH = math.min(effTop * 0.28, 40)
        gearAngular = -((revTopMPH * MPH_TO_STUDS) / self._wheelRadius)
    elseif gear >= 1 then
        local gearMaxMPH = effTop * (topRatio / math.max(curRatio, 0.01))
        local targetMPH
        if gear == maxGear then
            targetMPH = (posThr > 0.1 and bodySpeed < effTop * 0.995) and (effTop * 1.05) or effTop
        else
            targetMPH = gearMaxMPH * 1.04
        end
        gearAngular = (targetMPH * MPH_TO_STUDS) / self._wheelRadius

        if bodySpeed > effTop * 1.02 then
            governorBrake = math.clamp((bodySpeed - effTop) / 15, 0, 1)
        end
    end

    local torqueCurve = 1.0
    if phys.torqueCurve then
        torqueCurve = self.profiles:getTorqueAtRPM(prof, rpm)
    end

    local rwdEfficiency = (drivetrain == "RWD") and 1.06 or 1.0
    local launchBonus = (os.clock() < self._launchBurstUntil) and self._launchBurstMult or 1.0

    local rpmDenom = math.max(rpm / 4500, 0.55)
    local rawDriveG = 0.0025 * effHP * torqueCurve * curRatio * rwdEfficiency * launchBonus * slopeLoad / rpmDenom

    local avgGrip = ((settings.frontGrip or 1.0) + (settings.rearGrip or 0.9)) * 0.5
    local dtTraction = (drivetrain == "AWD") and 1.10 or ((drivetrain == "RWD") and 0.92 or 0.80)
    local tractionCapG = dtTraction * math.clamp(avgGrip, 0.5, 2.5)

    local tcsMult = 1.0
    if phys.tractionControl then
        local chassis = _G.VX.Chassis
        if chassis and chassis.spinActive then
            tcsMult = math.max(0.25, 1.0 - (phys.tractionControlSensitivity or 0.25))
        end
    end

    local dragG = 0.0000075 * (bodySpeed * bodySpeed) + 0.012
    local cappedDriveG = math.min(rawDriveG, tractionCapG) * tcsMult * math.min(posThr, 1)
    local netG = math.max(0, cappedDriveG - dragG)

    local drivenCount = 0
    for _, w in ipairs(handle.wheels or {}) do
        local isDriven = (drivetrain == "AWD")
            or (drivetrain == "FWD" and w.isFront)
            or (drivetrain == "RWD" and not w.isFront)
        if isDriven then drivenCount = drivenCount + 1 end
    end
    drivenCount = math.max(drivenCount, 1)

    -- Calibrate Roblox MotorMaxTorque & MotorMaxAngularAcceleration so wheels overcome ground friction smoothly
    local massFactor = math.max(1.0, self._vehicleMass / 150)
    local perWheelDriveTorque = (BASE_TORQUE_CALIBRATION * massFactor * (netG + 0.15)) * (4 / drivenCount) * (self._wheelRadius / 1.65)
    local brakeTorque = math.max(BASE_BRAKE_TORQUE * 0.65, 45000 * massFactor) * (settings.brakingPower or 0.75) * brakeMult
    local motorAngAccel = math.max(22, netG * 65)

    for _, w in ipairs(handle.wheels or {}) do
        local isDriven = (drivetrain == "AWD")
            or (drivetrain == "FWD" and w.isFront)
            or (drivetrain == "RWD" and not w.isFront)

        local mode = "coast"
        local angular = 0
        local torque = 0
        local angAccel = motorAngAccel

        if launchState == "holding" or twostepActive then
            mode = "brake"
            angular = 0
            torque = brakeTorque * 1.4
            angAccel = 120
        elseif shiftState == "open" and settings.realisticShifting then
            mode = "coast"
        elseif governorBrake > 0.05 and throttle >= 0 then
            mode = "drive"
            angular = (effTop * MPH_TO_STUDS) / self._wheelRadius
            torque = brakeTorque * 0.45 * governorBrake
            angAccel = 45
        elseif gear == -1 then
            if throttle < -0.05 and isDriven then
                mode = "drive"
                angular = gearAngular
                torque = (BASE_TORQUE_CALIBRATION * massFactor * 0.65) * (4 / drivenCount) * math.min(math.abs(throttle), 1)
                angAccel = 28
            elseif throttle > 0.05 then
                mode = "brake"
                angular = 0
                torque = brakeTorque * math.min(throttle, 1)
                angAccel = 120
            end
        else
            if posThr > 0.05 and isDriven then
                if netG <= 0.002 and bodySpeed > 8 then
                    mode = "coast"
                else
                    mode = "drive"
                    angular = gearAngular
                    torque = perWheelDriveTorque
                end
            elseif throttle < -0.05 then
                mode = "brake"
                angular = 0
                torque = brakeTorque * math.min(braking, 1)
                angAccel = 120
            end
        end

        if w.cylinder then
            pcall(function()
                if mode == "coast" then
                    w.cylinder.AngularActuatorType = Enum.ActuatorType.None
                else
                    w.cylinder.AngularActuatorType = Enum.ActuatorType.Motor
                    w.cylinder.MotorMaxAngularAcceleration = angAccel
                    w.cylinder.AngularVelocity = angular
                    w.cylinder.MotorMaxTorque = torque
                end
            end)
        end
    end
end

function Module:getHorsepower() return self._currentHP end
function Module:getBoost() return self.boostPressure end
function Module:getTurboStage() return self.turboStage end
function Module:getBrakeTemp() return self.brakeTemp end
function Module:getABSActivations() return self._absActivations end
function Module:getSteerAngle() return self.steerAngle end
function Module:getWheelSpeed() return self.wheelSpeed end
function Module:getWheelRadius() return self._wheelRadius end
function Module:getVehicleMass() return self._vehicleMass end
function Module:getEffectiveTopSpeed() return self._effectiveTopSpeed end

return Module
