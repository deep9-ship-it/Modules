--[[
    VX_DriveSystem v3.0.0
    Motor writes, brakes, turbo, launch burst, differential, ABS.

    Depends on: Core, Profiles, Authority, Powertrain, VehicleState
    Exposes:
      getBoost()          → number (0..1)
      setTurboStage(n)    → 0..3
      getTurboStage()     → 0..3
      getTurboStageName() → "Off" | "Low" | "Mid" | "High"
      getLaunchQuality()  → "miss" | "good" | "perfect"

    Emits:
      turbo.blowoff    { boost, intensity }
      turbo.spool      { boost, intensity }
      vehicle.backfire { source, count }
      vehicle.launchQuality { quality }

    Reads:
      Input.getRawThrottle()
      Input.isAccelHeld()
      Input.isBrakeHeld()
      Input.isClutchHeld()
      Powertrain.getSmoothedThrottle()
      Powertrain.getRPM()
      Powertrain.getGear()
      Powertrain.getShiftState()
      Powertrain.getLaunchState()
      settings.turboStage
      settings.realisticTurboEnabled

    Motor write strategy:
      - Forward: AngularVelocity = target wheel speed * gearFactor * throttle
                  MotorMaxTorque = curve * gearRatio * torqueMul * boostMul * diffShare
      - Brake:   AngularVelocity = 0
                  MotorMaxTorque = brakeForce * bias (per axle) * brakePower
      - Reverse: AngularVelocity = -reverseSpeed * |throttle|
                  MotorMaxTorque = reverseTorque
      - Coast:   AngularActuatorType = None
]]

local VX = _G.VX
if not VX or not VX.Framework then error("VX_DriveSystem requires VX_Kernel") end

local Module = VX.Framework.Module.new({
    Name = "DriveSystem",
    Dependencies = { "Core", "Profiles", "Authority", "Powertrain", "VehicleState" },
    Version = "3.0.0",
})

-- ==================== CONSTANTS ====================
local TICK_NORMAL   = 60
local TICK_LOW      = 30
local GEAR7_RATIO   = 0.65     -- normalizer so top speed reached in gear 7

-- ==================== STATE ====================
function Module:Construct()
    -- Turbo
    self.stage         = 1
    self.boostPressure = 0.0
    self.targetBoost   = 0.0
    self.lastBoostAtLift = 0
    self.lastBlowoffTime = 0
    self.spoolLastEmit = 0

    -- Anti-lag
    self.antiLagActive = false
    self._antiLagKeyDown = false

    -- Launch
    self.lastLaunchQuality = "miss"
    self.launchBoostActive = false

    -- Per-wheel state
    self.wheelState = {}  -- [name] = { brakeForce, targetAngular, motorTorque, lastWarn }

    -- Caches
    self._lastThrottleHigh = false
    self._lastThrottle     = 0

    -- Fade (integrated with Chassis but kept for brake modulation)
    self.brakeTemp = 0.0

    -- Loop
    self._loopThread = nil
    self._running = false

    -- Diagnostics
    self._totalTorque       = 0
    self._totalBrake        = 0
    self._blowoffCount      = 0
    self._spoolCount        = 0
    self._absActivations    = 0
    self._burstsFired       = 0
end

function Module:Init(deps)
    self.core     = deps.Core
    self.profiles = deps.Profiles
    self.authority = deps.Authority
    self.powertrain = deps.Powertrain
    self.state    = deps.VehicleState
end

function Module:Start()
    _G.VX.DriveSystem = self

    -- Sync stage from settings
    self.stage = self.core.settings.turboStage or 1

    -- Subscribe to settings changes
    _G.VX.bus:on("settings.changed", function(evt)
        if evt.path == "turboStage" then
            self.stage = evt.new or 1
        elseif evt.path == "settings.changed" then
            -- ignore
        end
    end)

    -- Subscribe to launch release for burst
    _G.VX.bus:on("vehicle.launchRelease", function(evt)
        self:_handleLaunchRelease(evt)
    end)

    -- Subscribe to state changes
    _G.VX.bus:on("vehicle.stateChanged", function(evt)
        if evt.to == "Ready" or evt.to == "Idle" then
            self:_start()
        elseif evt.to == "Exiting" or evt.to == "Disabled" then
            self:_stop()
        end
    end)

    -- Anti-lag key (L)
    local UIS = game:GetService("UserInputService")
    UIS.InputBegan:Connect(function(input, gp)
        if gp then return end
        if input.KeyCode == Enum.KeyCode.L then
            self._antiLagKeyDown = true
        end
    end)
    UIS.InputEnded:Connect(function(input)
        if input.KeyCode == Enum.KeyCode.L then
            self._antiLagKeyDown = false
        end
    end)

    self:_registerDiagnostics()
end

function Module:Stop()
    self:_stop()
    if _G.VX.DriveSystem == self then _G.VX.DriveSystem = nil end
end

function Module:heartbeat()
    if not self._running then return true end
    local handle = self.authority:getHandle()
    return handle ~= nil
end

function Module:_registerDiagnostics()
    local D = _G.VX.diagnostics
    pcall(function()
        D.register("drive.boost", {
            fn = function()
                return {
                    value = string.format("%.2f", self.boostPressure),
                    unit = "",
                    status = self.boostPressure > 1.2 and "warning" or "normal",
                }
            end,
            category = "DriveSystem",
        }, "DriveSystem")
        D.register("drive.torque", {
            fn = function()
                return { value = math.floor(self._totalTorque), unit = "N", status = "normal" }
            end,
            category = "DriveSystem",
        }, "DriveSystem")
        D.register("drive.brake", {
            fn = function()
                return { value = math.floor(self._totalBrake), unit = "N", status = "normal" }
            end,
            category = "DriveSystem",
        }, "DriveSystem")
        D.register("drive.stage", {
            fn = function()
                return { value = self.stage, unit = "", status = "normal" }
            end,
            category = "DriveSystem",
        }, "DriveSystem")
        D.register("drive.antiLag", {
            fn = function()
                return {
                    value = self.antiLagActive and "ON" or "off",
                    unit = "",
                    status = "normal",
                }
            end,
            category = "DriveSystem",
        }, "DriveSystem")
        D.register("drive.brakeTemp", {
            fn = function()
                return {
                    value = string.format("%.2f", self.brakeTemp),
                    unit = "",
                    status = self.brakeTemp > 0.7 and "warning" or "normal",
                }
            end,
            category = "DriveSystem",
        }, "DriveSystem")
    end)
end

-- ==================== MAIN LOOP ====================
function Module:_start()
    if self._running then return end
    self._running = true

    self.boostPressure = 0
    self.targetBoost = 0
    self.brakeTemp = 0
    self.wheelState = {}

    self._loopThread = task.spawn(function()
        local perf = self.core.settings._effectivePerformance
        local tickRate = (perf == "low") and TICK_LOW or TICK_NORMAL
        local interval = 1 / tickRate
        local last = os.clock()

        while self._running do
            local now = os.clock()
            local dt = now - last
            last = now
            if dt <= 0 or dt > 0.1 then dt = interval end

            pcall(self._update, self, dt)

            local sleep = interval - (os.clock() - now)
            if sleep > 0 then task.wait(sleep) end
        end
    end)

    print("[VX] DriveSystem started")
end

function Module:_stop()
    if not self._running then return end
    self._running = false
    if self._loopThread then
        pcall(function() task.cancel(self._loopThread) end)
        self._loopThread = nil
    end

    -- Restore motors to neutral
    local handle = self.authority:getHandle()
    if handle then
        for _, w in ipairs(handle.wheels or {}) do
            pcall(function()
                if w.cylinder then
                    w.cylinder.AngularActuatorType = Enum.ActuatorType.None
                    w.cylinder.AngularVelocity = 0
                    w.cylinder.MotorMaxTorque = 0
                end
            end)
        end
    end

    print("[VX] DriveSystem stopped")
end

function Module:_update(dt)
    local handle = self.authority:getHandle()
    if not handle then return end

    local stateName = self.state:getState()
    local isActive = stateName == "Idle" or stateName == "Driving"
                   or stateName == "Shifting" or stateName == "Launching"

    if not isActive then
        -- Ensure motors are disengaged
        for _, w in ipairs(handle.wheels) do
            pcall(function()
                if w.cylinder then
                    w.cylinder.AngularActuatorType = Enum.ActuatorType.None
                end
            end)
        end
        return
    end

    self:_updateTurbo(dt)
    self:_updateBrakeTemp(dt)
    self:_applyMotors(dt)
end

-- ==================== TURBO ====================
function Module:_updateTurbo(dt)
    local settings = self.core.settings
    local prof = self.profiles:current()
    local cfg = self.core.config.turboStages[self.stage] or self.core.config.turboStages[1]

    local rpm = self.powertrain:getRPM()
    local throttle = self.powertrain:getSmoothedThrottle()
    local launchState = self.powertrain:getLaunchState()

    -- Compute spool factor from RPM
    local spoolRPM = prof.turboSpoolRPM or 3500
    local rpmFactor = math.clamp((rpm - spoolRPM) / math.max(prof.redlineRPM - spoolRPM, 1), 0, 1)

    -- Target boost
    local throttleFactor = math.max(0, throttle)
    self.targetBoost = rpmFactor * throttleFactor * cfg.maxBoost

    -- Anti-lag: keep boost high when coasting with L held
    self.antiLagActive = false
    if settings.physics.antiLagEnabled and self._antiLagKeyDown
       and throttle < 0.1 and rpm > 2000 then
        self.antiLagActive = true
        self.targetBoost = math.max(self.targetBoost, cfg.maxBoost * 0.7)
    end

    -- Launch hold: build boost
    if launchState == "holding" then
        self.targetBoost = math.max(self.targetBoost, cfg.maxBoost * 0.9)
    end

    -- Integrate boost toward target
    local rate = (self.targetBoost > self.boostPressure)
        and (1.0 / math.max(cfg.spoolRate, 0.1))
        or (1.0 / 0.4)  -- spool down faster
    self.boostPressure = self.boostPressure + (self.targetBoost - self.boostPressure) * math.min(rate * dt * 4, 1)

    -- Clamp
    self.boostPressure = math.clamp(self.boostPressure, 0, cfg.maxBoost)

    -- Throttle lift detection for blowoff
    local throttleHigh = throttle > 0.6
    local throttleLift = self._lastThrottleHigh and throttle < 0.3
    if throttleLift and self.boostPressure > cfg.blowoffThreshold then
        local now = os.clock()
        if now - self.lastBlowoffTime > 0.25 then
            self.lastBlowoffTime = now
            self.lastBoostAtLift = self.boostPressure
            self._blowoffCount = self._blowoffCount + 1
            _G.VX.bus:emit("turbo.blowoff", {
                boost = self.boostPressure,
                intensity = self.boostPressure / math.max(cfg.maxBoost, 0.01),
            })
        end
    end
    self._lastThrottleHigh = throttleHigh
    self._lastThrottle = throttle

    -- Continuous spool emit
    local now = os.clock()
    if now - self.spoolLastEmit > 0.1 and self.boostPressure > 0.05 then
        self.spoolLastEmit = now
        self._spoolCount = self._spoolCount + 1
        _G.VX.bus:emit("turbo.spool", {
            boost = self.boostPressure,
            intensity = self.boostPressure / math.max(cfg.maxBoost, 0.01),
            antiLag = self.antiLagActive,
        })
    end

    -- Realistic turbo: feed back to Seat.Turbo if enabled
    if settings.realisticTurboEnabled then
        local handle = self.authority:getHandle()
        if handle and handle.seat then
            local gear = self.powertrain:getGear()
            local base = settings.baseTurbo or 11.3
            local eff = base
            if gear >= 2 then
                local psi = self.boostPressure * 25 / math.max(cfg.maxBoost, 0.01)
                eff = base * math.max(0.3, psi / 2)
            end
            pcall(function()
                local tv = handle.seat:FindFirstChild("Turbo")
                if tv then tv.Value = tostring(eff) end
            end)
        end
    end
end

-- ==================== BRAKE TEMPERATURE ====================
function Module:_updateBrakeTemp(dt)
    local throttle = self.powertrain:getSmoothedThrottle()
    local fadeEnabled = self.core.settings.physics.brakeFadeEnabled

    -- Heat from braking (throttle < 0)
    local braking = math.max(0, -throttle)
    local heatIn = braking * 0.15 * dt

    -- Cooling
    local coolRate = 0.08 * dt
    local speed = self:_getSpeed()
    local airflowCool = 1 + (speed / 100) * 0.2

    self.brakeTemp = self.brakeTemp + heatIn - coolRate * airflowCool
    self.brakeTemp = math.clamp(self.brakeTemp, 0, 1)

    if not fadeEnabled then
        -- If disabled, always cool to 0
        self.brakeTemp = math.max(0, self.brakeTemp - 0.15 * dt)
    end
end

-- ==================== MOTOR WRITES ====================
function Module:_applyMotors(dt)
    local handle = self.authority:getHandle()
    if not handle then return end

    local settings = self.core.settings
    local config = self.core.config
    local prof = self.profiles:current()
    local gear = self.powertrain:getGear()
    local throttle = self.powertrain:getSmoothedThrottle()
    local rpm = self.powertrain:getRPM()
    local shiftState = self.powertrain:getShiftState()
    local launchState = self.powertrain:getLaunchState()
    local speed = self:_getSpeed()

    -- Clutch open → disengage motors
    if shiftState == "open" then
        for _, w in ipairs(handle.wheels) do
            pcall(function()
                if w.cylinder then
                    w.cylinder.AngularActuatorType = Enum.ActuatorType.None
                end
            end)
        end
        self._totalTorque = 0
        self._totalBrake = 0
        return
    end

    -- Launch hold → force coast (motors off, brake holds)
    if launchState == "holding" then
        for _, w in ipairs(handle.wheels) do
            pcall(function()
                if w.cylinder then
                    w.cylinder.AngularActuatorType = Enum.ActuatorType.None
                    w.cylinder.AngularVelocity = 0
                    w.cylinder.MotorMaxTorque = 0
                end
            end)
        end
        self._totalTorque = 0
        self._totalBrake = 0
        return
    end

    -- Compute wheel radius
    local wheelRadius = 1.55
    if handle.wheels[1] and handle.wheels[1].physical then
        wheelRadius = handle.wheels[1].physical.Size.Y / 2
    end

    -- Compute base wheel target
    local targetTopStuds = settings.topSpeed * 0.626
    local targetMaxWheelRad = targetTopStuds / math.max(wheelRadius, 0.01)
    local gearSpeedFactor = GEAR7_RATIO / math.max(prof.gearRatios[gear] or 1, 0.01)

    -- Torque curve
    local torqueCurve = 1.0
    if settings.physics.torqueCurve then
        torqueCurve = self.profiles:getTorqueAtRPM(prof, rpm)
    end

    -- Load factor from slope
    local loadFactor = self.powertrain:getSlopeLoadFactor()

    -- Boost multiplier (turbo increases torque delivery)
    local cfg = config.turboStages[self.stage] or config.turboStages[1]
    local boostMult = 1 + (self.boostPressure / math.max(cfg.maxBoost, 0.01)) * 0.35

    -- Base torque
    local baseTorque = 19140  -- matches stock MotorMaxTorque in scan
    local gearTorqueMult = prof.gearRatios[gear] or 1
    local torqueMult = self.core.settings.brakeBiasEnabled and 1 or 1
    -- Not used: keep default; the torque bias user-set is separate
    local finalBaseTorque = baseTorque * gearTorqueMult * torqueCurve * loadFactor * boostMult

    -- ABS check: brake bias from settings
    local biasEnabled = settings.brakeBiasEnabled
    local biasDev = biasEnabled and ((settings.brakeBias - 0.5) * 2 * settings.brakeBiasIntensity) or 0
    -- biasDev > 0: more front. biasDev < 0: more rear.

    -- Brake force factor (from brakingPower + brakeTemp)
    local brakePower = settings.brakingPower
    local fadeMult = 1
    if settings.physics.brakeFadeEnabled then
        fadeMult = 1 - self.brakeTemp * 0.3
    end

    self._totalTorque = 0
    self._totalBrake = 0

    -- Iterate wheels
    for _, w in ipairs(handle.wheels) do
        local ws = self.wheelState[w.name] or {}
        self.wheelState[w.name] = ws

        local isFront = w.isFront
        local slip = self:_estimateWheelSlip(w, speed)

        -- Determine drive/brake/coast
        local mode = "coast"
        local angular = 0
        local torque  = 0

        if gear == -1 then
            -- Reverse
            if throttle < -0.05 then
                mode = "reverse"
                angular = -targetMaxWheelRad * 0.2 * math.abs(throttle)
                torque = finalBaseTorque * 0.6
            end
        else
            -- Forward
            if throttle > 0.05 then
                mode = "drive"
                angular = targetMaxWheelRad * gearSpeedFactor * throttle

                -- Differential: front vs rear distribution
                local axleFactor = 0.5  -- AWD: 50/50 split
                if isFront then
                    torque = finalBaseTorque * axleFactor
                else
                    torque = finalBaseTorque * axleFactor
                end

                -- Traction control: reduce torque on slipping wheel
                if settings.physics.tractionControl and slip > settings.physics.tractionControlSensitivity then
                    local tcsFactor = 1 - math.clamp(slip - settings.physics.tractionControlSensitivity, 0, 0.6)
                    torque = torque * tcsFactor
                    angular = angular * (0.5 + 0.5 * tcsFactor)
                end
            elseif throttle < -0.05 then
                mode = "brake"
                angular = 0
                local baseBrake = baseTorque * 1.5 * brakePower * math.abs(throttle) * fadeMult
                local axleDev = isFront and biasDev or -biasDev
                torque = baseBrake * (1 + axleDev)
                -- ABS
                if settings.physics.absEnabled and slip > 0.3 then
                    local pulse = 0.4 + math.sin(os.clock() * 20) * 0.3
                    torque = torque * pulse
                    self._absActivations = self._absActivations + 1
                end
                self._totalBrake = self._totalBrake + torque
            end
        end

        -- Write to cylinder
        if w.cylinder then
            pcall(function()
                if mode == "coast" then
                    w.cylinder.AngularActuatorType = Enum.ActuatorType.None
                else
                    w.cylinder.AngularActuatorType = Enum.ActuatorType.Motor
                    w.cylinder.AngularVelocity = angular
                    w.cylinder.MotorMaxTorque = torque
                end
            end)
        end

        if mode == "drive" then
            self._totalTorque = self._totalTorque + torque
        end

        ws.mode = mode
        ws.angular = angular
        ws.torque = torque
        ws.slip = slip
    end
end

function Module:_estimateWheelSlip(wheel, speedStuds)
    if not wheel.cylinder then return 0 end
    local angular = math.abs(wheel.cylinder.AngularVelocity or 0)
    local radius = wheel.physical and (wheel.physical.Size.Y / 2) or 1.55
    local wheelSurface = angular * radius
    local v = speedStuds / 0.626  -- convert back to studs/s
    local slip = math.abs(wheelSurface - v) / math.max(v, 1)
    return math.clamp(slip, 0, 3)
end

function Module:_getSpeed()
    local handle = self.authority:getHandle()
    if not handle or not handle.root or not handle.root.PrimaryPart then return 0 end
    local v = handle.root.PrimaryPart.AssemblyLinearVelocity
    return Vector3.new(v.X, 0, v.Z).Magnitude * 0.626
end

-- ==================== LAUNCH BURST ====================
function Module:_handleLaunchRelease(evt)
    self.lastLaunchQuality = evt.quality or "miss"
    _G.VX.bus:emit("vehicle.launchQuality", { quality = self.lastLaunchQuality })

    -- Only fire burst for good/perfect
    if evt.quality == "perfect" or evt.quality == "good" then
        local countMin = (evt.quality == "perfect") and 20 or 12
        local countMax = (evt.quality == "perfect") and 30 or 18
        local count = math.random(countMin, countMax)

        task.spawn(function()
            for i = 1, count do
                _G.VX.bus:emit("vehicle.backfire", { source = "launch", count = 1 })
                -- Pulse remote boost for VFX
                if _G.VX.Remote then
                    pcall(function() _G.VX.Remote:fireBoostPulse(0.05) end)
                end
                task.wait(math.random(15, 35) / 1000)  -- 15-35ms between pops
            end
        end)

        self._burstsFired = self._burstsFired + 1
        print("[VX] Launch burst fired: " .. evt.quality .. " (" .. count .. " pops)")
    end
end

-- ==================== PUBLIC API ====================
function Module:getBoost() return self.boostPressure end
function Module:getTurboStage() return self.stage end
function Module:getLaunchQuality() return self.lastLaunchQuality end

function Module:setTurboStage(n)
    n = math.clamp(n or 0, 0, 3)
    self.stage = n
    _G.VX.setSetting("turboStage", n)
end

function Module:getTurboStageName()
    return ({ [0]="Off", [1]="Low", [2]="Mid", [3]="High" })[self.stage] or "Low"
end

return Module
