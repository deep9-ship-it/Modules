--[[
    VX_Remote v3.0.0
    Centralized server communication with rate limiting and fallback.

    Depends on: Core
    Exposes:
      playSound(soundId, volume, pitch, parentPart)
      fireBoostPulse(duration)
      sendThrottle(value)
      toggleHeadlights(), toggleHazards(), setDriftStrength(v)
      getStatus()

    Rate limits:
      sounds   : 6/sec total, 3/sec per-id
      boost    : 4/sec
      throttle : 10/sec
]]

local VX = _G.VX
if not VX or not VX.Framework then error("VX_Remote requires VX_Kernel") end

local RS = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")
local Debris = game:GetService("Debris")
local Player = Players.LocalPlayer

local Module = VX.Framework.Module.new({
    Name = "Remote",
    Dependencies = { "Core" },
    Version = "3.0.0",
})

-- ==================== CONSTANTS ====================
local RATE = {
    soundTotalPerSec   = 6,
    soundPerIdPerSec   = 3,
    boostPerSec        = 4,
    throttlePerSec     = 10,
    throttleChangeEps  = 0.02,
}

-- ==================== LIFECYCLE ====================
function Module:Construct()
    self._gunSounds        = nil
    self._vehicleController = nil
    self._toggleHeadlights = nil
    self._toggleHazards    = nil
    self._setDrift         = nil
    self._setBoost         = nil
    self._setThrottle      = nil

    self._soundTimesById  = {}
    self._soundTimesTotal = {}
    self._boostTimes      = {}
    self._throttleTimes   = {}
    self._lastThrottleSent = nil
    self._lastBoostPulse   = 0
    self._lastThrottleSend = 0

    self.status = {
        gunSounds = false,
        boost     = false,
        throttle  = false,
        lights    = false,
        drift     = false,
        vc        = false,
    }
end

function Module:Init(deps)
    self:_locateRemotes()
    print("[VX] Remote status: " .. self:_statusString())
end

function Module:Start()
    _G.VX.Remote = self
end

function Module:Stop()
    self._gunSounds = nil
    self._vehicleController = nil
    if _G.VX.Remote == self then _G.VX.Remote = nil end
end

function Module:heartbeat()
    return self.status.gunSounds or self.status.vc
end

-- ==================== DISCOVERY ====================
function Module:_locateRemotes()
    -- GunSounds via Player8Handler
    pcall(function()
        local handler = Player:WaitForChild("PlayerGui", 3):FindFirstChild("Player8Handler")
        if handler then
            local settings = handler:FindFirstChild("Game8Settings")
            if settings then
                local req = require(settings)
                if req and req.GunSounds then
                    self._gunSounds = req.GunSounds
                    self.status.gunSounds = true
                end
            end
        end
    end)

    -- Remotes folder
    local remotes = RS:FindFirstChild("Remotes")
    if remotes then
        self._toggleHeadlights = remotes:FindFirstChild("ToggleHeadLights")
        self._toggleHazards    = remotes:FindFirstChild("ToggleHazards")
        self._setDrift         = remotes:FindFirstChild("SetDriftStrength")
        self._setBoost         = remotes:FindFirstChild("SET_BOOST")
        self._setThrottle      = remotes:FindFirstChild("SET_THROTTLE_FLOAT")

        if self._toggleHeadlights and self._toggleHazards then
            self.status.lights = true
        end
        if self._setDrift then self.status.drift = true end
        if self._setBoost then self.status.boost = true end
        if self._setThrottle then self.status.throttle = true end
    end

    -- VehicleController (used for SetBoost + SetThrottleFloat)
    pcall(function()
        local vc = require(RS:WaitForChild("Modules", 3):WaitForChild("Client", 3)
            :WaitForChild("Vehicles", 3):WaitForChild("VehicleController", 3))
        if vc then
            self._vehicleController = vc
            self.status.vc = true
        end
    end)
end

function Module:_statusString()
    local parts = {}
    for k, v in pairs(self.status) do
        table.insert(parts, k .. "=" .. (v and "✓" or "✗"))
    end
    return table.concat(parts, " ")
end

-- ==================== RATE LIMITER ====================
local function _rateBucket(tbl, key, perSec)
    local now = tick()
    local times = tbl[key]
    if not times then
        times = {}
        tbl[key] = times
    end
    local cutoff = now - 1
    local kept = {}
    for _, t in ipairs(times) do
        if t > cutoff then table.insert(kept, t) end
    end
    tbl[key] = kept
    if #kept >= perSec then return false end
    table.insert(kept, now)
    tbl[key] = kept
    return true
end

-- ==================== SOUND ====================
function Module:playSound(soundId, volume, pitch, parentPart)
    soundId = tostring(soundId)
    volume = volume or 1
    pitch = pitch or 1

    -- Always play locally for instant feedback
    local localSound = Instance.new("Sound")
    localSound.SoundId = "rbxassetid://" .. soundId
    localSound.Volume = volume
    localSound.PlaybackSpeed = pitch
    localSound.Parent = Player:WaitForChild("PlayerGui")
    localSound:Play()
    Debris:AddItem(localSound, 8)

    -- Try to replicate via GunSounds
    if not self._gunSounds or not parentPart then return end
    if not _rateBucket(self._soundTimesById, soundId, RATE.soundPerIdPerSec) then return end
    if not _rateBucket(self._soundTimesTotal, "_total", RATE.soundTotalPerSec) then return end

    pcall(function()
        self._gunSounds:FireServer(parentPart, tonumber(soundId), volume, pitch)
    end)
end

-- ==================== BOOST (Backfire VFX) ====================
function Module:fireBoostPulse(duration)
    local now = tick()
    if now - self._lastBoostPulse < 0.25 then return end
    if not _rateBucket(self._boostTimes, "_total", RATE.boostPerSec) then return end
    self._lastBoostPulse = now

    duration = duration or 0.06

    -- Local: prefer VehicleController.SetBoost (hooked by game's VehicleBoost)
    if self._vehicleController then
        pcall(function() self._vehicleController.SetBoost(true) end)
        task.delay(duration, function()
            if self._vehicleController then
                pcall(function() self._vehicleController.SetBoost(false) end)
            end
        end)
        return
    end

    -- Fallback: raw remote
    if self._setBoost then
        pcall(function() self._setBoost:FireServer(true) end)
        task.delay(duration, function()
            pcall(function() self._setBoost:FireServer(false) end)
        end)
    end
end

-- ==================== THROTTLE ====================
function Module:sendThrottle(value)
    -- Rate gate
    local now = tick()
    if now - self._lastThrottleSend < (1 / RATE.throttlePerSec) then return end
    if self._lastThrottleSent and math.abs(self._lastThrottleSent - value) < RATE.throttleChangeEps then return end

    self._lastThrottleSend = now
    self._lastThrottleSent = value

    if self._vehicleController and self._vehicleController.SetThrottleFloat then
        pcall(function() self._vehicleController.SetThrottleFloat(value) end)
    elseif self._setThrottle then
        pcall(function() self._setThrottle:FireServer(value) end)
    end
end

-- ==================== LIGHTS ====================
function Module:toggleHeadlights()
    if self._toggleHeadlights then
        pcall(function() self._toggleHeadlights:InvokeServer() end)
    end
end

function Module:toggleHazards()
    if self._toggleHazards then
        pcall(function() self._toggleHazards:InvokeServer() end)
    end
end

-- ==================== DRIFT ====================
function Module:setDriftStrength(value)
    if self._setDrift then
        pcall(function() self._setDrift:FireServer(value) end)
    end
end

-- ==================== STATUS ====================
function Module:getStatus()
    return self.status
end

return Module
