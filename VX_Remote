--[[
    VX_Remote v3.0.1
    Handles ALL server replication & fallback audio/VFX.
    - Sequence-guarded fireBoostPulse (0.03s cooldown) so rapid redline backfires
      keep SET_BOOST spitting fire continuously without premature off-flickers.
]]

local VX = _G.VX
if not VX or not VX.Framework then error("VX_Remote requires VX_Kernel") end

local Players           = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Debris            = game:GetService("Debris")

local Player = Players.LocalPlayer

local Module = VX.Framework.Module.new({
    Name = "Remote",
    Dependencies = { "Core" },
    Version = "3.0.1",
})

local SOUND_COOLDOWN_MS = 0.03
local BOOST_COOLDOWN_MS = 0.03
local THROTTLE_HZ       = 10

function Module:Construct()
    self._gunSoundsRemote = nil
    self._remotesFolder   = nil
    self._vehicleController = nil
    self._remotes = {
        headlights = nil, hazards = nil, drift = nil, boost = nil, throttle = nil,
    }
    self._lastSoundTime    = 0
    self._lastBoostTime    = 0
    self._lastThrottleTime = 0
    self._lastThrottleVal  = nil
    self._boostSeq         = 0
    self._boostActive      = false
    self._stats = { soundsSent = 0, soundsFallback = 0, boostPulses = 0, remoteFailures = 0 }
end

function Module:Init(deps)
    self.core = deps.Core
    self:_discover()
end

function Module:Start()
    _G.VX.Remote = self
    self:_registerDiagnostics()
end

function Module:Stop()
    if _G.VX.Remote == self then _G.VX.Remote = nil end
end

function Module:heartbeat()
    return true
end

function Module:_registerDiagnostics()
    local D = _G.VX.diagnostics
    pcall(function()
        D.register("remote.soundsSent",     { fn = function() return { value = self._stats.soundsSent, unit = "", status = "normal" } end, category = "Remote" }, "Remote")
        D.register("remote.soundsFallback", { fn = function() return { value = self._stats.soundsFallback, unit = "", status = "normal" } end, category = "Remote" }, "Remote")
        D.register("remote.boostPulses",    { fn = function() return { value = self._stats.boostPulses, unit = "", status = "normal" } end, category = "Remote" }, "Remote")
        D.register("remote.failures",       { fn = function() return { value = self._stats.remoteFailures, unit = "", status = self._stats.remoteFailures > 10 and "warn" or "normal" } end, category = "Remote" }, "Remote")
    end)
end

-- ==================== DISCOVERY ====================
function Module:_discover()
    task.spawn(function()
        local p8 = Player:FindFirstChild("Player8Handler") or Player:WaitForChild("Player8Handler", 3)
        if p8 then
            local g8 = p8:FindFirstChild("Game8Settings")
            if g8 then
                self._gunSoundsRemote = g8:FindFirstChild("GunSounds")
            end
        end

        local rf = ReplicatedStorage:FindFirstChild("Remotes")
        if rf then
            self._remotesFolder = rf
            self._remotes.headlights = rf:FindFirstChild("ToggleHeadLights")
            self._remotes.hazards    = rf:FindFirstChild("ToggleHazards")
            self._remotes.drift      = rf:FindFirstChild("SetDriftStrength")
            self._remotes.boost      = rf:FindFirstChild("SET_BOOST")
            self._remotes.throttle   = rf:FindFirstChild("SET_THROTTLE_FLOAT")
        end

        local ps = Player:FindFirstChild("PlayerScripts")
        if ps then
            local vc = ps:FindFirstChild("VehicleController")
            if vc and vc:IsA("ModuleScript") then
                pcall(function() self._vehicleController = require(vc) end)
            end
        end

        local found = 0
        if self._gunSoundsRemote then found = found + 1 end
        for _, r in pairs(self._remotes) do if r then found = found + 1 end end
        print("[VX] Remote discovered " .. found .. " endpoints")
    end)
end

-- ==================== SOUND REPLICATION ====================
function Module:playSound(soundId, volume, pitch, parent)
    local now = os.clock()
    if now - self._lastSoundTime < SOUND_COOLDOWN_MS then
        return false
    end
    self._lastSoundTime = now

    if self._gunSoundsRemote then
        local ok = pcall(function()
            self._gunSoundsRemote:FireServer(soundId, volume, pitch, parent)
        end)
        if ok then
            self._stats.soundsSent = self._stats.soundsSent + 1
            return true
        else
            self._stats.remoteFailures = self._stats.remoteFailures + 1
        end
    end

    self._stats.soundsFallback = self._stats.soundsFallback + 1
    pcall(function()
        local s = Instance.new("Sound")
        s.SoundId = "rbxassetid://" .. tostring(soundId)
        s.Volume = volume or 1
        s.PlaybackSpeed = pitch or 1
        s.RollOffMode = Enum.RollOffMode.Linear
        s.RollOffMaxDistance = 300
        s.Parent = parent or workspace
        s:Play()
        Debris:AddItem(s, 3)
    end)
    return false
end

-- ==================== BOOST PULSE ====================
function Module:_setBoostState(state)
    local sent = false
    if self._remotes.boost then
        local ok = pcall(function() self._remotes.boost:FireServer(state) end)
        if ok then sent = true else self._stats.remoteFailures = self._stats.remoteFailures + 1 end
    end
    if not sent and self._vehicleController and self._vehicleController.SetBoost then
        pcall(function() self._vehicleController:SetBoost(state) end)
    end
    self._boostActive = state
end

function Module:fireBoostPulse(duration)
    local now = os.clock()
    if now - self._lastBoostTime < BOOST_COOLDOWN_MS then return end
    self._lastBoostTime = now

    duration = duration or 0.08
    self._boostSeq = self._boostSeq + 1
    local mySeq = self._boostSeq

    self._stats.boostPulses = self._stats.boostPulses + 1
    self:_setBoostState(true)

    task.delay(duration, function()
        if self._boostSeq == mySeq then
            self:_setBoostState(false)
        end
    end)
end

-- ==================== THROTTLE REPLICATION ====================
function Module:sendThrottle(value)
    local now = os.clock()
    if now - self._lastThrottleTime < (1 / THROTTLE_HZ) then return end
    if self._lastThrottleVal and math.abs(value - self._lastThrottleVal) < 0.02 then return end
    self._lastThrottleTime = now
    self._lastThrottleVal = value

    if self._remotes.throttle then
        pcall(function() self._remotes.throttle:FireServer(value) end)
    elseif self._vehicleController and self._vehicleController.SetThrottleFloat then
        pcall(function() self._vehicleController:SetThrottleFloat(value) end)
    end
end

-- ==================== LIGHTS & DRIFT ====================
function Module:toggleHeadlights()
    if self._remotes.headlights then
        pcall(function() self._remotes.headlights:FireServer() end)
    end
end

function Module:toggleHazards()
    if self._remotes.hazards then
        pcall(function() self._remotes.hazards:FireServer() end)
    end
end

function Module:setDriftStrength(val)
    if self._remotes.drift then
        pcall(function() self._remotes.drift:FireServer(val) end)
    end
end

function Module:getStatus()
    return {
        gunSounds = self._gunSoundsRemote ~= nil,
        remotesFolder = self._remotesFolder ~= nil,
        stats = self._stats,
    }
end

return Module
