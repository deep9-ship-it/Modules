--[[
    VX_authority.lua — Seat/Chassis/Wheel Discovery, Selective Steering Isolation, Weld & Restoration
    Version: 3.0.3
]]

local VX = _G.VX
if not VX or not VX.Framework then
    error("[VX_authority] Requires VX_Kernel")
end

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local CollectionService = game:GetService("CollectionService")

local Module = VX.Framework.Module.new({
    Name = "Authority",
    Dependencies = { "Core" },
    Version = "3.0.3",
})

local REVERIFY_INTERVAL = 1.5
local FRONT_NAMES = { "FL", "FR" }
local REAR_NAMES = { "RL", "RR" }
local ALL_WHEELS = { "FL", "FR", "RL", "RR" }

local function _findVehicleFromSeat(seat)
    if not seat or not seat:IsA("VehicleSeat") then return nil end
    local model = seat:FindFirstAncestorOfClass("Model")
    while model and model.Parent and model.Parent:IsA("Model") do
        if model:FindFirstChild("Wheels") or model:FindFirstChild("Chassis") then
            break
        end
        model = model.Parent
    end
    if not model then model = seat.Parent end
    local chassis = model:FindFirstChild("Chassis") or model
    local platform = chassis:FindFirstChild("Platform") or model:FindFirstChild("Platform") or chassis:FindFirstChild("Base")
    local mass = chassis:FindFirstChild("Mass") or model:FindFirstChild("Mass")
    return model, chassis, platform, mass
end

local function _findWheels(root, chassis)
    local wheels = { FL = nil, FR = nil, RL = nil, RR = nil }
    local wheelFolder = root:FindFirstChild("Wheels") or chassis:FindFirstChild("Wheels") or root

    for _, name in ipairs(ALL_WHEELS) do
        local wModel = wheelFolder:FindFirstChild(name) or root:FindFirstChild(name, true)
        if wModel then
            local phys = wModel:FindFirstChild("PhysicalWheel") or wModel:FindFirstChild("Wheel") or wModel:FindFirstChildWhichIsA("BasePart")
            local spring = wModel:FindFirstChildWhichIsA("SpringConstraint", true)
            local cyl = wModel:FindFirstChildWhichIsA("CylindricalConstraint", true)
            local attHolder = wModel:FindFirstChild("AttachmentHolder") or wModel:FindFirstChild("Steer")
            local att = attHolder and attHolder:FindFirstChildWhichIsA("Attachment")
            if not att then
                att = wModel:FindFirstChildWhichIsA("Attachment", true)
            end

            local origProps = phys and phys.CustomPhysicalProperties
            wheels[name] = {
                name = name,
                model = wModel,
                physical = phys,
                spring = spring,
                cylindrical = cyl,
                attachment = att,
                origProperties = origProps,
                origFriction = origProps and origProps.Friction or 1.5,
                origSpringDamping = spring and spring.Damping,
                origSpringStiffness = spring and spring.Stiffness,
                origAttOrientation = att and att.Orientation,
                isFront = (name == "FL" or name == "FR"),
                isRear = (name == "RL" or name == "RR"),
            }
        end
    end
    return wheels
end

local function _findSoundAndVFX(root, seat)
    local emitter = seat:FindFirstChild("EngineSoundEmitter")
        or root:FindFirstChild("EngineSoundEmitter", true)
        or root:FindFirstChild("Exhaust", true)
        or seat

    local flames = {}
    for _, desc in ipairs(root:GetDescendants()) do
        if desc:IsA("ParticleEmitter") then
            local n = string.lower(desc.Name)
            if string.find(n, "flame") or string.find(n, "backfire") or string.find(n, "exhaust") then
                table.insert(flames, desc)
            end
        end
    end

    local origSound = nil
    for _, desc in ipairs(root:GetDescendants()) do
        if desc:IsA("Sound") and desc.Name ~= "VX_Engine" and desc.Name ~= "VX_TurboSpool" then
            local n = string.lower(desc.Name)
            if string.find(n, "engine") or string.find(n, "rev") or string.find(n, "idle") then
                origSound = desc
                break
            end
        end
    end

    return emitter, flames, origSound
end

function Module:_disableGameSteering(seat)
    local disabledScripts = {}
    local disabledConns = {}

    for _, inst in ipairs(CollectionService:GetTagged("VehicleSteering")) do
        if inst:IsA("LocalScript") or inst:IsA("Script") then
            if not inst.Disabled then
                inst.Disabled = true
                table.insert(disabledScripts, inst)
            end
        end
    end

    local player = Players.LocalPlayer
    local containers = { seat, player and player:FindFirstChild("PlayerScripts"), player and player:FindFirstChild("PlayerGui") }
    for _, root in ipairs(containers) do
        if root then
            for _, d in ipairs(root:GetDescendants()) do
                if (d:IsA("LocalScript") or d:IsA("Script")) and not d.Disabled then
                    local lower = string.lower(d.Name)
                    if string.find(lower, "vehiclesteering") and not string.find(lower, "vehiclecontrols") then
                        d.Disabled = true
                        table.insert(disabledScripts, d)
                    end
                end
            end
        end
    end

    if type(getconnections) == "function" then
        pcall(function()
            for _, conn in ipairs(getconnections(RunService.Heartbeat)) do
                local fn = conn.Function
                if fn then
                    local info = debug.info(fn, "s")
                    if info and string.find(string.lower(info), "vehiclesteering") then
                        if conn.Disable then
                            conn:Disable()
                            table.insert(disabledConns, conn)
                        end
                    end
                end
            end
        end)
    end

    -- Preserve VehicleControls & force mobile pedal UI visible
    if player then
        local pg = player:FindFirstChild("PlayerGui")
        local mgh = pg and pg:FindFirstChild("MainGUIHandler")
        local vc = mgh and mgh:FindFirstChild("VehicleControls")
        if vc then
            if vc:IsA("GuiObject") then vc.Visible = true end
            if vc:IsA("ScreenGui") then vc.Enabled = true end
            for _, btnName in ipairs({ "Accelerator", "Brake", "Left", "Right" }) do
                local b = vc:FindFirstChild(btnName, true)
                if b and b:IsA("GuiObject") then
                    b.Visible = true
                end
            end
        end
    end

    return disabledScripts, disabledConns
end

function Module:_setupMassTiltWeld(root, chassis, mass)
    if not mass or not mass:IsA("BasePart") then return nil end

    local origWeld = nil
    local otherPart = chassis:IsA("BasePart") and chassis or root.PrimaryPart
    for _, d in ipairs(root:GetDescendants()) do
        if d:IsA("WeldConstraint") and (d.Part0 == mass or d.Part1 == mass) then
            origWeld = d
            otherPart = (d.Part0 == mass) and d.Part1 or d.Part0
            d.Enabled = false
            break
        end
    end
    if not otherPart then return nil end

    local existing = mass:FindFirstChild("VX_MassTiltWeld")
    if existing then existing:Destroy() end

    local origSize = mass.Size
    local relCF = otherPart.CFrame:ToObjectSpace(mass.CFrame)
    local weld = Instance.new("Weld")
    weld.Name = "VX_MassTiltWeld"
    weld.Part0 = otherPart
    weld.Part1 = mass
    weld.C0 = relCF
    weld.C1 = CFrame.new()
    weld.Parent = mass

    mass.Size = Vector3.new(4, 4, 10)

    return {
        weld = weld,
        origWeld = origWeld,
        origC0 = relCF,
        origSize = origSize,
        mass = mass,
    }
end

function Module:takeover(seat)
    if not seat or not seat:IsA("VehicleSeat") then return false end
    if self._active and self._handle and self._handle.seat == seat then
        return true
    end
    if self._active then
        self:release("new_takeover")
    end

    local root, chassis, platform, mass = _findVehicleFromSeat(seat)
    if not root then return false end

    local wheels = _findWheels(root, chassis)
    local emitter, flames, origSound = _findSoundAndVFX(root, seat)
    local origSoundVol = origSound and origSound.Volume or nil
    if origSound then
        origSound.Volume = 0
    end

    local disabledScripts, disabledConns = self:_disableGameSteering(seat)
    local tiltData = self:_setupMassTiltWeld(root, chassis, mass)

    self._handle = {
        seat = seat,
        root = root,
        chassis = chassis,
        platform = platform,
        mass = mass,
        wheels = wheels,
        frontNames = FRONT_NAMES,
        rearNames = REAR_NAMES,
        emitter = emitter,
        exhaustFlames = flames,
        origEngineSound = origSound,
        origEngineSoundVol = origSoundVol,
        tiltWeld = tiltData and tiltData.weld or nil,
        origTiltC0 = tiltData and tiltData.origC0 or nil,
        _tiltData = tiltData,
        _disabledScripts = disabledScripts,
        _disabledConns = disabledConns,
    }
    self._active = true
    self._lastVerify = os.clock()

    if _G.VX and _G.VX.bus then
        _G.VX.bus:emit("authority.taken", { handle = self._handle })
    end
    return true
end

function Module:release(reason)
    local h = self._handle
    if not h then
        self._active = false
        return
    end

    for _, w in pairs(h.wheels or {}) do
        if w.physical and w.physical.Parent then
            if w.origProperties then
                w.physical.CustomPhysicalProperties = w.origProperties
            else
                w.physical.CustomPhysicalProperties = PhysicalProperties.new(0.7, w.origFriction or 1.5, 0.2, 1, 1)
            end
        end
        if w.cylindrical and w.cylindrical.Parent then
            w.cylindrical.AngularVelocity = 0
            w.cylindrical.MotorMaxTorque = 0
        end
        if w.attachment and w.attachment.Parent and w.origAttOrientation then
            w.attachment.Orientation = w.origAttOrientation
        end
    end

    if h._tiltData then
        local td = h._tiltData
        if td.weld and td.weld.Parent then td.weld:Destroy() end
        if td.origWeld and td.origWeld.Parent then td.origWeld.Enabled = true end
        if td.mass and td.mass.Parent and td.origSize then td.mass.Size = td.origSize end
    end

    for _, s in ipairs(h._disabledScripts or {}) do
        if s and s.Parent then pcall(function() s.Disabled = false end) end
    end
    for _, c in ipairs(h._disabledConns or {}) do
        if c and c.Enable then pcall(function() c:Enable() end) end
    end

    if h.origEngineSound and h.origEngineSound.Parent and h.origEngineSoundVol then
        h.origEngineSound.Volume = h.origEngineSoundVol
    end

    self._handle = nil
    self._active = false

    if _G.VX and _G.VX.bus then
        _G.VX.bus:emit("authority.lost", { reason = reason or "released" })
    end
end

function Module:verify()
    if not self._active or not self._handle then return false end
    local h = self._handle
    local player = Players.LocalPlayer
    local char = player and player.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")

    if not h.seat or not h.seat.Parent or not hum or hum.SeatPart ~= h.seat then
        self:release("seat_lost")
        return false
    end

    local recovered = false
    for _, s in ipairs(h._disabledScripts or {}) do
        if s and s.Parent and not s.Disabled then
            s.Disabled = true
            recovered = true
        end
    end

    if h.origEngineSound and h.origEngineSound.Parent and h.origEngineSound.Volume > 0 then
        h.origEngineSound.Volume = 0
        recovered = true
    end

    if _G.VX and _G.VX.bus then
        _G.VX.bus:emit("authority.verified", { recovered = recovered })
    end
    return true
end

function Module:getHandle()
    return self._handle
end

function Module:getRoot()
    return self._handle and self._handle.root or nil
end

function Module:isActive()
    return self._active == true
end

function Module:Construct()
    self._active = false
    self._handle = nil
    self._lastVerify = 0
    self._verifyConn = nil
end

function Module:Init(deps)
    self.core = deps.Core
end

function Module:Start()
    _G.VX.Authority = self
    self._verifyConn = RunService.Heartbeat:Connect(function()
        if self._active and (os.clock() - self._lastVerify >= REVERIFY_INTERVAL) then
            self._lastVerify = os.clock()
            self:verify()
        end
    end)
end

function Module:Stop()
    if self._verifyConn then
        self._verifyConn:Disconnect()
        self._verifyConn = nil
    end
    self:release("module_stop")
    _G.VX.Authority = nil
end

function Module:heartbeat()
    if not self._active then return true end
    return self._handle ~= nil and self._handle.seat ~= nil and self._handle.seat.Parent ~= nil
end

return Module
