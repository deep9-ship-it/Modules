-- ==================== LOADER ====================
local function fetchSource(url)
    local ok, src = pcall(function() return game:HttpGet(url, true) end)
    if not ok or not src or #src < 10 then
        return nil, "HttpGet failed: " .. tostring(src)
    end
    return src
end

local function compileModule(name, url)
    local src, err = fetchSource(url)
    if not src then return nil, err end
    local chunk, cerr = loadstring(src, "VX_" .. name)
    if not chunk then return nil, "loadstring: " .. tostring(cerr) end
    local ok, result = pcall(chunk)
    if not ok then return nil, "runtime: " .. tostring(result) end
    if type(result) ~= "table" or not result._name then
        return nil, "module did not return a valid instance"
    end
    return result
end

local function loadAllModules()
    local loaded = {}
    for name, url in pairs(MODULE_URLS) do
        local module, err = compileModule(name, url)
        if module then
            VX.Modules[name] = module
            loaded[name] = module
            module:setState("loaded")
            print("[VX] Loaded: " .. name)
        else
            warn("[VX] Failed: " .. name .. " — " .. tostring(err))
        end
    end
    return loaded
end

local function topologicalSort(modules)
    local indegree, adj = {}, {}
    for name in pairs(modules) do
        indegree[name] = 0
        adj[name] = {}
    end
    for name, mod in pairs(modules) do
        for _, dep in ipairs(mod:getDeps()) do
            if modules[dep] then
                indegree[name] = indegree[name] + 1
                table.insert(adj[dep], name)
            else
                warn("[VX] " .. name .. " depends on missing: " .. dep)
            end
        end
    end
    local queue = {}
    for name, deg in pairs(indegree) do
        if deg == 0 then table.insert(queue, name) end
    end
    local sorted = {}
    while #queue > 0 do
        local n = table.remove(queue, 1)
        table.insert(sorted, n)
        for _, neighbor in ipairs(adj[n]) do
            indegree[neighbor] = indegree[neighbor] - 1
            if indegree[neighbor] == 0 then table.insert(queue, neighbor) end
        end
    end
    return sorted
end

local function runLifecycle(sorted, modules)
    -- Construct
    for _, name in ipairs(sorted) do
        local mod = modules[name]
        if mod.Construct then
            local ok, err = pcall(mod.Construct, mod)
            if ok then mod:setState("constructed")
            else mod:setState("failed"); warn("[VX] " .. name .. ".Construct: " .. tostring(err)) end
        else mod:setState("constructed") end
    end
    -- Init
    for _, name in ipairs(sorted) do
        local mod = modules[name]
        if mod:getState() == "constructed" then
            local deps, ok = {}, true
            for _, dep in ipairs(mod:getDeps()) do
                local d = modules[dep]
                if not d or d:getState() == "failed" or d:getState() == "skipped" then
                    ok = false; break
                end
                deps[dep] = d
            end
            if ok then
                if mod.Init then
                    local iok, err = pcall(mod.Init, mod, deps)
                    if iok then mod:setState("inited")
                    else mod:setState("failed"); warn("[VX] " .. name .. ".Init: " .. tostring(err)) end
                else mod:setState("inited") end
            else mod:setState("skipped"); warn("[VX] " .. name .. " skipped (missing deps)") end
        end
    end
    -- Start
    for _, name in ipairs(sorted) do
        local mod = modules[name]
        if mod:getState() == "inited" then
            if mod.Start then
                local ok, err = pcall(mod.Start, mod)
                if ok then mod:setState("started")
                else mod:setState("failed"); warn("[VX] " .. name .. ".Start: " .. tostring(err)) end
            else mod:setState("started") end
        end
    end
end

-- ==================== HOT-RELOAD ====================
function VX.reload(name)
    local existing = VX.Modules[name]
    local url = MODULE_URLS[name]
    if not url then warn("[VX] No URL for " .. name); return false end
    if existing then
        for _, kind in ipairs({"settings","sounds","events","diagnostics","presets","hotkeys","parts"}) do
            Registry:removeAll(kind, name)
        end
        if existing.Stop then pcall(existing.Stop, existing) end
    end
    local module, err = compileModule(name, url)
    if not module then warn("[VX] Reload failed " .. name .. ": " .. tostring(err)); return false end
    if module.Construct then pcall(module.Construct, module) end
    local deps = {}
    for _, dep in ipairs(module:getDeps()) do deps[dep] = VX.Modules[dep] end
    if module.Init then pcall(module.Init, module, deps) end
    if module.Start then pcall(module.Start, module) end
    VX.Modules[name] = module
    module:setState("started")
    print("[VX] Reloaded: " .. name)
    return true
end

function VX.reloadAll()
    for name in pairs(MODULE_URLS) do VX.reload(name) end
end

-- ==================== DIAGNOSTICS ====================
VX.diagnostics = { _reg = {} }

function VX.diagnostics.register(key, schema, owner)
    VX.diagnostics._reg[key] = { schema = schema, owner = owner }
end

function VX.diagnostics.get(key)
    local r = VX.diagnostics._reg[key]
    if not r then return nil end
    local ok, res = pcall(r.schema.fn)
    return ok and res or nil
end

function VX.diagnostics.getAll()
    local out = {}
    for key, r in pairs(VX.diagnostics._reg) do
        local ok, res = pcall(r.schema.fn)
        out[key] = { value = ok and res or nil, schema = r.schema, owner = r.owner }
    end
    return out
end

