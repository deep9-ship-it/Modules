-- ==================== SIGNAL & JANITOR ====================

local Signal = {}
Signal.__index = Signal

function Signal.new()
    return setmetatable({ _handlers = {}, _nextId = 0 }, Signal)
end

function Signal:Connect(fn)
    self._nextId += 1
    local id = self._nextId
    self._handlers[id] = fn
    local function disconnect()
        self._handlers[id] = nil
    end
    return {
        Disconnect = disconnect,
        disconnect = disconnect,
    }
end

function Signal:DisconnectAll()
    self._handlers = {}
end

function Signal:Fire(...)
    local snap = {}
    for id, fn in pairs(self._handlers) do
        snap[id] = fn
    end
    for id, fn in pairs(snap) do
        if self._handlers[id] then
            local ok, err = pcall(fn, ...)
            if not ok then
                warn("[VX] Signal handler error: " .. tostring(err))
            end
        end
    end
end

local Janitor = {}
Janitor.__index = Janitor

function Janitor.new()
    return setmetatable({ _items = {} }, Janitor)
end

function Janitor:Add(item)
    table.insert(self._items, item)
    return item
end

function Janitor:Cleanup()
    for i = #self._items, 1, -1 do
        local item = self._items[i]
        self._items[i] = nil
        if typeof(item) == "Instance" then
            pcall(function() item:Destroy() end)
        elseif type(item) == "table" and item.Disconnect then
            pcall(function() item:Disconnect() end)
        elseif type(item) == "function" then
            pcall(item)
        end
    end
end

function Janitor:Clear()
    self:Cleanup()
end

