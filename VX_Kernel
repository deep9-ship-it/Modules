-- ==================== FRAMEWORK: SIGNAL ====================
local Signal = {}
Signal.__index = Signal
function Signal.new()
    return setmetatable({ _handlers = {}, _nextId = 0 }, Signal)
end
function Signal:Connect(fn)
    self._nextId = self._nextId + 1
    local id = self._nextId
    self._handlers[id] = fn
    return {
        Disconnect = function() self._handlers[id] = nil end,
    }
end
function Signal:DisconnectAll()
    self._handlers = {}
end
function Signal:Fire(...)
    local snap = {}
    for id, fn in pairs(self._handlers) do snap[id] = fn end
    for id, fn in pairs(snap) do
        if self._handlers[id] then
            local ok, err = pcall(fn, ...)
            if not ok then warn("[VX] Signal handler error: " .. tostring(err)) end
        end
    end
end

-- ==================== FRAMEWORK: JANITOR ====================
local Janitor = {}
Janitor.__index = Janitor
function Janitor.new()
    return setmetatable({ _items = {} }, Janitor)
end
function Janitor:Add(item)
    table.insert(self._items, item)
    return item
end
function Janitor:Cleanup()
    for i = #self._items, 1, -1 do
        local item = self._items[i]
        self._items[i] = nil
        if typeof(item) == "Instance" then
            pcall(function() item:Destroy() end)
        elseif type(item) == "table" and item.Disconnect then
            pcall(function() item:Disconnect() end)
        elseif type(item) == "function" then
            pcall(item)
        end
    end
end
function Janitor:Clear() self:Cleanup() end

-- ==================== FRAMEWORK: MODULE ====================
local Module = {}
Module.__index = Module
function Module.new(spec)
    assert(spec.Name, "Module requires Name")
    return setmetatable({
        _spec     = spec,
        _name     = spec.Name,
        _deps     = spec.Dependencies or {},
        _state    = "loaded",
        _janitor  = Janitor.new(),
        _exports  = {},
        _version  = spec.Version or "1.0.0",
    }, Module)
end
function Module:getName() return self._name end
function Module:getState() return self._state end
function Module:getDeps() return self._deps end
function Module:getVersion() return self._version end
function Module:janitor() return self._janitor end
function Module:setState(s) self._state = s end

-- ==================== REGISTRY ====================
local Registry = {
    _settings    = {},
    _sounds      = {},
    _events      = {},
    _diagnostics = {},
    _presets     = {},
    _hotkeys     = {},
    _parts       = {},
    _owners      = {},
    _onAdded  = Signal.new(),
    _onRemoved = Signal.new(),
}

function Registry:set(kind, key, schema, owner)
    assert(schema, "schema required")
    local bucket = self["_" .. kind]
    if not bucket then error("Unknown registry kind: " .. kind) end
    if bucket[key] and self._owners[kind .. "." .. key] ~= owner then
        error("Registry conflict: " .. kind .. "." .. key)
    end
    bucket[key] = schema
    self._owners[kind .. "." .. key] = owner
    self._onAdded:Fire({ kind = kind, key = key, schema = schema, owner = owner })
end

function Registry:get(kind, key)
    local bucket = self["_" .. kind]
    return bucket and bucket[key]
end

function Registry:getAll(kind)
    return self["_" .. kind] or {}
end

function Registry:remove(kind, key, owner)
    local bucket = self["_" .. kind]
    if not bucket then return end
    if bucket[key] and self._owners[kind .. "." .. key] == owner then
        bucket[key] = nil
        self._owners[kind .. "." .. key] = nil
        self._onRemoved:Fire({ kind = kind, key = key })
    end
end

function Registry:removeAll(kind, owner)
    local bucket = self["_" .. kind]
    if not bucket then return end
    local doomed = {}
    for key in pairs(bucket) do
        if self._owners[kind .. "." .. key] == owner then
            table.insert(doomed, key)
        end
    end
    for _, key in ipairs(doomed) do self:remove(kind, key, owner) end
end

function Registry:dump()
    local counts = {}
    for _, kind in ipairs({"settings","sounds","events","diagnostics","presets","hotkeys","parts"}) do
        local n = 0
        for _ in pairs(self["_" .. kind]) do n = n + 1 end
        counts[kind] = n
    end
    return counts
end

function Registry:onAdded(fn)   return self._onAdded:Connect(fn) end
function Registry:onRemoved(fn) return self._onRemoved:Connect(fn) end

-- ==================== EVENT BUS ====================
local EventBus = {}
EventBus.__index = EventBus
function EventBus.new()
    return setmetatable({ _signals = {} }, EventBus)
end
function EventBus:on(name, fn)
    if not self._signals[name] then self._signals[name] = Signal.new() end
    return self._signals[name]:Connect(fn)
end
function EventBus:emit(name, payload)
    if self._signals[name] then self._signals[name]:Fire(payload) end
end
function EventBus:clear()
    for _, sig in pairs(self._signals) do sig:DisconnectAll() end
    self._signals = {}
end
function EventBus:list()
    local names = {}
    for name in pairs(self._signals) do table.insert(names, name) end
    return names
end

