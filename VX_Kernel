-- ==================== WATCHDOG ====================
local watchdogActive = true
task.spawn(function()
    while watchdogActive do
        task.wait(2)
        for name, mod in pairs(VX.Modules) do
            if mod:getState() == "started" and mod.heartbeat then
                local ok, res = pcall(mod.heartbeat, mod)
                if not ok or res == false then
                    warn("[VX] Watchdog: " .. name .. " unhealthy")
                end
            end
        end
    end
end)

-- ==================== SHUTDOWN ====================
VX.shutdown = function()
    watchdogActive = false
    for i = #sorted, 1, -1 do
        local mod = loaded[sorted[i]]
        if mod and mod.Stop then pcall(mod.Stop, mod) end
    end
    VX.bus:clear()
    print("[VX] Shutdown complete")
end

-- ==================== HOTKEYS ====================
local UIS = game:GetService("UserInputService")
local panicStart = 0

UIS.InputBegan:Connect(function(input, gp)
    if gp then return end
    local kc = input.KeyCode
    if kc == Enum.KeyCode.V and VX.Modules.UI then
        pcall(function() VX.Modules.UI:toggleVideoMode() end)
    elseif kc == Enum.KeyCode.C and VX.Modules.Input then
        pcall(function() VX.Modules.Input:toggleClutch() end)
    elseif kc == Enum.KeyCode.F1 then
        for _, name in ipairs(sorted) do
            print(string.format("  %-16s %s", name, loaded[name]:getState()))
        end
    elseif kc == Enum.KeyCode.F2 then
        if _G.VX.setSetting and _G.VX.settings then
            local cur = _G.VX.settings.physics.telemetryHud
            _G.VX.setSetting("physics.telemetryHud", not cur)
        end
    elseif kc == Enum.KeyCode.F3 and VX.Modules.UI then
        pcall(function() VX.Modules.UI:toggleDiagnostics() end)
    elseif kc == Enum.KeyCode.Backspace then
        panicStart = tick()
    end
end)

UIS.InputEnded:Connect(function(input)
    if input.KeyCode == Enum.KeyCode.Backspace then
        if panicStart > 0 and tick() - panicStart >= 2 then
            VX.shutdown()
        end
        panicStart = 0
    end
end)

print("[VX] Hotkeys: V=Video | C=Clutch | F1=Status | F2=Telemetry | F3=Diagnostics | Hold Shift+Backspace=Panic")

return VX
