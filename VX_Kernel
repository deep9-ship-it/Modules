-- ==================== PUBLIC API ====================

function VX.getModule(name)
    return VX.Modules[name]
end

function VX.getStatus()
    local list = {}
    for _, name in ipairs(_bootOrder) do
        local mod = VX.Modules[name]
        if mod then
            table.insert(list, {
                name = mod:getName(),
                version = mod:getVersion(),
                state = mod:getState(),
                failCount = _failCounts[name] or 0,
            })
        end
    end
    return { version = VERSION, booted = VX._booted, modules = list }
end

function VX.resetAll()
    if type(VX.resetSetting) ~= "function" then
        return false, "Core not ready"
    end
    local count = 0
    for key, entry in pairs(registry:list("settings")) do
        local ok, resetOk = pcall(VX.resetSetting, key)
        if (not ok or not resetOk) and entry.schema and entry.schema.default ~= nil and type(VX.setSetting) == "function" then
            pcall(VX.setSetting, key, _deepCopy(entry.schema.default))
            count += 1
        elseif ok and resetOk then
            count += 1
        end
    end
    return true, count
end

function VX.restartModule(name)
    local mod = VX.Modules[name]
    if not mod then
        warn("[VX] restartModule: not found — " .. tostring(name))
        return false
    end
    for _, kind in ipairs({ "settings", "sounds", "events", "diagnostics", "presets", "hotkeys", "parts" }) do
        registry:removeAll(kind, name)
    end
    diagnostics.unregisterByOwner(name)
    pcall(mod.Stop, mod)
    if mod._janitor then pcall(function() mod._janitor:Cleanup() end) end
    mod:setState("stopped")

    local ok = _runSingleModuleLifecycle(name, mod)
    if ok then
        print("[VX] Restarted: " .. name)
    end
    return ok
end

function VX.reload(name)
    if not name then
        local ok, src = _httpGet(KERNEL_URL, true)
        if not ok then warn("[VX] Kernel reload failed: " .. tostring(src)); return false end
        local chunk, err = loadstring(src, "@VX_Kernel")
        if not chunk then warn("[VX] Kernel compile error: " .. tostring(err)); return false end
        local rok, rerr = pcall(chunk)
        if not rok then warn("[VX] Kernel runtime error: " .. tostring(rerr)); return false end
        return true
    end

    local existing = VX.Modules[name]
    local url = MODULE_URLS[name]
    if not url then warn("[VX] No URL for " .. tostring(name)); return false end

    if existing then
        for _, kind in ipairs({ "settings", "sounds", "events", "diagnostics", "presets", "hotkeys", "parts" }) do
            registry:removeAll(kind, name)
        end
        diagnostics.unregisterByOwner(name)
        pcall(existing.Stop, existing)
        if existing._janitor then pcall(function() existing._janitor:Cleanup() end) end
    end

    local mod, err = _compileModule(name, url, true)
    if not mod then
        warn("[VX] Reload failed " .. name .. ": " .. tostring(err))
        return false
    end

    VX.Modules[name] = mod
    local ok = _runSingleModuleLifecycle(name, mod)
    if ok then
        print("[VX] Reloaded: " .. name)
    end
    return ok
end

function VX.reloadAll()
    for _, name in ipairs(_bootOrder) do
        VX.reload(name)
    end
end

function VX.diag()
    local all = diagnostics.getAll()
    local keys = {}
    for k in pairs(all) do
        table.insert(keys, k)
    end
    table.sort(keys)

    print("========== VX DIAGNOSTICS ==========")
    for _, k in ipairs(keys) do
        local d = all[k]
        local valStr
        if type(d.value) == "number" then
            valStr = (d.value % 1 == 0) and string.format("%d", d.value) or string.format("%.2f", d.value)
        else
            valStr = tostring(d.value)
        end
        local unitStr = d.unit and (" " .. tostring(d.unit)) or ""
        local statusStr = d.status and (" [" .. tostring(d.status) .. "]") or ""
        print(string.format("  %-26s = %s%s%s (%s)", k, valStr, unitStr, statusStr, d.owner))
    end
    print("====================================")
end

