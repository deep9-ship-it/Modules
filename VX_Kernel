function VX.shutdown()
    VX._booted = false
    if _noticeGui then
        pcall(function() _noticeGui:Destroy() end)
        _noticeGui = nil
    end
    if _watchdogThread then
        pcall(task.cancel, _watchdogThread)
        _watchdogThread = nil
    end
    for _, c in ipairs(_hotkeyConns) do
        pcall(function() c:Disconnect() end)
    end
    _hotkeyConns = {}

    for i = #_bootOrder, 1, -1 do
        local name = _bootOrder[i]
        local mod = VX.Modules[name]
        if mod then
            pcall(mod.Stop, mod)
            if mod._janitor then pcall(function() mod._janitor:Cleanup() end) end
            mod:setState("stopped")
        end
        VX[name] = nil
    end
    VX.UI = nil
    VX.Panel = nil
    bus:clear()
    _diagEntries = {}
    _regStore = {}
    VX.Modules = {}
    _bootOrder = {}
    _failCounts = {}
    print("[VX] Shutdown complete")
end

