_watchdogThread = task.spawn(function()
    while VX._booted do
        task.wait(WATCHDOG_INTERVAL)
        if not VX._booted then break end
        for _, name in ipairs(_bootOrder) do
            local mod = VX.Modules[name]
            if mod and mod:getState() == "started" and mod.heartbeat then
                local ok, alive = pcall(mod.heartbeat, mod)
                if ok and alive ~= false then
                    _failCounts[name] = 0
                else
                    _failCounts[name] = (_failCounts[name] or 0) + 1
                    if _failCounts[name] >= MAX_HEARTBEAT_FAILS then
                        warn("[VX] Watchdog restarting unhealthy module: " .. name)
                        _failCounts[name] = 0
                        VX.restartModule(name)
                    end
                end
            end
        end
    end
end)

