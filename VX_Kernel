-- ==================== EVENT BUS ====================

local bus = { _listeners = {} }

function bus:on(event, fn)
    assert(type(event) == "string" and event ~= "", "bus:on requires event string")
    assert(type(fn) == "function", "bus:on requires function")

    local sig = self._listeners[event]
    if not sig then
        sig = Signal.new()
        self._listeners[event] = sig
    end
    return sig:Connect(fn)
end

function bus:once(event, fn)
    local conn
    conn = self:on(event, function(data)
        if conn then conn:Disconnect() end
        fn(data)
    end)
    return conn
end

function bus:emit(event, payload)
    local sig = self._listeners[event]
    if sig then
        sig:Fire(payload)
    end
end

function bus:clear(event)
    if event then
        if self._listeners[event] then
            self._listeners[event]:DisconnectAll()
            self._listeners[event] = nil
        end
    else
        for _, sig in pairs(self._listeners) do
            sig:DisconnectAll()
        end
        self._listeners = {}
    end
end

function bus:list()
    local names = {}
    for name in pairs(self._listeners) do
        table.insert(names, name)
    end
    return names
end

VX.bus = bus

-- ==================== REGISTRY ====================

local _regStore = {}
local _onAdded = Signal.new()
local _onRemoved = Signal.new()

local registry = {}

function registry:set(category, key, schema, owner)
    assert(type(category) == "string" and category ~= "", "registry:set requires category")
    assert(type(key) == "string" and key ~= "", "registry:set requires key")
    assert(type(schema) == "table", "registry:set requires schema")

    _regStore[category] = _regStore[category] or {}
    local existing = _regStore[category][key]

    if existing then
        local merged = {}
        for k, v in pairs(existing.schema) do merged[k] = v end
        for k, v in pairs(schema) do merged[k] = v end
        existing.schema = merged
        existing.owner = owner or existing.owner
        existing.updatedAt = os.clock()
        _onAdded:Fire({ kind = category, key = key, schema = merged, owner = existing.owner })
        return existing
    end

    local entry = {
        key = key,
        schema = schema,
        owner = owner or "unknown",
        registeredAt = os.clock(),
    }
    _regStore[category][key] = entry
    _onAdded:Fire({ kind = category, key = key, schema = schema, owner = entry.owner })
    return entry
end

function registry:get(category, key)
    local cat = _regStore[category]
    return cat and cat[key] or nil
end

function registry:list(category)
    return _regStore[category] or {}
end

function registry:getAll(category)
    return _regStore[category] or {}
end

function registry:remove(category, key, owner)
    local cat = _regStore[category]
    if not cat then return end
    if cat[key] and (not owner or cat[key].owner == owner) then
        cat[key] = nil
        _onRemoved:Fire({ kind = category, key = key })
    end
end

function registry:removeAll(category, owner)
    local cat = _regStore[category]
    if not cat then return end
    local doomed = {}
    for key, entry in pairs(cat) do
        if entry.owner == owner then
            table.insert(doomed, key)
        end
    end
    for _, key in ipairs(doomed) do
        self:remove(category, key, owner)
    end
end

function registry:dump()
    local counts = {}
    for _, cat in ipairs({ "settings", "sounds", "events", "diagnostics", "presets", "hotkeys", "parts" }) do
        local n = 0
        for _ in pairs(_regStore[cat] or {}) do n += 1 end
        counts[cat] = n
    end
    return counts
end

function registry:onAdded(fn) return _onAdded:Connect(fn) end
function registry:onRemoved(fn) return _onRemoved:Connect(fn) end

VX.registry = registry

-- ==================== DIAGNOSTICS ====================

local _diagEntries = {}

local diagnostics = {}

function diagnostics.register(name, schema, owner)
    assert(type(name) == "string" and name ~= "", "diagnostics.register requires name")
    assert(type(schema) == "table" and type(schema.fn) == "function", "diagnostics.register requires schema.fn")
    _diagEntries[name] = {
        name = name,
        schema = schema,
        owner = owner or "unknown",
    }
end

function diagnostics.unregister(name)
    _diagEntries[name] = nil
end

function diagnostics.unregisterByOwner(owner)
    for name, entry in pairs(_diagEntries) do
        if entry.owner == owner then
            _diagEntries[name] = nil
        end
    end
end

function diagnostics.get(name)
    local entry = _diagEntries[name]
    if not entry then return nil end
    local ok, res = pcall(entry.schema.fn)
    return ok and res or nil
end

function diagnostics.getAll()
    local out = {}
    for name, entry in pairs(_diagEntries) do
        local ok, result = pcall(entry.schema.fn)
        local val = result
        local unit = entry.schema.unit
        local status = nil

        if ok and type(result) == "table" and result.value ~= nil then
            val = result.value
            unit = unit or result.unit
            status = result.status
        elseif not ok then
            val = "ERR: " .. tostring(result)
            status = "error"
        end

        local schemaCopy = {}
        for k, v in pairs(entry.schema) do
            schemaCopy[k] = v
        end
        if unit and not schemaCopy.unit then
            schemaCopy.unit = unit
        end

        out[name] = {
            value = val,
            unit = unit,
            status = status,
            raw = ok and result or nil,
            schema = schemaCopy,
            owner = entry.owner,
            ok = ok,
        }
    end
    return out
end

VX.diagnostics = diagnostics

-- ==================== LOADER & TOPOLOGICAL SORT ====================

local function _httpGet(url, bustCache)
    local target = url
    if bustCache then
        local sep = string.find(url, "?", 1, true) and "&" or "?"
        target = url .. sep .. "t=" .. tostring(os.time())
    end

    local lastErr
    for attempt = 1, HTTP_RETRIES + 1 do
        local tryUrl = (attempt == 1) and target or url
        local ok, res = pcall(game.HttpGet, game, tryUrl, true)
        if ok and type(res) == "string" and #res > 10 then
            return true, res
        end
        lastErr = res
        if attempt <= HTTP_RETRIES then
            task.wait(0.2 * attempt)
        end
    end
    return false, lastErr
end

local function _compileModule(name, url, bustCache)
    local ok, src = _httpGet(url, bustCache)
    if not ok then
        return nil, "HttpGet failed: " .. tostring(src)
    end
    local chunk, cerr = loadstring(src, "@VX_" .. name)
    if not chunk then
        return nil, "loadstring: " .. tostring(cerr)
    end
    local rok, mod = pcall(chunk)
    if not rok then
        return nil, "runtime: " .. tostring(mod)
    end
    if type(mod) ~= "table" or not (mod.Name or mod._name) then
        return nil, "module did not return a valid VX Module instance"
    end
    return mod
end

local function _topoSort(modules, orderList)
    local eligible = {}
    local orderIdx = {}
    for idx, name in ipairs(orderList) do
        orderIdx[name] = idx
        if modules[name] then
            eligible[name] = modules[name]
        end
    end

    local changed = true
    while changed do
        changed = false
        for _, name in ipairs(orderList) do
            local mod = eligible[name]
            if mod then
                for _, dep in ipairs(mod:getDeps()) do
                    if not eligible[dep] then
                        warn("[VX] Skipping " .. name .. " — missing dependency: " .. dep)
                        eligible[name] = nil
                        changed = true
                        break
                    end
                end
            end
        end
    end

    local indegree, adj = {}, {}
    for name in pairs(eligible) do
        indegree[name] = 0
        adj[name] = {}
    end
    for name, mod in pairs(eligible) do
        for _, dep in ipairs(mod:getDeps()) do
            indegree[name] += 1
            table.insert(adj[dep], name)
        end
    end

    local queue = {}
    for name, deg in pairs(indegree) do
        if deg == 0 then table.insert(queue, name) end
    end
    table.sort(queue, function(a, b) return (orderIdx[a] or 999) < (orderIdx[b] or 999) end)

    local sorted = {}
    while #queue > 0 do
        local n = table.remove(queue, 1)
        table.insert(sorted, n)
        for _, child in ipairs(adj[n]) do
            indegree[child] -= 1
            if indegree[child] == 0 then
                table.insert(queue, child)
                table.sort(queue, function(a, b) return (orderIdx[a] or 999) < (orderIdx[b] or 999) end)
            end
        end
    end
    return sorted
end

local function _runSingleModuleLifecycle(name, mod)
    local cok, cerr = pcall(mod.Construct, mod)
    if not cok then
        mod:setState("failed")
        warn("[VX] " .. name .. ".Construct: " .. tostring(cerr))
        return false
    end
    mod:setState("constructed")

    local deps = {}
    for _, dep in ipairs(mod:getDeps()) do
        local d = VX.Modules[dep]
        if not d or d:getState() == "failed" or d:getState() == "skipped" then
            mod:setState("skipped")
            warn("[VX] " .. name .. " skipped (unhealthy dep: " .. dep .. ")")
            return false
        end
        deps[dep] = d
    end

    local iok, ierr = pcall(mod.Init, mod, deps)
    if not iok then
        mod:setState("failed")
        warn("[VX] " .. name .. ".Init: " .. tostring(ierr))
        return false
    end
    mod:setState("inited")

    local sok, serr = pcall(mod.Start, mod)
    if not sok then
        mod:setState("failed")
        warn("[VX] " .. name .. ".Start: " .. tostring(serr))
        return false
    end
    mod:setState("started")
    _failCounts[name] = 0
    return true
end

local function _runLifecycle(sorted, modules)
    for _, name in ipairs(sorted) do
        local mod = modules[name]
        local ok, err = pcall(mod.Construct, mod)
        if ok then
            mod:setState("constructed")
        else
            mod:setState("failed")
            warn("[VX] " .. name .. ".Construct: " .. tostring(err))
        end
    end

    for _, name in ipairs(sorted) do
        local mod = modules[name]
        if mod:getState() == "constructed" then
            local deps, ok = {}, true
            for _, dep in ipairs(mod:getDeps()) do
                local d = modules[dep]
                if not d or d:getState() == "failed" or d:getState() == "skipped" then
                    ok = false
                    break
                end
                deps[dep] = d
            end
            if ok then
                local iok, err = pcall(mod.Init, mod, deps)
                if iok then
                    mod:setState("inited")
                else
                    mod:setState("failed")
                    warn("[VX] " .. name .. ".Init: " .. tostring(err))
                end
            else
                mod:setState("skipped")
                warn("[VX] " .. name .. " skipped (missing deps)")
            end
        end
    end

    for _, name in ipairs(sorted) do
        local mod = modules[name]
        if mod:getState() == "inited" then
            local sok, err = pcall(mod.Start, mod)
            if sok then
                mod:setState("started")
            else
                mod:setState("failed")
                warn("[VX] " .. name .. ".Start: " .. tostring(err))
            end
        end
    end
end

