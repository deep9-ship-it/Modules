local panicStart = 0

table.insert(_hotkeyConns, UserInputService.InputBegan:Connect(function(input, gp)
    if gp then return end
    local kc = input.KeyCode
    if kc == Enum.KeyCode.V and VX.Modules.UI and VX.Modules.UI.toggleVideoMode then
        pcall(function() VX.Modules.UI:toggleVideoMode() end)
    elseif kc == Enum.KeyCode.C and VX.Modules.Input and VX.Modules.Input.toggleClutch then
        pcall(function() VX.Modules.Input:toggleClutch() end)
    elseif kc == Enum.KeyCode.F1 then
        for _, name in ipairs(_bootOrder) do
            local m = VX.Modules[name]
            print(string.format("  %-16s %s", name, m and m:getState() or "missing"))
        end
    elseif kc == Enum.KeyCode.Backspace then
        panicStart = tick()
    end
end))

table.insert(_hotkeyConns, UserInputService.InputEnded:Connect(function(input)
    if input.KeyCode == Enum.KeyCode.Backspace then
        if UserInputService:GetFocusedTextBox() then
            panicStart = 0
            return
        end
        if panicStart > 0 and (tick() - panicStart) >= 2 then
            VX.shutdown()
        end
        panicStart = 0
    end
end))

