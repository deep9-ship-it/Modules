--[[
    VX_Powertrain v3.2.0
    Engine-first RPM model:
      - Crankshaft simulation: RPM driven by throttle × torque curve × boost
      - Coupled to wheel speed via clutch slip allowance (wheelRPM → RPM floor)
      - Launch flare: slip lets RPM rise from idle at 0 MPH
      - Gear ratios drive shift thresholds naturally
      - No speed-derived RPM (prevents the 12mph deadlock)
]]

local VX = _G.VX
if not VX or not VX.Framework then error("VX_Powertrain requires VX_Kernel") end

local Module = VX.Framework.Module.new({
    Name = "Powertrain",
    Dependencies = { "Core", "Profiles", "Input", "VehicleState" },
    Version = "3.2.0",
})

local TICK_NORMAL = 60
local TICK_LOW    = 30
local STUDS_TO_MPH = 0.626
local MAX_GEAR = 7

-- ==================== STATE ====================
function Module:Construct()
    self.rpm = 900
    self.gear = 1
    self.shiftCooldown = 0
    self.shiftState = "closed"
    self.smoothedThrottle = 0
    self.targetThrottle = 0
    self.revLimiterActive = false
    self.revLimiterPhase = 0

    -- Smoothed top speed — slews when user changes setting mid-drive
    self.effectiveTopSpeed = 100

    self.launch = {
        state = "idle", startTime = 0, releaseTime = 0,
        rpmTarget = 6500, rpm = 900, cooldownEnd = 0,
        twostepActive = false, twostepStartTime = 0, lastTwostepBackfire = 0,
    }
    self.pendingUpshift = { active = false, targetGear = nil, shiftTime = 0 }

    self._loopThread = nil
    self._running = false
    self._shiftEvents = 0
    self._lastShiftTime = 0
    self._lastShiftUpTime = 0
    self._lastShiftDownTime = 0
    self._coldStartEndTime = 0
    self._bogUntil = 0
    self._bogMagnitude = 0
    self._lastSmoothed = 0
    self._idleHuntPhase = 0
    self._loadFactor = 1.0
end

function Module:Init(deps)
    self.core = deps.Core
    self.profiles = deps.Profiles
    self.input = deps.Input
    self.state = deps.VehicleState
end

function Module:Start()
    _G.VX.Powertrain = self
    _G.VX.bus:on("vehicle.stateChanged", function(evt)
        if evt.to == "Ready" or evt.to == "Idle" then self:_start()
        elseif evt.to == "Exiting" or evt.to == "Disabled" then self:_stop() end
    end)
    self:_registerDiagnostics()
end

function Module:Stop()
    self:_stop()
    if _G.VX.Powertrain == self then _G.VX.Powertrain = nil end
end

function Module:heartbeat() return true end

function Module:_registerDiagnostics()
    local D = _G.VX.diagnostics
    pcall(function()
        D.register("powertrain.rpm", {
            fn = function() return { value = math.floor(self.rpm), unit = "rpm", status = "normal" } end,
            category = "Powertrain",
        }, "Powertrain")
        D.register("powertrain.gear", {
            fn = function() return { value = self.gear, unit = "", status = "normal" } end,
            category = "Powertrain",
        }, "Powertrain")
        D.register("powertrain.shift", {
            fn = function()
                return { value = self.shiftState, unit = "", status = self.shiftState == "open" and "warning" or "normal" }
            end,
            category = "Powertrain",
        }, "Powertrain")
        D.register("powertrain.topSpeed", {
            fn = function() return { value = string.format("%.1f", self.effectiveTopSpeed), unit = "mph", status = "normal" } end,
            category = "Powertrain",
        }, "Powertrain")
    end)
end

-- ==================== LIFECYCLE ====================
function Module:_start()
    if self._running then return end
    self._running = true
    local prof = self.profiles:current()
    self.rpm = prof.idleRPM
    self.gear = 1
    self.shiftState = "closed"
    self.shiftCooldown = 0
    self.revLimiterActive = false
    self.launch.state = "idle"
    self.launch.twostepActive = false
    self.pendingUpshift.active = false
    self.effectiveTopSpeed = self.core.settings.topSpeed or 100

    self._loopThread = task.spawn(function()
        local perf = self.core.settings._effectivePerformance
        local tickRate = (perf == "low") and TICK_LOW or TICK_NORMAL
        local interval = 1 / tickRate
        local lastTick = os.clock()
        while self._running do
            local now = os.clock()
            local dt = now - lastTick
            lastTick = now
            if dt <= 0 or dt > 0.1 then dt = interval end
            pcall(function() self:_update(dt) end)
            local toSleep = interval - (os.clock() - now)
            if toSleep > 0 then task.wait(toSleep) end
        end
    end)
    print("[VX] Powertrain started — topSpeed=" .. self.effectiveTopSpeed)
end

function Module:_stop()
    if not self._running then return end
    self._running = false
    if self._loopThread then pcall(function() task.cancel(self._loopThread) end); self._loopThread = nil end
    self.launch.state = "idle"
    self.launch.twostepActive = false
    print("[VX] Powertrain stopped")
end

-- ==================== UPDATE ====================
function Module:_update(dt)
    local prof = self.profiles:current()
    self:_updateLaunch(dt)
    self:_updateThrottleSmoother(dt)
    self:_updateTopSpeedSlew(dt)
    self:_updateRPM(dt, prof)
    if self.shiftCooldown > 0 then self.shiftCooldown = self.shiftCooldown - dt end
    self:_updateGear(dt, prof)
    if self.shiftState == "open" and self.shiftCooldown <= 0 then self.shiftState = "closed" end
    self:_updateRevLimiter(dt, prof)
    self:_updateColdStart(dt, prof)
    self:_updateIdleHunt(dt, prof)
    self._loadFactor = self:_computeLoadFactor(prof)
end

function Module:_updateTopSpeedSlew(dt)
    local targetTop = self.core.settings.topSpeed or 100
    local speed = self:_getSpeed()
    if speed < 3 then
        self.effectiveTopSpeed = targetTop
    else
        local slew = dt * 1.5
        self.effectiveTopSpeed = self.effectiveTopSpeed + (targetTop - self.effectiveTopSpeed) * math.min(slew, 1)
    end
end

-- ==================== THROTTLE SMOOTHER ====================
function Module:_updateThrottleSmoother(dt)
    local settings = self.core.settings
    local tiltLevel = settings.physicsTiltLevel
    local smoothingOn = (tiltLevel == "Medium" or tiltLevel == "High" or tiltLevel == "Extreme")

    if self.launch.twostepActive or self.launch.state == "holding" then
        self.smoothedThrottle = 0; self.targetThrottle = 0; return
    end
    if self.launch.state == "releasing" then
        self.smoothedThrottle = 1.0; self.targetThrottle = 1.0; return
    end
    if self.shiftState == "open" and settings.realisticShifting then
        self.smoothedThrottle = 0; self.targetThrottle = 0; return
    end

    local raw = self.input:getRawThrottle()
    self.targetThrottle = raw
    if not smoothingOn then
        self.smoothedThrottle = raw
        return
    end

    local cur = self.smoothedThrottle
    local target = raw
    local rate
    local brakeSpeed = settings.brakeSpeed or 5.0

    if target < -0.05 then rate = brakeSpeed
    elseif cur < -0.05 and target > -0.05 then rate = brakeSpeed
    elseif target > cur + 0.05 then
        if settings.throttleUltra then rate = 100
        elseif self.rpm >= self.core.config.launch.rpmTarget * 0.6 then rate = 2.0
        elseif cur < 0.05 then rate = 0.4
        else rate = 3.0 end
    elseif target < cur - 0.05 then rate = 0.4
    else rate = 5.0 end

    local new = cur + (target - cur) * math.min(rate * dt, 1)
    self.smoothedThrottle = new

    if settings.physics.engineBog then
        local delta = new - self._lastSmoothed
        if delta > 0.5 and self.rpm < 2500 then
            self._bogUntil = os.clock() + 0.12
            self._bogMagnitude = delta * 200
        end
        self._lastSmoothed = new
    end
end

-- ==================== WHEEL-EQUIV RPM ====================
function Module:_getWheelRPM(prof, gear)
    local speed = self:_getSpeed()
    local speedRatio = math.clamp(speed / math.max(self.effectiveTopSpeed, 1), 0, 1.5)
    local gearRatio = prof.gearRatios[gear] or 1
    local maxRatio  = prof.gearRatios[MAX_GEAR] or 0.65
    local rpm = prof.idleRPM + speedRatio * (prof.redlineRPM - prof.idleRPM) * (gearRatio / maxRatio)
    return math.min(rpm, prof.redlineRPM)
end

-- ==================== RPM UPDATE (engine-first) ====================
function Module:_updateRPM(dt, prof)
    local settings = self.core.settings

    if self.launch.twostepActive then return end

    if self.launch.state == "holding" then
        local target = self.launch.rpmTarget
        local diff = target - self.rpm
        self.rpm = self.rpm + diff * self.core.config.launch.rpmBuildRate * dt
        self.rpm = math.min(self.rpm, prof.redlineRPM)
        return
    end

    if self.gear == -1 then
        self.rpm = prof.idleRPM + math.abs(self.smoothedThrottle) * (prof.maxRPM - prof.idleRPM) * 0.4
        return
    end

    -- Free rev target (throttle × torque-driven)
    local freeRPM = prof.idleRPM + self.smoothedThrottle * (prof.maxRPM - prof.idleRPM)

    -- Wheel-coupled RPM floor (clutch lock)
    local wheelRPM = self:_getWheelRPM(prof, self.gear)

    -- Engine can be faster than wheels (slip under throttle)
    -- Engine CANNOT be slower than wheels (clutch locks)
    local target = math.max(freeRPM, wheelRPM)
    target = math.clamp(target, prof.idleRPM, prof.redlineRPM + 100)

    -- Smooth approach with gear-specific rise rate
    local rate = self:_rpmRiseRate(prof)
    if target < self.rpm then
        rate = self.core.config.rpmFallRate
    end
    self.rpm = self.rpm + (target - self.rpm) * math.min(rate * 10 * dt, 1)

    -- Bog on throttle stomp
    if os.clock() < self._bogUntil then
        local remain = (self._bogUntil - os.clock()) / 0.12
        self.rpm = self.rpm - self._bogMagnitude * remain * dt * 10
    end

    -- Cold start redline cap
    local effectiveRedline = prof.redlineRPM
    if settings.physics.coldStart and os.clock() < self._coldStartEndTime then
        local remain = (self._coldStartEndTime - os.clock()) / settings.physics.coldStartDuration
        effectiveRedline = prof.redlineRPM - self.core.config.coldStartRedlineDrop * remain
    end

    self.rpm = math.max(prof.idleRPM * 0.9, math.min(effectiveRedline + 100, self.rpm))
end

function Module:_rpmRiseRate(prof)
    local base = self.core.config.rpmRiseRates[self.gear] or 0.1
    return base * (prof.rpmRiseMultiplier or 1.0)
end

-- ==================== GEAR UPDATE (RPM-based) ====================
function Module:_updateGear(dt, prof)
    if self.shiftCooldown > 0 then return end
    if self.launch.state == "holding" or self.launch.twostepActive then return end

    local speed = self:_getSpeed()

    -- Reverse entry: brake + stopped
    if self.smoothedThrottle < -0.1 and speed < 5 and self.gear ~= -1 then
        self:_doShift(-1, "down", false)
        return
    end
    -- Reverse exit: gas while in reverse
    if self.gear == -1 and self.smoothedThrottle > 0.1 then
        self:_doShift(1, "up", false)
        return
    end
    if self.gear == -1 then return end

    -- Pending upshift delay (shiftDelay feature)
    if self.pendingUpshift.active then
        if os.clock() >= self.pendingUpshift.shiftTime then
            local targetGear = self.pendingUpshift.targetGear
            self.pendingUpshift.active = false
            if self.rpm >= prof.redlineRPM * 0.9 and self.gear < MAX_GEAR then
                self:_doShift(targetGear, "up", false)
            end
        end
        return
    end

    -- Upshift: at redline
    if self.gear < MAX_GEAR and self.rpm >= prof.redlineRPM * 0.98 then
        local newGear = self.gear + 1
        if self.core.settings.shiftDelay and newGear >= 2 and newGear <= 4 then
            self.pendingUpshift.active = true
            self.pendingUpshift.targetGear = newGear
            self.pendingUpshift.shiftTime = os.clock() + (0.4 + math.random() * 0.9)
        else
            self:_doShift(newGear, "up", false)
        end
        return
    end

    -- Downshift: RPM-based
    if self.gear > 1 then
        local shouldDown = false
        local emergency = false

        if self.rpm < self.core.config.stallThreshold then
            shouldDown = true
            emergency = true
        elseif self.rpm < self.core.config.lowRpmDownshift then
            local currentRatio = prof.gearRatios[self.gear] or 1
            local lowerRatio   = prof.gearRatios[self.gear - 1] or 1
            local predictedRPM = self.rpm * (lowerRatio / currentRatio)
            if predictedRPM < prof.maxRPM - self.core.config.overRevBuffer then
                shouldDown = true
            end
        end

        if shouldDown then
            self:_doShift(self.gear - 1, "down", emergency)
        end
    end
end

function Module:_doShift(newGear, direction, emergency)
    if newGear == self.gear then return end
    local oldGear = self.gear
    local rpmBefore = self.rpm
    local prof = self.profiles:current()

    self.gear = newGear

    -- RPM recomputed for new gear (continuity — wheelRPM doesn't change)
    if newGear > 0 and oldGear > 0 then
        self.rpm = self:_getWheelRPM(prof, newGear)
    elseif newGear == 1 then
        self.rpm = prof.idleRPM
    elseif newGear == -1 then
        self.rpm = prof.idleRPM
    end

    -- Shift cooldown
    if self.core.settings.realisticShifting then
        self.shiftState = "open"
        local clutchDur = self.core.settings.physics.clutchSimulation and self.core.settings.physics.clutchDuration or 0.15
        self.shiftCooldown = math.max(self.core.config.shiftCooldown, clutchDur)
    else
        self.shiftState = "closed"
        self.shiftCooldown = self.core.config.shiftCooldown
    end

    self._shiftEvents = self._shiftEvents + 1
    self._lastShiftTime = os.clock()
    if direction == "up" then self._lastShiftUpTime = os.clock()
    else self._lastShiftDownTime = os.clock() end

    _G.VX.bus:emit("vehicle.shift", {
        up = direction == "up", from = oldGear, to = newGear,
        rpmBefore = rpmBefore, rpmAfter = self.rpm, emergency = emergency or false,
    })
end

-- ==================== REV LIMITER ====================
function Module:_updateRevLimiter(dt, prof)
    local throttle = self.smoothedThrottle
    if self.launch.twostepActive then return end

    -- Rev limiter only in top gear (otherwise shift fires first)
    if throttle > 0.7 and self.rpm >= prof.redlineRPM and self.gear >= MAX_GEAR then
        if not self.revLimiterActive then
            self.revLimiterActive = true
            self.revLimiterPhase = 0
            _G.VX.bus:emit("engine.revLimit", { active = true })
        end
        self.revLimiterPhase = self.revLimiterPhase + dt
        local phase = self.revLimiterPhase % 0.16
        if phase < 0.08 then
            self.rpm = math.max(prof.redlineRPM - 100, self.rpm - 800 * dt)
        end
    else
        if self.revLimiterActive then
            self.revLimiterActive = false
            _G.VX.bus:emit("engine.revLimit", { active = false })
        end
    end
end

-- ==================== COLD START / IDLE HUNT / LOAD ====================
function Module:_updateColdStart(dt, prof)
    if not self.core.settings.physics.coldStart then return end
    local now = os.clock()
    if self._coldStartEndTime == 0 then
        self._coldStartEndTime = now + self.core.settings.physics.coldStartDuration
        _G.VX.bus:emit("engine.coldStartBegin", {})
    end
    if now >= self._coldStartEndTime then
        self._coldStartEndTime = 0
        _G.VX.bus:emit("engine.coldStartEnd", {})
    end
end

function Module:_updateIdleHunt(dt, prof)
    if not self.core.settings.physics.idleHunting then return end
    if self.smoothedThrottle > 0.1 then return end
    if self.rpm > prof.idleRPM * 1.4 then return end
    self._idleHuntPhase = self._idleHuntPhase + dt
    local wobble = math.sin(self._idleHuntPhase * 3) * 20
    self.rpm = self.rpm + wobble * dt * 4
end

function Module:_computeLoadFactor(prof)
    if not self.core.settings.physics.engineLoad then return 1.0 end
    local authority = _G.VX.Authority
    local handle = authority and authority:getHandle()
    if not handle or not handle.root or not handle.root.PrimaryPart then return 1.0 end
    local upY = handle.root.PrimaryPart.CFrame.UpVector.Y
    if upY >= 0.999 then return 1.0 end
    local slope = 1 - upY
    local sens = self.core.settings.physics.engineLoadSensitivity
    return math.max(0.3, 1 - slope * sens * 5)
end

-- ==================== LAUNCH / 2-STEP ====================
function Module:_updateLaunch(dt)
    local cfg = self.core.config.launch
    local tsCfg = self.core.config.twostep
    local bothPedals = self.input:isBothPedalsHeld()
    local speed = self:_getSpeed()
    local launch = self.launch
    local lcEnabled = self.core.settings.launchControlEnabled

    -- 2-step mode (launch control disabled)
    if not lcEnabled then
        if bothPedals and speed < tsCfg.minSpeed and self.gear == 1 then
            if not launch.twostepActive then
                launch.twostepActive = true
                launch.twostepStartTime = os.clock()
                launch.lastTwostepBackfire = 0
                _G.VX.bus:emit("vehicle.twostepStart", {})
            end
            local elapsed = os.clock() - launch.twostepStartTime
            local prof = self.profiles:current()
            local bounce = math.sin(elapsed * tsCfg.bounceFreqHz * math.pi * 2) * tsCfg.bounceAmplitude
            self.rpm = prof.redlineRPM + bounce
            self.smoothedThrottle = 0
            self.targetThrottle = 0
            if elapsed - launch.lastTwostepBackfire > tsCfg.backfireInterval then
                launch.lastTwostepBackfire = elapsed
                _G.VX.bus:emit("vehicle.backfire", { source = "twostep", count = 1 })
            end
        elseif launch.twostepActive then
            launch.twostepActive = false
            _G.VX.bus:emit("vehicle.twostepEnd", {})
        end
        return
    end

    -- Standard launch control
    if launch.state == "idle" then
        if bothPedals and speed < cfg.minSpeed and self.gear == 1 then
            if os.clock() >= launch.cooldownEnd then
                launch.state = "arming"
                launch.startTime = os.clock()
                launch.rpmTarget = math.min(cfg.rpmTarget, self.profiles:current().redlineRPM - 100)
            end
        end
    elseif launch.state == "arming" then
        if not bothPedals then launch.state = "idle"; return end
        if os.clock() - launch.startTime >= 0.15 then
            launch.state = "holding"
            launch.rpm = self.rpm
            _G.VX.bus:emit("vehicle.launchStart", { rpm = self.rpm, target = launch.rpmTarget })
        end
    elseif launch.state == "holding" then
        local authority = _G.VX.Authority
        local handle = authority and authority:getHandle()
        if handle and handle.root then
            pcall(function()
                if handle.root:GetAttribute("ThrottleFloat") ~= nil then
                    handle.root:SetAttribute("ThrottleFloat", 0)
                end
            end)
        end
        if not bothPedals then
            local accelHeld = self.input:isAccelHeld()
            local brakeHeld = self.input:isBrakeHeld()
            if accelHeld and not brakeHeld then
                launch.state = "releasing"
                launch.releaseTime = os.clock()
                local ratio = self.rpm / launch.rpmTarget
                local quality = "miss"
                if ratio >= cfg.windowPerfectMin and ratio <= cfg.windowPerfectMax then quality = "perfect"
                elseif ratio >= cfg.windowGoodMin and ratio <= cfg.windowGoodMax then quality = "good" end
                _G.VX.bus:emit("vehicle.launchRelease", { quality = quality, rpm = self.rpm, ratio = ratio })
            else
                launch.state = "idle"
                launch.cooldownEnd = os.clock() + 0.5
            end
        elseif os.clock() - launch.startTime > cfg.maxTime then
            launch.state = "idle"
            launch.cooldownEnd = os.clock() + 0.5
        end
    elseif launch.state == "releasing" then
        if os.clock() - launch.releaseTime > cfg.releaseDuration then
            launch.state = "idle"
            launch.cooldownEnd = os.clock() + 0.3
        end
    end
end

-- ==================== HELPERS ====================
function Module:_getSpeed()
    local authority = _G.VX.Authority
    local handle = authority and authority:getHandle()
    if not handle then return 0 end
    local v = nil
    if handle.root and handle.root.PrimaryPart then
        v = handle.root.PrimaryPart.AssemblyLinearVelocity
    elseif handle.seat then
        v = handle.seat.Velocity
    end
    if not v then return 0 end
    return Vector3.new(v.X, 0, v.Z).Magnitude * STUDS_TO_MPH
end

-- ==================== PUBLIC API ====================
function Module:getRPM() return self.rpm end
function Module:getGear() return self.gear end
function Module:getSmoothedThrottle() return self.smoothedThrottle end
function Module:isRevLimiting() return self.revLimiterActive end
function Module:getShiftState() return self.shiftState end
function Module:getLaunchState() return self.launch.state end
function Module:isTwostepActive() return self.launch.twostepActive end
function Module:getSlopeLoadFactor() return self._loadFactor end
function Module:getEffectiveTopSpeed() return self.effectiveTopSpeed end

return Module
