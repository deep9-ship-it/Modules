--[[
    VX_Powertrain v3.5.1
    - Wheel-Coupled Gear-Stage RPM + Stall-Speed Torque Converter Launch
    - Unified gearRatios[maxGear] / gearRatios[gear] speed & ratio-conserving shifts
    - Adaptive TCU: Struggle/Hill Downshift, Anti-Hunt Hysteresis, UPOD Multi-Gear Kickdown,
      Corner-Entry Lift-Off Hold, Braking Downshifts & Rev-Match Blip
    - Redline Backfires: Emits vehicle.backfire on every redline upshift & every rev-limiter hit/bounce
    - Upshift trigger: RPM >= effectiveRedline * 0.98
]]

local VX = _G.VX
if not VX or not VX.Framework then error("VX_Powertrain requires VX_Kernel") end

local Players = game:GetService("Players")
local Player = Players.LocalPlayer

local Module = VX.Framework.Module.new({
    Name = "Powertrain",
    Dependencies = { "Core", "Profiles", "Input", "VehicleState" },
    Version = "3.5.1",
})

local TICK_NORMAL = 60
local TICK_LOW = 30
local STUDS_TO_MPH = 0.626
local DEFAULT_LOW_RPM_DOWNSHIFT = 2800
local DEFAULT_STALL_THRESHOLD = 1050
local DEFAULT_SHIFT_COOLDOWN = 0.10

function Module:Construct()
    self.rpm = 900
    self.gear = 1
    self.shiftCooldown = 0
    self.shiftState = "closed"
    self.smoothedThrottle = 0
    self.targetThrottle = 0
    self.revLimiterActive = false
    self.revLimiterPhase = 0

    self.launch = {
        state = "idle", startTime = 0, releaseTime = 0,
        rpmTarget = 6500, rpm = 900, cooldownEnd = 0,
        twostepActive = false, twostepStartTime = 0, lastTwostepBackfire = 0,
    }

    self.pendingUpshift = { active = false, targetGear = nil, shiftTime = 0 }
    self._loopThread = nil
    self._stateConn = nil
    self._running = false
    self._shiftEvents = 0
    self._lastShiftTime = 0
    self._lastShiftUpTime = 0
    self._lastShiftDownTime = 0
    self._lastRedlineBackfire = 0
    self._coldStartEndTime = 0
    self._coldStartDone = false
    self._bogUntil = 0
    self._bogMagnitude = 0
    self._lastSmoothed = 0
    self._idleHuntPhase = 0
    self._loadFactor = 1.0
    self._effectiveTopSpeed = 100

    self._prevBodySpeed = 0
    self._smoothAccel = 0
    self._struggleTimer = 0
    self._antiHuntGear = nil
    self._antiHuntUntil = 0
    self._prevPosThrottle = 0
    self._cornerHoldUntil = 0
    self._sportStabUntil = 0
    self._revMatchTarget = nil
end

function Module:Init(deps)
    self.core = deps.Core
    self.profiles = deps.Profiles
    self.input = deps.Input
    self.state = deps.VehicleState
end

function Module:Start()
    _G.VX.Powertrain = self
    self._stateConn = _G.VX.bus:on("vehicle.stateChanged", function(evt)
        if not evt then return end
        if evt.to == "Ready" or evt.to == "Idle" then
            self:_start()
        elseif evt.to == "Exiting" or evt.to == "Disabled" then
            self:_stop()
        end
    end)
    self:_registerDiagnostics()

    local authority = _G.VX.Authority
    if authority and authority:getHandle() then
        self:_start()
    end
end

function Module:Stop()
    if self._stateConn then
        if typeof(self._stateConn) == "RBXScriptConnection" then
            self._stateConn:Disconnect()
        elseif type(self._stateConn) == "table" and self._stateConn.Disconnect then
            self._stateConn:Disconnect()
        end
        self._stateConn = nil
    end
    self:_stop()
    if _G.VX.Powertrain == self then _G.VX.Powertrain = nil end
end

function Module:heartbeat()
    if not self._running then return true end
    return self._loopThread ~= nil
end

function Module:_registerDiagnostics()
    local D = _G.VX.diagnostics
    pcall(function()
        D.register("powertrain.rpm", {
            fn = function() return { value = math.floor(self.rpm), unit = "rpm", status = self.revLimiterActive and "warn" or "normal" } end,
            category = "Powertrain",
        }, "Powertrain")
        D.register("powertrain.gear", {
            fn = function() return { value = self.gear, unit = "", status = "normal" } end,
            category = "Powertrain",
        }, "Powertrain")
        D.register("powertrain.launch", {
            fn = function() return { value = self.launch.state, unit = "", status = "normal" } end,
            category = "Powertrain",
        }, "Powertrain")
        D.register("powertrain.accel", {
            fn = function() return { value = string.format("%.1f", self._smoothAccel), unit = "mph/s", status = "normal" } end,
            category = "Powertrain",
        }, "Powertrain")
    end)
end

function Module:_start()
    if self._running then return end
    self._running = true
    local prof = self.profiles:current()
    self.rpm = prof.idleRPM
    self.gear = 1
    self.shiftState = "closed"
    self.shiftCooldown = 0
    self.revLimiterActive = false
    self._coldStartEndTime = 0
    self._coldStartDone = false
    self._lastRedlineBackfire = 0
    self._effectiveTopSpeed = self.core.settings.topSpeed or 100
    self._prevBodySpeed = 0
    self._smoothAccel = 0
    self._struggleTimer = 0
    self._antiHuntGear = nil
    self._antiHuntUntil = 0
    self._prevPosThrottle = 0
    self._cornerHoldUntil = 0
    self._sportStabUntil = 0
    self._revMatchTarget = nil
    self.launch.state = "idle"
    self.launch.twostepActive = false
    self.pendingUpshift.active = false
    self.pendingUpshift.targetGear = nil

    self._loopThread = task.spawn(function()
        local perf = self.core.settings._effectivePerformance
        local tickRate = (perf == "low") and TICK_LOW or TICK_NORMAL
        local interval = 1 / tickRate
        local lastTick = os.clock()
        while self._running do
            local now = os.clock()
            local dt = now - lastTick
            lastTick = now
            if dt <= 0 or dt > 0.1 then dt = interval end
            pcall(function() self:_update(dt) end)
            local toSleep = interval - (os.clock() - now)
            if toSleep > 0 then task.wait(toSleep) end
        end
    end)
    print("[VX] Powertrain started")
end

function Module:_stop()
    if not self._running then return end
    self._running = false
    if self._loopThread then
        pcall(function() task.cancel(self._loopThread) end)
        self._loopThread = nil
    end
    self.launch.state = "idle"
    self.launch.twostepActive = false
    self.pendingUpshift.active = false
    print("[VX] Powertrain stopped")
end

function Module:_update(dt)
    local prof = self.profiles:current()
    local bodySpeed = self:_getBodySpeed()
    local rawAccel = (bodySpeed - self._prevBodySpeed) / math.max(dt, 0.001)
    self._prevBodySpeed = bodySpeed
    self._smoothAccel = self._smoothAccel + (rawAccel - self._smoothAccel) * math.min(4.0 * dt, 1)

    local targetTop = math.max(self.core.settings.topSpeed or 100, 10)
    local drive = _G.VX.DriveSystem
    if drive and drive.getEffectiveTopSpeed then
        self._effectiveTopSpeed = drive:getEffectiveTopSpeed()
    elseif bodySpeed < 3 then
        self._effectiveTopSpeed = targetTop
    else
        self._effectiveTopSpeed = self._effectiveTopSpeed + (targetTop - self._effectiveTopSpeed) * math.min(2.0 * dt, 1)
    end

    self:_updateLaunch(dt)
    self:_updateThrottleSmoother(dt)

    local now = os.clock()
    local posThr = math.max(0, self.smoothedThrottle)
    local dThr = (posThr - self._prevPosThrottle) / math.max(dt, 0.001)
    if self._prevPosThrottle > 0.70 and posThr < 0.15 then
        self._cornerHoldUntil = now + 0.80
    end
    if dThr > 2.5 and posThr > 0.65 then
        self._sportStabUntil = now + 1.50
    end
    self._prevPosThrottle = posThr

    self:_updateRPM(dt, prof)
    if self.shiftCooldown > 0 then
        self.shiftCooldown = math.max(0, self.shiftCooldown - dt)
    end
    self:_updateGear(dt, prof)
    if self.shiftState == "open" and self.shiftCooldown <= 0 then
        self.shiftState = "closed"
        self._revMatchTarget = nil
    end
    self:_updateRevLimiter(dt, prof)
    self:_updateColdStart(dt, prof)
    self:_updateIdleHunt(dt, prof)
    self._loadFactor = self:_computeLoadFactor(prof)
end

function Module:_getMaxGear(prof)
    if prof and prof.gearRatios and #prof.gearRatios > 0 then
        return #prof.gearRatios
    end
    return 7
end

function Module:_getGearMaxMPH(prof, gear)
    local effTop = self._effectiveTopSpeed
    if gear == -1 then
        return math.min(effTop * 0.28, 40)
    elseif gear <= 0 then
        return effTop
    end
    local ratios = prof.gearRatios or { 3.65, 2.28, 1.62, 1.25, 1.00, 0.84, 0.70 }
    local maxGear = #ratios
    local topRatio = ratios[maxGear] or 0.70
    local curRatio = ratios[math.clamp(gear, 1, maxGear)] or topRatio
    return effTop * (topRatio / math.max(curRatio, 0.01))
end

function Module:_getEffectiveRedline(prof)
    local settings = self.core.settings
    local effectiveRedline = prof.redlineRPM
    if settings.physics and settings.physics.coldStart and self._coldStartEndTime > 0 and os.clock() < self._coldStartEndTime then
        local duration = math.max(settings.physics.coldStartDuration or 1, 0.01)
        local remain = (self._coldStartEndTime - os.clock()) / duration
        effectiveRedline = prof.redlineRPM - (self.core.config.coldStartRedlineDrop or 0) * remain
    end
    return effectiveRedline
end

function Module:_updateThrottleSmoother(dt)
    local settings = self.core.settings
    local tiltLevel = settings.physicsTiltLevel
    local smoothingOn = (tiltLevel == "Medium" or tiltLevel == "High" or tiltLevel == "Extreme")

    if self.launch.twostepActive or self.launch.state == "holding" then
        self.smoothedThrottle = 0
        self.targetThrottle = 0
        return
    end
    if self.launch.state == "releasing" then
        self.smoothedThrottle = 1.0
        self.targetThrottle = 1.0
        return
    end
    if self.shiftState == "open" and settings.realisticShifting then
        self.smoothedThrottle = 0
        self.targetThrottle = 0
        return
    end

    local raw = self.input:getRawThrottle()
    self.targetThrottle = raw

    if not smoothingOn then
        self.smoothedThrottle = raw
        return
    end

    local cur = self.smoothedThrottle
    local target = raw
    local rate
    local brakeSpeed = settings.brakeSpeed or 5.0

    if target < -0.05 then
        rate = brakeSpeed
    elseif cur < -0.05 and target > -0.05 then
        rate = brakeSpeed
    elseif target > cur + 0.05 then
        if settings.throttleUltra then
            rate = 100
        elseif self.rpm >= self.core.config.launch.rpmTarget * 0.6 then
            rate = 2.0
        elseif cur < 0.05 then
            rate = 0.4
        else
            rate = 3.0
        end
    elseif target < cur - 0.05 then
        rate = 0.4
    else
        rate = 5.0
    end

    local new = cur + (target - cur) * math.min(rate * dt, 1)
    self.smoothedThrottle = new

    if settings.physics and settings.physics.engineBog then
        local delta = new - self._lastSmoothed
        if delta > 0.5 and self.rpm < 2500 then
            self._bogUntil = os.clock() + 0.12
            self._bogMagnitude = delta * 200
        end
        self._lastSmoothed = new
    end
end

function Module:_updateRPM(dt, prof)
    if self.launch.twostepActive then return end

    if self.launch.state == "holding" then
        local target = self.launch.rpmTarget
        local diff = target - self.rpm
        self.rpm = self.rpm + diff * self.core.config.launch.rpmBuildRate * dt
        self.rpm = math.min(self.rpm, prof.redlineRPM)
        return
    end

    local effectiveRedline = self:_getEffectiveRedline(prof)
    local wheelSpeed = self:_getWheelSpeed()
    local clutchHeld = self.input:isClutchHeld()
    local posThr = math.max(0, self.smoothedThrottle)
    local riseMult = prof.rpmRiseMultiplier or 1.0

    if self.gear == -1 then
        local revMax = math.max(self:_getGearMaxMPH(prof, -1), 1)
        local revFrac = math.clamp(wheelSpeed / revMax, 0, 1)
        local target = prof.idleRPM + math.max(math.abs(self.smoothedThrottle) * 0.45, revFrac * 0.65) * (effectiveRedline - prof.idleRPM)
        self.rpm = self.rpm + (target - self.rpm) * math.min(10 * dt, 1)
        self.rpm = math.clamp(self.rpm, prof.idleRPM * 0.9, effectiveRedline)
        return
    end

    if clutchHeld then
        local target = prof.idleRPM + posThr * (effectiveRedline - prof.idleRPM)
        local rate = (target > self.rpm) and (6.0 * riseMult) or 3.5
        self.rpm = self.rpm + (target - self.rpm) * math.min(rate * dt, 1)
        self.rpm = math.clamp(self.rpm, prof.idleRPM * 0.9, effectiveRedline + 80)
        return
    end

    if self.shiftState == "open" and self.core.settings.realisticShifting then
        if self._revMatchTarget then
            self.rpm = self.rpm + (self._revMatchTarget - self.rpm) * math.min(18 * dt, 1)
        else
            self.rpm = math.max(prof.idleRPM, self.rpm - 1400 * dt)
        end
        return
    end

    local gearMaxMPH = math.max(self:_getGearMaxMPH(prof, self.gear), 1)
    local stageRPM = prof.idleRPM + math.clamp(wheelSpeed / gearMaxMPH, 0, 1.04) * (effectiveRedline - prof.idleRPM)

    local converterSlip = 0
    if self.gear == 1 and wheelSpeed < gearMaxMPH * 0.55 then
        local slipFade = 1 - math.clamp(wheelSpeed / math.max(gearMaxMPH * 0.55, 0.1), 0, 1)
        converterSlip = posThr * 650 * slipFade
    elseif posThr > 0.1 then
        converterSlip = posThr * 160
    end

    local targetRPM = math.min(effectiveRedline + 100, stageRPM + converterSlip)
    local trackRate = (targetRPM > self.rpm) and (9.0 * riseMult) or 6.5
    self.rpm = self.rpm + (targetRPM - self.rpm) * math.min(trackRate * self._loadFactor * dt, 1)

    if os.clock() < self._bogUntil then
        local remain = (self._bogUntil - os.clock()) / 0.12
        self.rpm = self.rpm - self._bogMagnitude * remain * dt * 10
    end

    self.rpm = math.max(prof.idleRPM * 0.9, math.min(effectiveRedline + 120, self.rpm))
end

function Module:_clearPendingUpshift()
    self.pendingUpshift.active = false
    self.pendingUpshift.targetGear = nil
end

function Module:_findOptimalKickdownGear(prof, effectiveRedline)
    local ratios = prof.gearRatios
    if not ratios then return nil end
    local curRatio = ratios[self.gear]
    if not curRatio or curRatio <= 0 then return nil end

    local bestGear = nil
    for g = self.gear - 1, 1, -1 do
        local r = ratios[g]
        if r and r > 0 then
            local pred = prof.idleRPM + (self.rpm - prof.idleRPM) * (r / curRatio)
            if pred >= effectiveRedline * 0.50 and pred <= effectiveRedline * 0.84 then
                bestGear = g
            end
        end
    end

    if not bestGear and self.gear > 1 then
        local r = ratios[self.gear - 1]
        if r and r > 0 then
            local pred = prof.idleRPM + (self.rpm - prof.idleRPM) * (r / curRatio)
            if pred < effectiveRedline * 0.88 then
                bestGear = self.gear - 1
            end
        end
    end
    return bestGear
end

function Module:_updateGear(dt, prof)
    if self.shiftCooldown > 0 then return end
    if self.launch.state == "holding" or self.launch.twostepActive then return end

    local now = os.clock()
    local bodySpeed = self:_getBodySpeed()
    local wheelSpeed = self:_getWheelSpeed()
    local effectiveSpeed = math.max(bodySpeed, wheelSpeed * 0.85)
    local maxGear = self:_getMaxGear(prof)
    local effectiveRedline = self:_getEffectiveRedline(prof)
    local lowRpmDownshift = self.core.config.lowRpmDownshift or DEFAULT_LOW_RPM_DOWNSHIFT
    local stallThreshold = self.core.config.stallThreshold or DEFAULT_STALL_THRESHOLD
    local posThr = math.max(0, self.smoothedThrottle)
    local sinceUpshift = now - self._lastShiftUpTime

    if self.gear == -1 then
        if self.smoothedThrottle > 0.1 then
            self:_clearPendingUpshift()
            self:_doShift(1, "up", false)
        end
        return
    end

    if self.smoothedThrottle < -0.1 and bodySpeed < 5 then
        self:_clearPendingUpshift()
        self:_doShift(-1, "down", false)
        return
    end

    if bodySpeed < 4 and wheelSpeed < 4 then
        self:_clearPendingUpshift()
        self._struggleTimer = 0
        if self.gear > 1 then
            self:_doShift(1, "down", false)
        end
        return
    end

    if self.pendingUpshift.active then
        if now >= self.pendingUpshift.shiftTime then
            local targetGear = self.pendingUpshift.targetGear
            self:_clearPendingUpshift()
            if targetGear and targetGear <= maxGear and self.gear < maxGear and self.rpm >= effectiveRedline * 0.98 then
                self:_doShift(targetGear, "up", false)
            end
        end
        return
    end

    if self.rpm >= effectiveRedline * 0.98 and self.gear < maxGear and effectiveSpeed >= 4 then
        local newGear = self.gear + 1
        local cornerHeld = (now < self._cornerHoldUntil) and (posThr < 0.35)
        local antiHuntBlocked = (self._antiHuntGear == newGear) and (now < self._antiHuntUntil) and (self._smoothAccel < 2.0)

        if not cornerHeld and not antiHuntBlocked then
            if self.core.settings.shiftDelay and newGear >= 2 and newGear <= 4 then
                self.pendingUpshift.active = true
                self.pendingUpshift.targetGear = newGear
                self.pendingUpshift.shiftTime = now + (0.4 + math.random() * 0.9)
            else
                self:_doShift(newGear, "up", false)
            end
            return
        end
    end

    if self.gear > 1 then
        local lowerGear = self.gear - 1
        local lowerRatio = prof.gearRatios[lowerGear]
        local currentRatio = prof.gearRatios[self.gear]
        local predictedRPM = self.rpm
        local canDownshift = true

        if lowerRatio and currentRatio and currentRatio > 0 then
            predictedRPM = prof.idleRPM + (self.rpm - prof.idleRPM) * (lowerRatio / currentRatio)
            canDownshift = predictedRPM < (effectiveRedline * 0.90)
        end

        if not canDownshift then
            self._struggleTimer = 0
            return
        end

        if self.rpm < stallThreshold then
            self._struggleTimer = 0
            self:_doShift(lowerGear, "down", true)
            return
        end

        if self.smoothedThrottle < -0.35 and self.rpm < (lowRpmDownshift + 600) and predictedRPM < (effectiveRedline * 0.85) then
            self._struggleTimer = 0
            self:_doShift(lowerGear, "down", false)
            self.shiftCooldown = math.max(self.shiftCooldown, 0.22)
            return
        end

        if self.rpm < lowRpmDownshift then
            self._struggleTimer = 0
            self:_doShift(lowerGear, "down", false)
            return
        end

        if sinceUpshift >= 0.80 then
            local wantKickdown = (posThr > 0.85) or (now < self._sportStabUntil and posThr > 0.75)
            if wantKickdown and self.rpm < effectiveRedline * 0.58 then
                local optGear = self:_findOptimalKickdownGear(prof, effectiveRedline)
                if optGear and optGear < self.gear then
                    self._struggleTimer = 0
                    self:_doShift(optGear, "down", false)
                    self.shiftCooldown = math.max(self.shiftCooldown, 0.28)
                    return
                end
            end

            local gearMaxMPH = self:_getGearMaxMPH(prof, self.gear)
            if posThr > 0.55 and self.rpm < effectiveRedline * 0.72 and bodySpeed < gearMaxMPH * 0.88 then
                local expectedMin = math.max(1.0, posThr * (currentRatio or 1.0) * 0.9)
                if self._smoothAccel < expectedMin * 0.35 then
                    self._struggleTimer = self._struggleTimer + dt
                    if self._struggleTimer >= 0.55 then
                        local oldGear = self.gear
                        self._struggleTimer = 0
                        self:_doShift(lowerGear, "down", false)
                        self._antiHuntGear = oldGear
                        self._antiHuntUntil = now + 2.5
                        self.shiftCooldown = math.max(self.shiftCooldown, 0.55)
                        return
                    end
                else
                    self._struggleTimer = math.max(0, self._struggleTimer - dt * 2.0)
                end
            else
                self._struggleTimer = 0
            end
        else
            self._struggleTimer = 0
        end
    end
end

function Module:_doShift(newGear, direction, emergency)
    if newGear == self.gear then return end
    local oldGear = self.gear
    local rpmBefore = self.rpm
    local prof = self.profiles:current()
    local effectiveRedline = self:_getEffectiveRedline(prof)

    self.gear = newGear
    self._struggleTimer = 0
    if newGear > 0 and oldGear > 0 then
        local ratio = prof.gearRatios[newGear] / math.max(prof.gearRatios[oldGear], 0.01)
        local targetRPM = prof.idleRPM + (self.rpm - prof.idleRPM) * ratio
        if direction == "down" and self.core.settings.realisticShifting then
            self._revMatchTarget = math.min(prof.redlineRPM * 0.92, targetRPM + 220)
            self.rpm = targetRPM
        else
            self._revMatchTarget = nil
            self.rpm = targetRPM
        end
    elseif newGear == 1 then
        self._revMatchTarget = nil
        self.rpm = prof.idleRPM
    end

    local baseCooldown = self.core.config.shiftCooldown or DEFAULT_SHIFT_COOLDOWN
    if self.core.settings.realisticShifting then
        self.shiftState = "open"
        local clutchDur = (self.core.settings.physics and self.core.settings.physics.clutchSimulation and self.core.settings.physics.clutchDuration) or 0.15
        self.shiftCooldown = math.max(baseCooldown, clutchDur)
    else
        self.shiftState = "closed"
        self.shiftCooldown = baseCooldown
    end

    self._shiftEvents = self._shiftEvents + 1
    self._lastShiftTime = os.clock()
    if direction == "up" then
        self._lastShiftUpTime = os.clock()
        -- Backfire on every redline upshift
        if self.core.settings.backfireEnabled ~= false and rpmBefore >= effectiveRedline * 0.94 then
            self._lastRedlineBackfire = os.clock()
            _G.VX.bus:emit("vehicle.backfire", { source = "redline_shift", count = 1 })
        end
    else
        self._lastShiftDownTime = os.clock()
    end

    _G.VX.bus:emit("vehicle.shift", {
        up = direction == "up",
        from = oldGear,
        to = newGear,
        rpmBefore = rpmBefore,
        rpmAfter = self.rpm,
        emergency = emergency or false,
    })
end

function Module:_updateRevLimiter(dt, prof)
    if self.launch.twostepActive then return end
    local posThr = math.max(0, self.smoothedThrottle)
    local maxGear = self:_getMaxGear(prof)
    local effectiveRedline = self:_getEffectiveRedline(prof)
    local canHitLimiter = (self.gear >= maxGear) or self.input:isClutchHeld() or self.pendingUpshift.active

    if posThr > 0.65 and self.rpm >= effectiveRedline * 0.985 and canHitLimiter then
        local now = os.clock()
        if not self.revLimiterActive then
            self.revLimiterActive = true
            self.revLimiterPhase = 0
            _G.VX.bus:emit("engine.revLimit", { active = true })
            if self.core.settings.backfireEnabled ~= false and (now - self._lastRedlineBackfire >= 0.12) then
                self._lastRedlineBackfire = now
                _G.VX.bus:emit("vehicle.backfire", { source = "redline", count = 1 })
            end
        end
        self.revLimiterPhase = self.revLimiterPhase + dt
        local phase = self.revLimiterPhase % 0.14
        if phase < 0.07 then
            self.rpm = math.max(effectiveRedline - 180, self.rpm - 1800 * dt)
            if self.core.settings.backfireEnabled ~= false and (now - self._lastRedlineBackfire >= 0.14) then
                self._lastRedlineBackfire = now
                _G.VX.bus:emit("vehicle.backfire", { source = "redline", count = 1 })
            end
        end
    else
        if self.revLimiterActive then
            self.revLimiterActive = false
            _G.VX.bus:emit("engine.revLimit", { active = false })
        end
    end
end

function Module:_updateColdStart(dt, prof)
    local enabled = self.core.settings.physics and self.core.settings.physics.coldStart
    if not enabled or self._coldStartDone then return end
    local now = os.clock()
    if self._coldStartEndTime == 0 then
        self._coldStartEndTime = now + (self.core.settings.physics.coldStartDuration or 5)
        _G.VX.bus:emit("engine.coldStartBegin", {})
    elseif now >= self._coldStartEndTime then
        self._coldStartEndTime = 0
        self._coldStartDone = true
        _G.VX.bus:emit("engine.coldStartEnd", {})
    end
end

function Module:_updateIdleHunt(dt, prof)
    if not (self.core.settings.physics and self.core.settings.physics.idleHunting) then return end
    if self.smoothedThrottle > 0.1 then return end
    if self.rpm > prof.idleRPM * 1.4 then return end
    self._idleHuntPhase = self._idleHuntPhase + dt
    local wobble = math.sin(self._idleHuntPhase * 3) * 20
    self.rpm = self.rpm + wobble * dt * 4
end

function Module:_computeLoadFactor(prof)
    if not (self.core.settings.physics and self.core.settings.physics.engineLoad) then return 1.0 end
    local authority = _G.VX.Authority
    local handle = authority and authority:getHandle()
    local part = handle and ((handle.root and handle.root.PrimaryPart) or handle.platform or handle.chassis or handle.seat)
    if not part then return 1.0 end
    local upY = part.CFrame.UpVector.Y
    if upY >= 0.999 then return 1.0 end
    local slope = 1 - upY
    local sens = self.core.settings.physics.engineLoadSensitivity or 1
    return math.max(0.3, 1 - slope * sens * 5)
end

function Module:_updateLaunch(dt)
    local cfg = self.core.config.launch
    local tsCfg = self.core.config.twostep
    local bothPedals = self.input:isBothPedalsHeld()
    local speed = self:_getBodySpeed()
    local launch = self.launch
    local lcEnabled = self.core.settings.launchControlEnabled

    if not lcEnabled then
        if bothPedals and speed < tsCfg.minSpeed and self.gear == 1 then
            if not launch.twostepActive then
                launch.twostepActive = true
                launch.twostepStartTime = os.clock()
                launch.lastTwostepBackfire = 0
                _G.VX.bus:emit("vehicle.twostepStart", {})
            end
            local elapsed = os.clock() - launch.twostepStartTime
            local prof = self.profiles:current()
            local bounce = math.sin(elapsed * tsCfg.bounceFreqHz * math.pi * 2) * tsCfg.bounceAmplitude
            self.rpm = prof.redlineRPM + bounce
            self.smoothedThrottle = 0
            self.targetThrottle = 0
            if elapsed - launch.lastTwostepBackfire > tsCfg.backfireInterval then
                launch.lastTwostepBackfire = elapsed
                _G.VX.bus:emit("vehicle.backfire", { source = "twostep", count = 1 })
            end
        elseif launch.twostepActive then
            launch.twostepActive = false
            _G.VX.bus:emit("vehicle.twostepEnd", {})
        end
        return
    end

    if launch.state == "idle" then
        if bothPedals and speed < cfg.minSpeed and self.gear == 1 then
            if os.clock() >= launch.cooldownEnd then
                launch.state = "arming"
                launch.startTime = os.clock()
                launch.rpmTarget = math.min(cfg.rpmTarget, self.profiles:current().redlineRPM - 100)
            end
        end
    elseif launch.state == "arming" then
        if not bothPedals then
            launch.state = "idle"
            return
        end
        if os.clock() - launch.startTime >= 0.15 then
            launch.state = "holding"
            launch.rpm = self.rpm
            _G.VX.bus:emit("vehicle.launchStart", { rpm = self.rpm, target = launch.rpmTarget })
        end
    elseif launch.state == "holding" then
        local authority = _G.VX.Authority
        local handle = authority and authority:getHandle()
        if handle and handle.root then
            pcall(function()
                if handle.root:GetAttribute("ThrottleFloat") ~= nil then
                    handle.root:SetAttribute("ThrottleFloat", 0)
                end
            end)
        end
        if not bothPedals then
            local accelHeld = self.input:isAccelHeld()
            local brakeHeld = self.input:isBrakeHeld()
            if accelHeld and not brakeHeld then
                launch.state = "releasing"
                launch.releaseTime = os.clock()
                local ratio = self.rpm / launch.rpmTarget
                local quality = "miss"
                if ratio >= cfg.windowPerfectMin and ratio <= cfg.windowPerfectMax then
                    quality = "perfect"
                elseif ratio >= cfg.windowGoodMin and ratio <= cfg.windowGoodMax then
                    quality = "good"
                end
                _G.VX.bus:emit("vehicle.launchRelease", { quality = quality, rpm = self.rpm, ratio = ratio })
            else
                launch.state = "idle"
                launch.cooldownEnd = os.clock() + 0.5
            end
        elseif os.clock() - launch.startTime > cfg.maxTime then
            launch.state = "idle"
            launch.cooldownEnd = os.clock() + 0.5
        end
    elseif launch.state == "releasing" then
        if os.clock() - launch.releaseTime > cfg.releaseDuration then
            launch.state = "idle"
            launch.cooldownEnd = os.clock() + 0.3
        end
    end
end

function Module:_getBodySpeed()
    local authority = _G.VX.Authority
    local handle = authority and authority:getHandle()
    local part = handle and ((handle.root and handle.root.PrimaryPart) or handle.platform or handle.chassis or handle.seat)
    if not part then return 0 end
    local v = part.AssemblyLinearVelocity
    return Vector3.new(v.X, 0, v.Z).Magnitude * STUDS_TO_MPH
end

function Module:_getWheelSpeed()
    local drive = _G.VX.DriveSystem
    if drive and drive.getWheelSpeed then
        local ws = drive:getWheelSpeed()
        if ws and ws > 0 then
            return ws
        end
    end
    return self:_getBodySpeed()
end

function Module:getRPM() return self.rpm end
function Module:getGear() return self.gear end
function Module:getSmoothedThrottle() return self.smoothedThrottle end
function Module:isRevLimiting() return self.revLimiterActive end
function Module:getShiftState() return self.shiftState end
function Module:getLaunchState() return self.launch.state end
function Module:isTwostepActive() return self.launch.twostepActive end
function Module:getSlopeLoadFactor() return self._loadFactor end

return Module
