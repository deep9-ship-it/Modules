--[[
    VX_Powertrain v3.0.0
    RPM, gears, clutch, launch RPM control, throttle smoothing.

    Depends on: Core, Profiles, Input, VehicleState
    Exposes:
      getRPM()               → number
      getGear()              → number (-1..7)
      getSmoothedThrottle()  → number (-brakingPower..1)
      isRevLimiting()        → bool
      getShiftState()        → "closed" | "open"
      getLaunchState()       → "idle" | "arming" | "holding" | "releasing" | "cooled"
      getSlopeLoadFactor()   → number (0..1) for DriveSystem

    Emits:
      vehicle.shift        { up, from, to, rpmBefore, rpmAfter, emergency }
      engine.revLimit      { active }
      vehicle.launchStart  { rpm }
      vehicle.launchRelease{ quality, rpm }

    Responsibilities:
      - Frame-rate independent updates
      - Torque curve, engine load, cold start, idle hunting, bog
      - Predictive gear shifts with hysteresis
      - Clutch simulation with shift cut
      - 3 rev limiter types (soft / hard / ignition)
      - Full launch state machine (arming → holding → releasing → idle)
      - Fuel cut pattern during limit
      - Triggers backfire burst on launch release via bus event
]]

local VX = _G.VX
if not VX or not VX.Framework then error("VX_Powertrain requires VX_Kernel") end

local Players = game:GetService("Players")
local Player = Players.LocalPlayer

local Module = VX.Framework.Module.new({
    Name = "Powertrain",
    Dependencies = { "Core", "Profiles", "Input", "VehicleState" },
    Version = "3.0.0",
})

-- ==================== CONSTANTS ====================
local TICK_RATE_NORMAL = 60
local TICK_RATE_LOW    = 30

local LAUNCH_STATES = {
    IDLE      = "idle",
    ARMING    = "arming",     -- both pedals, waiting for confirmation
    HOLDING   = "holding",    -- RPM ramping, throttle forced 0
    RELEASING = "releasing",  -- brake released, throttle burst
    COOLED    = "cooled",     -- aftermath, brief period before normal
}

-- ==================== STATE ====================
function Module:Construct()
    self.rpm            = 900
    self.gear           = 1
    self.shiftCooldown  = 0
    self.shiftState     = "closed"

    self.smoothedThrottle = 0
    self.targetThrottle   = 0

    self.revLimiterActive = false
    self.revLimiterPhase  = 0
    self.revLimiterLastToggle = 0

    self.launch = {
        state       = LAUNCH_STATES.IDLE,
        startTime   = 0,
        releaseTime = 0,
        rpmTarget   = 6500,
        rpm         = 900,
        cooldownEnd = 0,
    }

    self._loopThread = nil
    self._running    = false

    -- Diagnostic accumulators
    self._fuelCutEvents   = 0
    self._shiftEvents     = 0
    self._lastShiftTime   = 0
    self._upshiftFlicker  = 0  -- detects rapid up/down flutter
    self._downshiftFlicker= 0

    -- Cold start
    self._coldStartEndTime = 0

    -- Bog
    self._bogUntil    = 0
    self._bogMagnitude = 0
    self._lastSmoothed = 0

    -- Idle hunt
    self._idleHuntPhase = 0

    -- Cache for diagnostics
    self._loadFactor = 1.0
end

function Module:Init(deps)
    self.core     = deps.Core
    self.profiles = deps.Profiles
    self.input    = deps.Input
    self.state    = deps.VehicleState
end

function Module:Start()
    _G.VX.Powertrain = self

    _G.VX.bus:on("vehicle.stateChanged", function(evt)
        if evt.to == "Ready" or evt.to == "Idle" then
            self:_start()
        elseif evt.to == "Exiting" or evt.to == "Disabled" then
            self:_stop()
        end
    end)

    -- Register diagnostics
    self:_registerDiagnostics()
end

function Module:Stop()
    self:_stop()
    if _G.VX.Powertrain == self then _G.VX.Powertrain = nil end
end

function Module:heartbeat()
    if not self._running then return true end
    return true
end

function Module:_registerDiagnostics()
    local D = _G.VX.diagnostics
    pcall(function()
        D.register("powertrain.rpm", {
            fn = function() return { value = math.floor(self.rpm), unit = "rpm", status = "normal" } end,
            category = "Powertrain",
        }, "Powertrain")
        D.register("powertrain.gear", {
            fn = function() return { value = self.gear, unit = "", status = "normal" } end,
            category = "Powertrain",
        }, "Powertrain")
        D.register("powertrain.throttle", {
            fn = function() return { value = string.format("%.2f", self.smoothedThrottle), unit = "", status = "normal" } end,
            category = "Powertrain",
        }, "Powertrain")
        D.register("powertrain.shift", {
            fn = function()
                return {
                    value = self.shiftState,
                    unit = "",
                    status = self.shiftState == "open" and "warning" or "normal",
                }
            end,
            category = "Powertrain",
        }, "Powertrain")
        D.register("powertrain.launch", {
            fn = function() return { value = self.launch.state, unit = "", status = "normal" } end,
            category = "Powertrain",
        }, "Powertrain")
        D.register("powertrain.revLimiter", {
            fn = function()
                return {
                    value = self.revLimiterActive and "ON" or "off",
                    unit = "",
                    status = self.revLimiterActive and "warning" or "normal",
                }
            end,
            category = "Powertrain",
        }, "Powertrain")
        D.register("powertrain.load", {
            fn = function() return { value = string.format("%.2f", self._loadFactor), unit = "", status = "normal" } end,
            category = "Powertrain",
        }, "Powertrain")
    end)
end

-- ==================== MAIN LOOP ====================
function Module:_start()
    if self._running then return end
    self._running = true

    local prof = self.profiles:current()
    self.rpm  = prof.idleRPM
    self.gear = 1
    self.shiftState = "closed"
    self.shiftCooldown = 0
    self.revLimiterActive = false
    self.revLimiterPhase = 0
    self.launch.state = LAUNCH_STATES.IDLE

    self._loopThread = task.spawn(function()
        local perf = self.core.settings._effectivePerformance
        local tickRate = (perf == "low") and TICK_RATE_LOW or TICK_RATE_NORMAL
        local tickInterval = 1 / tickRate
        local lastTick = os.clock()

        while self._running do
            local now = os.clock()
            local dt = now - lastTick
            lastTick = now

            -- Clamp dt for stability
            if dt <= 0 or dt > 0.1 then dt = tickInterval end

            pcall(self._update, self, dt)

            -- Sleep to maintain tick rate
            local elapsed = os.clock() - now
            local toSleep = tickInterval - elapsed
            if toSleep > 0 then
                task.wait(toSleep)
            end
        end
    end)

    print("[VX] Powertrain started (" .. (self.core.settings._effectivePerformance or "normal") .. ")")
end

function Module:_stop()
    if not self._running then return end
    self._running = false
    if self._loopThread then
        pcall(function() task.cancel(self._loopThread) end)
        self._loopThread = nil
    end
    self.launch.state = LAUNCH_STATES.IDLE
    print("[VX] Powertrain stopped")
end

function Module:_update(dt)
    local prof = self.profiles:current()
    local settings = self.core.settings
    local config = self.core.config

    -- 1. Update launch state machine (may override throttle)
    self:_updateLaunch(dt)

    -- 2. Update throttle smoother (respects launch override)
    self:_updateThrottleSmoother(dt)

    -- 3. Update RPM
    self:_updateRPM(dt, prof)

    -- 4. Update gear
    if self.shiftCooldown > 0 then
        self.shiftCooldown = self.shiftCooldown - dt
    end
    self:_updateGear(dt, prof)

    -- 5. Clutch state
    if self.shiftState == "open" and self.shiftCooldown <= 0 then
        -- Shift completed
        self.shiftState = "closed"
    end

    -- 6. Rev limiter
    self:_updateRevLimiter(dt, prof)

    -- 7. Cold start
    self:_updateColdStart(dt, prof)

    -- 8. Idle hunting
    self:_updateIdleHunt(dt, prof)

    -- 9. Engine load (for chassis)
    self._loadFactor = self:_computeLoadFactor(prof)

    -- 10. Flicker detection
    self._upshiftFlicker   = math.max(0, self._upshiftFlicker - dt)
    self._downshiftFlicker = math.max(0, self._downshiftFlicker - dt)
end

-- ==================== THROTTLE SMOOTHER ====================
function Module:_updateThrottleSmoother(dt)
    local settings = self.core.settings
    local tiltLevel = settings.physicsTiltLevel
    local smoothingOn = (tiltLevel == "Medium" or tiltLevel == "High" or tiltLevel == "Extreme")

    -- Launch overrides everything
    if self.launch.state == LAUNCH_STATES.HOLDING then
        self.smoothedThrottle = 0
        self.targetThrottle = 0
        return
    elseif self.launch.state == LAUNCH_STATES.RELEASING then
        self.smoothedThrottle = 1.0
        self.targetThrottle = 1.0
        return
    end

    -- Clutch cuts throttle
    if self.shiftState == "open" then
        self.smoothedThrottle = 0
        self.targetThrottle = 0
        return
    end

    local raw = self.input:getRawThrottle()
    self.targetThrottle = raw

    if not smoothingOn then
        self.smoothedThrottle = raw
        return
    end

    local cur = self.smoothedThrottle
    local target = raw
    local rate

    -- Determine rate
    if target < -0.05 then
        rate = 5.0  -- brake: snap on
    elseif cur < -0.05 and target > -0.05 then
        rate = 5.0  -- brake release: snap off
    elseif target > cur + 0.05 then
        -- Accelerating
        if settings.throttleUltra then
            rate = 100
        elseif self.rpm >= self.core.config.launch.rpmTarget * 0.6 then
            rate = 2.0  -- fast when already in powerband
        elseif cur < 0.05 then
            rate = 0.4  -- slow from rest
        else
            rate = 3.0  -- fast once moving
        end
    elseif target < cur - 0.05 then
        rate = 0.4  -- coast down slowly
    else
        rate = 5.0  -- small corrections
    end

    local new = cur + (target - cur) * math.min(rate * dt, 1)
    self.smoothedThrottle = new

    -- Apply bog (interrupts on rapid throttle stomp)
    if settings.physics.engineBog then
        local delta = new - self._lastSmoothed
        if delta > 0.5 and self.rpm < 2500 then
            self._bogUntil = os.clock() + 0.12
            self._bogMagnitude = delta * 200
        end
        self._lastSmoothed = new
    end
end

-- ==================== RPM ====================
function Module:_updateRPM(dt, prof)
    local settings = self.core.settings
    local config = self.core.config

    -- Launch overrides RPM
    if self.launch.state == LAUNCH_STATES.HOLDING then
        local target = self.launch.rpmTarget
        local diff = target - self.rpm
        self.rpm = self.rpm + diff * config.launch.rpmBuildRate * dt
        self.rpm = math.min(self.rpm, prof.redlineRPM)
        return
    end

    -- Reverse gear has fixed RPM
    if self.gear == -1 then
        local throttleAbs = math.abs(self.smoothedThrottle)
        self.rpm = prof.idleRPM + throttleAbs * (prof.maxRPM - prof.idleRPM) * 0.4
        return
    end

    -- Cold start redline cap
    local effectiveRedline = prof.redlineRPM
    if settings.physics.coldStart and os.clock() < self._coldStartEndTime then
        local remain = (self._coldStartEndTime - os.clock()) / settings.physics.coldStartDuration
        effectiveRedline = prof.redlineRPM - config.coldStartRedlineDrop * remain
    end

    -- Stationary vs moving
    local speed = self:_getSpeed()
    if speed < 5 then
        if self.smoothedThrottle > 0 then
            local target = prof.idleRPM + self.smoothedThrottle * 2000
            self.rpm = self.rpm + (target - self.rpm) * 6.0 * dt
        else
            self.rpm = self.rpm + (prof.idleRPM - self.rpm) * 5.0 * dt
        end
        self.revLimiterActive = false
        return
    end

    -- Moving: use target from throttle
    local target = prof.idleRPM + self.smoothedThrottle * (prof.maxRPM - prof.idleRPM)
    local diff = target - self.rpm

    if diff > 0 then
        local rate = self:_rpmRiseRate(prof)
        local load = prof.gearRatios[1] / math.max(prof.gearRatios[self.gear] or prof.gearRatios[1], 0.01)
        self.rpm = self.rpm + (diff * rate / math.sqrt(load)) * 10 * dt
    else
        self.rpm = self.rpm + diff * config.rpmFallRate * 10 * dt
    end

    -- Apply bog
    if os.clock() < self._bogUntil then
        local remain = (self._bogUntil - os.clock()) / 0.12
        self.rpm = self.rpm - self._bogMagnitude * remain * dt * 10
    end

    -- Clamp
    self.rpm = math.max(prof.idleRPM * 0.9, math.min(effectiveRedline + 100, self.rpm))
end

function Module:_rpmRiseRate(prof)
    local base = self.core.config.rpmRiseRates[self.gear] or 0.1
    return base * (prof.rpmRiseMultiplier or 1.0)
end

-- ==================== GEAR ====================
function Module:_updateGear(dt, prof)
    if self.shiftCooldown > 0 then return end
    if self.launch.state == LAUNCH_STATES.HOLDING then return end

    local speed = self:_getSpeed()

    -- Reverse detection
    if self.smoothedThrottle < -0.1 and speed < 5 and self.gear ~= -1 then
        self:_doShift(-1, "down", false)
        return
    end
    if self.gear == -1 and self.smoothedThrottle > 0.1 then
        self:_doShift(1, "up", false)
        return
    end

    if speed < 5 then
        if self.gear > 1 then
            self:_doShift(1, "down", false)
        end
        return
    end

    local ratios = prof.gearRatios
    local thresholds = prof.speedThresholds
    local strategy = prof.shiftStrategy or "automatic"

    -- Determine shift points based on strategy
    local upShiftRPM = prof.redlineRPM
    if strategy == "sport" then
        upShiftRPM = prof.redlineRPM - 200
    elseif strategy == "eco" then
        upShiftRPM = prof.redlineRPM - 500
    elseif strategy == "race" then
        upShiftRPM = prof.redlineRPM
    end

    -- Upshift
    if self.gear < 7 and self.rpm >= upShiftRPM then
        if self.gear < #ratios then
            self:_doShift(self.gear + 1, "up", false)
            self._upshiftFlicker = 1.0
            return
        end
    end

    -- Downshift conditions
    if self.gear > 1 and self.gear <= #ratios then
        local shouldDownshift = false
        local emergency = false

        -- Speed too low for current gear
        local prevThreshold = thresholds[self.gear - 1]
        if prevThreshold and speed < prevThreshold - 8 then
            shouldDownshift = true
        end

        -- RPM below lug-protect threshold
        if self.rpm < 2800 then
            local ratio = ratios[self.gear] / ratios[self.gear - 1]
            local predicted = self.rpm * ratio
            if predicted < prof.maxRPM - 400 then
                shouldDownshift = true
            end
        end

        -- Emergency stall protection
        if self.rpm < 1050 then
            shouldDownshift = true
            emergency = true
        end

        -- Hysteresis: don't flicker
        if shouldDownshift and self._downshiftFlicker > 0.3 then
            shouldDownshift = false
        end

        if shouldDownshift then
            local ratio = ratios[self.gear] / ratios[self.gear - 1]
            local predicted = self.rpm * ratio
            if predicted > prof.maxRPM - 400 and not emergency then
                return
            end
            self:_doShift(self.gear - 1, "down", emergency)
            self._downshiftFlicker = 1.0
        end
    end
end

function Module:_doShift(newGear, direction, emergency)
    if newGear == self.gear then return end
    local oldGear = self.gear
    local rpmBefore = self.rpm
    local prof = self.profiles:current()

    self.gear = newGear

    -- RPM adjustment
    if newGear > 0 and oldGear > 0 then
        local ratio = prof.gearRatios[newGear] / prof.gearRatios[oldGear]
        self.rpm = self.rpm * ratio * (1 - self.core.config.upshiftRpmDrop * 0.5)
    elseif newGear == 1 then
        self.rpm = prof.idleRPM
    end

    -- Cooldown
    self.shiftCooldown = self.core.config.shiftCooldown
    self._shiftEvents = self._shiftEvents + 1
    self._lastShiftTime = os.clock()

    -- Clutch simulation
    if self.core.settings.physics.clutchSimulation then
        self.shiftState = "open"
        self.shiftCooldown = math.max(self.shiftCooldown, self.core.settings.physics.clutchDuration)
        -- At end of clutch, RPM drops from slip
        self.rpm = self.rpm * (1 - self.core.config.downshiftSlip * 0.5)
    end

    -- Emit
    _G.VX.bus:emit("vehicle.shift", {
        up        = direction == "up",
        from      = oldGear,
        to        = newGear,
        rpmBefore = rpmBefore,
        rpmAfter  = self.rpm,
        emergency = emergency or false,
    })
end

-- ==================== REV LIMITER ====================
function Module:_updateRevLimiter(dt, prof)
    local throttle = self.smoothedThrottle
    local redline = prof.redlineRPM

    if throttle > 0.7 and self.rpm >= redline then
        if not self.revLimiterActive then
            self.revLimiterActive = true
            self.revLimiterPhase = 0
            _G.VX.bus:emit("engine.revLimit", { active = true })
        end
        self.revLimiterPhase = self.revLimiterPhase + dt

        -- Per-profile limiter type
        local limiterType = prof.revLimiterType or "hard"
        if limiterType == "soft" then
            -- Gentle throttle cut
            self.smoothedThrottle = self.smoothedThrottle * 0.7
        elseif limiterType == "hard" then
            -- Fuel cut pattern
            local phase = self.revLimiterPhase % 0.16
            if phase < 0.08 then
                self.rpm = math.max(redline - 100, self.rpm - 800 * dt)
                self._fuelCutEvents = self._fuelCutEvents + 1
            end
        elseif limiterType == "ignition" then
            -- Hard cut + backfire burst
            local phase = self.revLimiterPhase % 0.20
            if phase < 0.06 then
                self.rpm = redline - 200
                self.smoothedThrottle = 0
                -- Trigger backfire via bus (DriveSystem/Visuals/Audio react)
                _G.VX.bus:emit("vehicle.backfire", { source = "limiter", count = 1 })
            end
        end
    else
        if self.revLimiterActive then
            self.revLimiterActive = false
            _G.VX.bus:emit("engine.revLimit", { active = false })
        end
    end

    -- Clamp to sane range
    self.rpm = math.max(prof.idleRPM * 0.9, math.min(prof.maxRPM + 100, self.rpm))
end

-- ==================== COLD START ====================
function Module:_updateColdStart(dt, prof)
    if not self.core.settings.physics.coldStart then return end
    local now = os.clock()
    if self._coldStartEndTime == 0 then
        -- First tick: start cold period
        self._coldStartEndTime = now + self.core.settings.physics.coldStartDuration
        _G.VX.bus:emit("engine.coldStartBegin", {})
    end
    if now >= self._coldStartEndTime then
        self._coldStartEndTime = 0
        _G.VX.bus:emit("engine.coldStartEnd", {})
    end
end

-- ==================== IDLE HUNT ====================
function Module:_updateIdleHunt(dt, prof)
    if not self.core.settings.physics.idleHunting then return end
    if self.smoothedThrottle > 0.1 then return end
    if self.rpm > prof.idleRPM * 1.4 then return end
    self._idleHuntPhase = self._idleHuntPhase + dt
    local wobble = math.sin(self._idleHuntPhase * 3) * 20
    self.rpm = self.rpm + wobble * dt * 4
end

-- ==================== ENGINE LOAD ====================
function Module:_computeLoadFactor(prof)
    if not self.core.settings.physics.engineLoad then return 1.0 end
    local authority = _G.VX.Authority
    local handle = authority and authority:getHandle()
    if not handle or not handle.root or not handle.root.PrimaryPart then return 1.0 end
    local upY = handle.root.PrimaryPart.CFrame.UpVector.Y
    if upY >= 0.999 then return 1.0 end
    local slope = 1 - upY
    local sens = self.core.settings.physics.engineLoadSensitivity
    return math.max(0.3, 1 - slope * sens * 5)
end

-- ==================== LAUNCH STATE MACHINE ====================
function Module:_updateLaunch(dt)
    local cfg = self.core.config.launch
    local bothPedals = self.input:isBothPedalsHeld()
    local speed = self:_getSpeed()

    local launch = self.launch

    if launch.state == LAUNCH_STATES.IDLE then
        -- Check launch start conditions
        if bothPedals and speed < cfg.minSpeed and self.gear == 1 then
            if os.clock() >= launch.cooldownEnd then
                launch.state = LAUNCH_STATES.ARMING
                launch.startTime = os.clock()
                launch.rpmTarget = math.min(cfg.rpmTarget, self.profiles:current().redlineRPM - 100)
            end
        end
    elseif launch.state == LAUNCH_STATES.ARMING then
        -- Need both held for 0.15s to activate
        if not bothPedals then
            launch.state = LAUNCH_STATES.IDLE
            return
        end
        if os.clock() - launch.startTime >= 0.15 then
            launch.state = LAUNCH_STATES.HOLDING
            launch.rpm = self.rpm
            _G.VX.bus:emit("vehicle.launchStart", { rpm = self.rpm, target = launch.rpmTarget })
        end
    elseif launch.state == LAUNCH_STATES.HOLDING then
        -- During hold, we force attributes to 0 for defensive purposes
        local authority = _G.VX.Authority
        local handle = authority and authority:getHandle()
        if handle and handle.root then
            pcall(function()
                if handle.root:GetAttribute("ThrottleFloat") ~= nil then
                    handle.root:SetAttribute("ThrottleFloat", 0)
                end
            end)
        end

        -- Check for release
        if not bothPedals then
            local accelHeld = self.input:isAccelHeld()
            local brakeHeld = self.input:isBrakeHeld()

            if accelHeld and not brakeHeld then
                -- Brake released, gas held → release
                launch.state = LAUNCH_STATES.RELEASING
                launch.releaseTime = os.clock()

                -- Compute launch quality
                local ratio = self.rpm / launch.rpmTarget
                local quality = "miss"
                if ratio >= cfg.windowPerfectMin and ratio <= cfg.windowPerfectMax then
                    quality = "perfect"
                elseif ratio >= cfg.windowGoodMin and ratio <= cfg.windowGoodMax then
                    quality = "good"
                end

                -- Emit release event
                _G.VX.bus:emit("vehicle.launchRelease", {
                    quality = quality,
                    rpm = self.rpm,
                    ratio = ratio,
                })
                print("[VX] Launch released: " .. quality .. " (rpm " .. math.floor(self.rpm) .. "/" .. launch.rpmTarget .. ")")
            else
                -- Gas released or neither held → cancel
                launch.state = LAUNCH_STATES.IDLE
                launch.cooldownEnd = os.clock() + 0.5
            end
        elseif os.clock() - launch.startTime > cfg.maxTime then
            -- Timeout
            launch.state = LAUNCH_STATES.IDLE
            launch.cooldownEnd = os.clock() + 0.5
        end
    elseif launch.state == LAUNCH_STATES.RELEASING then
        if os.clock() - launch.releaseTime > cfg.releaseDuration then
            launch.state = LAUNCH_STATES.COOLED
            launch.cooldownEnd = os.clock() + 0.3
        end
    elseif launch.state == LAUNCH_STATES.COOLED then
        if os.clock() >= launch.cooldownEnd then
            launch.state = LAUNCH_STATES.IDLE
        end
    end
end

-- ==================== HELPERS ====================
function Module:_getSpeed()
    local authority = _G.VX.Authority
    local handle = authority and authority:getHandle()
    if not handle or not handle.root or not handle.root.PrimaryPart then return 0 end
    local v = handle.root.PrimaryPart.AssemblyLinearVelocity
    return Vector3.new(v.X, 0, v.Z).Magnitude * 0.626
end

-- ==================== PUBLIC API ====================
function Module:getRPM() return self.rpm end
function Module:getGear() return self.gear end
function Module:getSmoothedThrottle() return self.smoothedThrottle end
function Module:isRevLimiting() return self.revLimiterActive end
function Module:getShiftState() return self.shiftState end
function Module:getLaunchState() return self.launch.state end
function Module:getSlopeLoadFactor() return self._loadFactor end

return Module
