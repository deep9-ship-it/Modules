--[[
    VX_Authority v3.0.0
    Takeover of game's VehicleSteering + VehicleControls.
    Caches vehicle parts with aliasing. Restores on exit.

    Depends on: Core
    Exposes:
      takeControl()       → bool, handle
      releaseControl()    → void
      getHandle()         → handle or nil
      isHealthy()         → bool
      verify()            → re-kill if needed

    Emits:
      authority.taken    → { handle }
      authority.lost     → { reason }
      authority.verified → { recovered = bool }
]]

local VX = _G.VX
if not VX or not VX.Framework then error("VX_Authority requires VX_Kernel") end

local CS = game:GetService("CollectionService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Player = Players.LocalPlayer

local Module = VX.Framework.Module.new({
    Name = "Authority",
    Dependencies = { "Core" },
    Version = "3.0.0",
})

-- ==================== PART ALIASES ====================
local ALIASES = {
    FrontLeft  = { "WheelFL", "FrontLeft", "FrontLeftWheel", "FLWheel", "FL" },
    FrontRight = { "WheelFR", "FrontRight", "FrontRightWheel", "FRWheel", "FR" },
    BackLeft   = { "WheelBL", "BackLeft", "RearLeft", "BackLeftWheel", "BLWheel", "BL", "RL" },
    BackRight  = { "WheelBR", "BackRight", "RearRight", "BackRightWheel", "BRWheel", "BR", "RR" },
    Chassis    = { "Chassis" },
    Platform   = { "Platform", "ChassisPlatform", "Base" },
    Mass       = { "Mass", "MassPart", "ChassisMass", "Weight" },
    Wheels     = { "Wheels", "WheelContainer", "WheelGroup" },
    Seats      = { "Seats", "SeatGroup" },
    Body       = { "Body", "CarBody" },
    Emitter    = { "SoundEmmiter", "SoundEmitter" },
    Nitrous    = { "NitrousPoint", "ExhaustPoint", "FlamePoint" },
    VfxAttach  = { "VfxAttachmentPoint", "Attachment" },
}

-- ==================== LIFECYCLE ====================
function Module:Construct()
    self._handle = nil
    self._active = false
    self._verifyThread = nil
    self._getConnections = getconnections
    self._getUpvalues = getupvalues
    self._debugInfo = debug and debug.getinfo
end

function Module:Init(deps)
    self.core = deps.Core
end

function Module:Start()
    _G.VX.Authority = self
end

function Module:Stop()
    if self._active then
        pcall(function() self:releaseControl() end)
    end
    if self._verifyThread then
        pcall(function() task.cancel(self._verifyThread) end)
        self._verifyThread = nil
    end
    if _G.VX.Authority == self then _G.VX.Authority = nil end
end

function Module:heartbeat()
    if not self._active then return true end
    return self._handle ~= nil
end

-- ==================== PUBLIC API ====================
function Module:getHandle()
    return self._handle
end

function Module:isHealthy()
    if not self._handle then return false end
    return self._handle.root and self._handle.root.Parent ~= nil
end

function Module:takeControl()
    if self._active then return true, self._handle end

    local handle, reason = self:_discover()
    if not handle then
        warn("[VX] Authority discover failed: " .. tostring(reason))
        return false, reason
    end

    local killed, killReason = self:_killGameModules(handle)
    if not killed then
        warn("[VX] Authority kill failed: " .. tostring(killReason))
        return false, killReason
    end

    self:_setupTiltWeld(handle)
    self:_adjustMassSize(handle)
    self:_cacheOriginals(handle)

    self._handle = handle
    self._active = true

    -- Start verify loop
    self:_startVerify()

    _G.VX.bus:emit("authority.taken", { handle = handle })
    print("[VX] Authority: takeover complete")
    return true, handle
end

function Module:releaseControl()
    if not self._active then return end

    if self._verifyThread then
        pcall(function() task.cancel(self._verifyThread) end)
        self._verifyThread = nil
    end

    local handle = self._handle
    if handle then
        pcall(function() self:_restoreAll(handle) end)
    end

    self._handle = nil
    self._active = false
    _G.VX.bus:emit("authority.lost", { reason = "release" })
    print("[VX] Authority: released")
end

-- ==================== DISCOVERY ====================
function Module:_discover()
    local char = Player.Character
    if not char then return nil, "no character" end

    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum or not hum.Sit or not hum.SeatPart then
        return nil, "not seated"
    end

    local seat = hum.SeatPart
    if not seat:IsA("VehicleSeat") then
        return nil, "not a VehicleSeat"
    end

    -- Find root
    local root = self:_findAncestorWithChassis(seat)
    if not root then return nil, "no root with Chassis" end

    -- Find chassis
    local chassis = self:_findPart(root, "Chassis")
    if not chassis then return nil, "no Chassis" end

    -- Find platform
    local platform = self:_findPart(chassis, "Platform")
    if not platform then return nil, "no Platform" end

    -- Find mass
    local mass = self:_findPart(chassis, "Mass")
    if not mass then return nil, "no Mass" end

    -- Find wheels folder
    local wheelsFolder = self:_findPart(chassis, "Wheels")
    if not wheelsFolder then return nil, "no Wheels folder" end

    -- Enumerate wheels with aliasing
    local wheels = self:_enumerateWheels(wheelsFolder)
    if #wheels ~= 4 then
        return nil, "expected 4 wheels, found " .. #wheels
    end

    -- Locate emitter / nitrous for audio/vfx
    local body = self:_findPart(root, "Body")
    local emitter = body and self:_findPart(body, "Emitter") or nil
    local nitrous = body and self:_findPart(body, "Nitrous") or nil
    local vfxAttach = nitrous and self:_findPart(nitrous, "VfxAttach") or nil

    return {
        root     = root,
        seat     = seat,
        chassis  = chassis,
        platform = platform,
        mass     = mass,
        wheels   = wheels,
        body     = body,
        emitter  = emitter,
        nitrous  = nitrous,
        vfxAttach = vfxAttach,
    }
end

function Module:_findAncestorWithChassis(inst)
    local cur = inst
    while cur and cur ~= workspace do
        if cur:IsA("Model") and cur:FindFirstChild("Chassis") then
            return cur
        end
        cur = cur.Parent
    end
    return nil
end

function Module:_findPart(parent, aliasKey)
    local aliases = ALIASES[aliasKey]
    if not aliases then return nil end
    for _, name in ipairs(aliases) do
        local found = parent:FindFirstChild(name)
        if found then return found end
    end
    return nil
end

function Module:_enumerateWheels(folder)
    local out = {}
    local found = {
        FrontLeft  = false,
        FrontRight = false,
        BackLeft   = false,
        BackRight  = false,
    }
    for _, child in ipairs(folder:GetChildren()) do
        if not child:IsA("Model") then continue end
        for slot, aliases in pairs({
            FrontLeft  = ALIASES.FrontLeft,
            FrontRight = ALIASES.FrontRight,
            BackLeft   = ALIASES.BackLeft,
            BackRight  = ALIASES.BackRight,
        }) do
            for _, name in ipairs(aliases) do
                if child.Name == name and not found[slot] then
                    local physical = child:FindFirstChild("PhysicalWheel")
                    local spring   = child:FindFirstChild("Spring")
                    local cylinder = child:FindFirstChild("Cylindrical")
                    local attach   = child:FindFirstChild("AttachmentHolder")
                        and child.AttachmentHolder:FindFirstChild("Attachment")
                    if physical and spring and cylinder then
                        table.insert(out, {
                            name       = slot,
                            model      = child,
                            physical   = physical,
                            spring     = spring,
                            cylinder   = cylinder,
                            attach     = attach,
                            isFront    = (slot == "FrontLeft" or slot == "FrontRight"),
                            isLeft     = (slot == "FrontLeft" or slot == "BackLeft"),
                        })
                        found[slot] = true
                    end
                    break
                end
            end
        end
    end
    return out
end

-- ==================== KILL GAME MODULES ====================
function Module:_killGameModules(handle)
    local root = handle.root

    -- 1. Remove tags
    pcall(function()
        CS:RemoveTag(root, "VehicleSteering")
        CS:RemoveTag(root, "VehicleControls")
    end)

    -- 2. Remove tag from MainGUIHandler.VehicleControls too
    pcall(function()
        local gui = Player:WaitForChild("PlayerGui", 3)
        if gui then
            local handler = gui:FindFirstChild("MainGUIHandler")
            if handler then
                local controls = handler:FindFirstChild("VehicleControls")
                if controls then
                    CS:RemoveTag(controls, "VehicleControls")
                end
            end
        end
    end)

    -- 3. Kill matching Heartbeat connections
    local killed = 0
    if self._getConnections and self._debugInfo then
        local conns = self._getConnections(RunService.Heartbeat)
        if conns then
            for _, conn in ipairs(conns) do
                local fn = nil
                pcall(function() fn = conn.Function end)
                if fn then
                    local info = nil
                    pcall(function() info = self._debugInfo(fn) end)
                    if info and info.source then
                        local src = tostring(info.source)
                        if src:find("VehicleSteering") or src:find("VehicleControls") then
                            pcall(function() conn:Disconnect() end)
                            killed = killed + 1
                        end
                    end
                end
            end
        end
    end

    -- 4. Neutralize attributes to prevent game fallback
    pcall(function()
        if root:GetAttribute("ThrottleFloat") ~= nil then
            root:SetAttribute("ThrottleFloat", 0)
        end
        if root:GetAttribute("SteerFloat") ~= nil then
            root:SetAttribute("SteerFloat", 0)
        end
    end)

    if killed == 0 and not self._getConnections then
        warn("[VX] getconnections unavailable — tag removal is the only kill method")
    end

    print("[VX] Authority: killed " .. killed .. " connections")
    return true
end

-- ==================== TILT WELD ====================
function Module:_setupTiltWeld(handle)
    local mass = handle.mass
    local platform = handle.platform
    if not mass or not platform then return end

    local wc = mass:FindFirstChildOfClass("WeldConstraint")
    if wc then
        handle.originalWC = {
            part0 = wc.Part0,
            part1 = wc.Part1,
            name  = wc.Name,
        }
        wc:Destroy()
    end

    local offset = platform.CFrame:Inverse() * mass.CFrame
    local weld = Instance.new("Weld")
    weld.Name = "VX_MassTiltWeld"
    weld.Part0 = platform
    weld.Part1 = mass
    weld.C0 = offset
    weld.C1 = CFrame.new()
    weld.Parent = mass

    handle.tiltWeld   = weld
    handle.neutralC0  = offset
end

function Module:_restoreTiltWeld(handle)
    if handle.tiltWeld then
        pcall(function() handle.tiltWeld:Destroy() end)
        handle.tiltWeld = nil
    end
    if handle.originalWC and handle.mass and handle.mass.Parent then
        local wc = Instance.new("WeldConstraint")
        wc.Name  = handle.originalWC.name or "WeldConstraint"
        wc.Part0 = handle.originalWC.part0
        wc.Part1 = handle.originalWC.part1
        wc.Parent = handle.mass
    end
    handle.originalWC = nil
    handle.neutralC0 = nil
end

-- ==================== MASS ADJUST ====================
function Module:_adjustMassSize(handle)
    if not handle.mass then return end
    handle.originalMassSize = handle.mass.Size
    pcall(function()
        handle.mass.Size = Vector3.new(4, 4, 10)
    end)
end

function Module:_restoreMassSize(handle)
    if handle.originalMassSize and handle.mass and handle.mass.Parent then
        pcall(function() handle.mass.Size = handle.originalMassSize end)
    end
end

-- ==================== CACHE ORIGINALS ====================
function Module:_cacheOriginals(handle)
    handle.originalFriction = {}
    handle.originalSpring   = {}
    for _, w in ipairs(handle.wheels) do
        local props = w.physical.CustomPhysicalProperties
        handle.originalFriction[w.name] = props and props.Friction or 1.0
        handle.originalSpring[w.name] = {
            stiffness = w.spring.Stiffness,
            damping   = w.spring.Damping,
            freeLength = w.spring.FreeLength,
        }
    end
end

-- ==================== RESTORE ====================
function Module:_restoreAll(handle)
    self:_restoreTiltWeld(handle)
    self:_restoreMassSize(handle)

    for _, w in ipairs(handle.wheels or {}) do
        pcall(function()
            if w.cylinder then
                w.cylinder.AngularActuatorType = Enum.ActuatorType.None
                w.cylinder.AngularVelocity = 0
                w.cylinder.MotorMaxTorque = 0
            end
        end)
        pcall(function()
            local origF = handle.originalFriction[w.name]
            if origF and w.physical and w.physical.Parent then
                local props = w.physical.CustomPhysicalProperties
                local d = props and props.Density or 0.7
                local e = props and props.Elasticity or 0.5
                local fw = props and props.FrictionWeight or 2
                local ew = props and props.ElasticityWeight or 1
                w.physical.CustomPhysicalProperties = PhysicalProperties.new(d, origF, e, fw, ew)
            end
        end)
        pcall(function()
            local origS = handle.originalSpring[w.name]
            if origS and w.spring and w.spring.Parent then
                w.spring.Stiffness  = origS.stiffness
                w.spring.Damping    = origS.damping
                w.spring.FreeLength = origS.freeLength
            end
        end)
    end

    -- Restore seat values
    pcall(function()
        if handle.seat then
            if handle.seat:FindFirstChild("MaxSpeed") then
                -- Don't touch; game tracks this
            end
        end
    end)
end

-- ==================== VERIFY LOOP ====================
function Module:_startVerify()
    if self._verifyThread then
        pcall(function() task.cancel(self._verifyThread) end)
    end
    self._verifyThread = task.spawn(function()
        while self._active do
            task.wait(1.5)
            if not self._active then break end
            self:verify()
        end
    end)
end

function Module:verify()
    if not self._active or not self._handle then return end
    local root = self._handle.root
    if not root or not root.Parent then
        -- Vehicle removed
        self:releaseControl()
        return
    end

    -- Check tags still removed
    local tagConflict = false
    if CS:HasTag(root, "VehicleSteering") then tagConflict = true end
    if CS:HasTag(root, "VehicleControls") then tagConflict = true end

    if tagConflict then
        pcall(function()
            CS:RemoveTag(root, "VehicleSteering")
            CS:RemoveTag(root, "VehicleControls")
        end)
        _G.VX.bus:emit("authority.verified", { recovered = true })
        warn("[VX] Authority: tags reappeared, re-killed")
    end

    -- Check heartbeat connections still gone
    local found = 0
    if self._getConnections and self._debugInfo then
        pcall(function()
            local conns = self._getConnections(RunService.Heartbeat)
            if conns then
                for _, conn in ipairs(conns) do
                    local fn = nil
                    pcall(function() fn = conn.Function end)
                    if fn then
                        local info = nil
                        pcall(function() info = self._debugInfo(fn) end)
                        if info and info.source then
                            local src = tostring(info.source)
                            if src:find("VehicleSteering") or src:find("VehicleControls") then
                                found = found + 1
                                pcall(function() conn:Disconnect() end)
                            end
                        end
                    end
                end
            end
        end)
    end
    if found > 0 then
        _G.VX.bus:emit("authority.verified", { recovered = true, count = found })
    end
end

return Module
