-- ==================== ROW BUILDERS ====================
function Module:_addSettingRow(path)
    local schema = _G.VX.registry:get("settings", path)
    if not schema then return end
    local cur = _G.VX.getSetting(path)

    local row = Instance.new("Frame")
    row.Size = UDim2.new(1, 0, 0, (schema.type == "boolean") and 40 or (schema.type == "enum" and 58 or 50))
    row.BackgroundColor3 = THEME.card
    row.BorderSizePixel = 0
    row.LayoutOrder = self:_nextOrder()
    row.Parent = self.scroll
    local rc = Instance.new("UICorner"); rc.CornerRadius = UDim.new(0, 8); rc.Parent = row

    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.new(0.62, 0, 0, 20)
    lbl.Position = UDim2.new(0, 10, 0, (schema.type == "boolean") and 10 or 5)
    lbl.BackgroundTransparency = 1
    lbl.Text = schema.label or path
    lbl.TextColor3 = THEME.text
    lbl.Font = Enum.Font.GothamBold
    lbl.TextSize = 12
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.Parent = row

    local ref = { row = row, schema = schema }

    if schema.type == "boolean" then
        local track = Instance.new("TextButton")
        track.Size = UDim2.new(0, 42, 0, 22)
        track.Position = UDim2.new(1, -52, 0.5, -11)
        track.BackgroundColor3 = cur and THEME.green or THEME.track
        track.Text = ""
        track.AutoButtonColor = false
        track.Parent = row
        local tc = Instance.new("UICorner"); tc.CornerRadius = UDim.new(1, 0); tc.Parent = track

        local knob = Instance.new("Frame")
        knob.Size = UDim2.new(0, 16, 0, 16)
        knob.Position = cur and UDim2.new(1, -19, 0.5, -8) or UDim2.new(0, 3, 0.5, -8)
        knob.BackgroundColor3 = THEME.text
        knob.BorderSizePixel = 0
        knob.Parent = track
        local kc = Instance.new("UICorner"); kc.CornerRadius = UDim.new(1, 0); kc.Parent = knob

        track.MouseButton1Click:Connect(function()
            local nextVal = not _G.VX.getSetting(path)
            _G.VX.setSetting(path, nextVal)
        end)
        ref.toggleTrack = track
        ref.toggleKnob = knob

    elseif schema.type == "number_stepped" then
        local valLbl = Instance.new("TextLabel")
        valLbl.Size = UDim2.new(0, 74, 0, 18)
        valLbl.Position = UDim2.new(1, -142, 0, 16)
        valLbl.BackgroundTransparency = 1
        valLbl.Text = self:_formatNumber(path, cur, schema)
        valLbl.TextColor3 = THEME.text
        valLbl.Font = Enum.Font.GothamBold
        valLbl.TextSize = 11
        valLbl.Parent = row
        ref.valueLabel = valLbl -- Fixed: points to valLbl, not title lbl!

        local function makeStep(txt, x, delta)
            local b = Instance.new("TextButton")
            b.Size = UDim2.new(0, 26, 0, 26)
            b.Position = UDim2.new(1, x, 0, 12)
            b.BackgroundColor3 = THEME.track
            b.Text = txt
            b.TextColor3 = THEME.text
            b.Font = Enum.Font.GothamBold
            b.TextSize = 14
            b.AutoButtonColor = false
            b.Parent = row
            local c = Instance.new("UICorner"); c.CornerRadius = UDim.new(0, 6); c.Parent = b
            b.MouseButton1Click:Connect(function()
                local v = (_G.VX.getSetting(path) or schema.default) + delta
                v = math.clamp(v, schema.min, schema.max)
                _G.VX.setSetting(path, v)
            end)
        end
        makeStep("-", -64, -(schema.step or 0.1))
        makeStep("+", -34, (schema.step or 0.1))

    elseif schema.type == "number_range" then
        local valLbl = Instance.new("TextLabel")
        valLbl.Size = UDim2.new(0, 64, 0, 18)
        valLbl.Position = UDim2.new(1, -74, 0, 5)
        valLbl.BackgroundTransparency = 1
        valLbl.Text = self:_formatNumber(path, cur, schema)
        valLbl.TextColor3 = THEME.text
        valLbl.Font = Enum.Font.GothamBold
        valLbl.TextSize = 11
        valLbl.TextXAlignment = Enum.TextXAlignment.Right
        valLbl.Parent = row
        ref.valueLabel = valLbl

        local track = Instance.new("Frame")
        track.Size = UDim2.new(1, -24, 0, 6)
        track.Position = UDim2.new(0, 12, 0, 32)
        track.BackgroundColor3 = THEME.track
        track.BorderSizePixel = 0
        track.Parent = row
        local tc = Instance.new("UICorner"); tc.CornerRadius = UDim.new(0, 3); tc.Parent = track

        local pct = math.clamp((cur - schema.min) / math.max(schema.max - schema.min, 0.001), 0, 1)
        local fill = Instance.new("Frame")
        fill.Size = UDim2.new(pct, 0, 1, 0)
        fill.BackgroundColor3 = THEME.accent
        fill.BorderSizePixel = 0
        fill.Parent = track
        local fc = Instance.new("UICorner"); fc.CornerRadius = UDim.new(0, 3); fc.Parent = fill

        local thumb = Instance.new("Frame")
        thumb.Size = UDim2.new(0, 14, 0, 14)
        thumb.Position = UDim2.new(pct, -7, 0.5, -7)
        thumb.BackgroundColor3 = THEME.text
        thumb.BorderSizePixel = 0
        thumb.Parent = track
        local thc = Instance.new("UICorner"); thc.CornerRadius = UDim.new(1, 0); thc.Parent = thumb

        ref.sliderFill = fill
        ref.sliderThumb = thumb

        local hit = Instance.new("TextButton")
        hit.Size = UDim2.new(1, 8, 0, 24)
        hit.Position = UDim2.new(0, -4, 0.5, -12)
        hit.BackgroundTransparency = 1
        hit.Text = ""
        hit.Parent = track

        local sliding = false
        local function applyX(x)
            local p = math.clamp((x - track.AbsolutePosition.X) / math.max(track.AbsoluteSize.X, 1), 0, 1)
            local v = schema.min + p * (schema.max - schema.min)
            if schema.step then v = math.floor(v / schema.step + 0.5) * schema.step end
            v = math.clamp(v, schema.min, schema.max)
            _G.VX.setSetting(path, v)
        end

        hit.InputBegan:Connect(function(inp)
            if inp.UserInputType == Enum.UserInputType.MouseButton1
                or inp.UserInputType == Enum.UserInputType.Touch then
                sliding = true
                applyX(inp.Position.X)
            end
        end)
        self:_trackConn(UIS.InputChanged:Connect(function(inp)
            if sliding and (inp.UserInputType == Enum.UserInputType.MouseMovement
                or inp.UserInputType == Enum.UserInputType.Touch) then
                applyX(inp.Position.X)
            end
        end))
        self:_trackConn(UIS.InputEnded:Connect(function(inp)
            if inp.UserInputType == Enum.UserInputType.MouseButton1
                or inp.UserInputType == Enum.UserInputType.Touch then
                sliding = false
            end
        end))

    elseif schema.type == "enum" then
        local opts = schema.options or {}
        local w = 1 / math.max(#opts, 1)
        ref.enumBtns = {}
        for i, opt in ipairs(opts) do
            local b = Instance.new("TextButton")
            b.Size = UDim2.new(w, -6, 0, 24)
            b.Position = UDim2.new((i - 1) * w, 8, 0, 28)
            b.BackgroundColor3 = (cur == opt) and THEME.accent or THEME.track
            b.Text = opt
            b.TextColor3 = (cur == opt) and THEME.text or THEME.textDim
            b.Font = Enum.Font.GothamBold
            b.TextSize = 10
            b.AutoButtonColor = false
            b.Parent = row
            local c = Instance.new("UICorner"); c.CornerRadius = UDim.new(0, 5); c.Parent = b
            b.MouseButton1Click:Connect(function()
                _G.VX.setSetting(path, opt)
            end)
            ref.enumBtns[opt] = b
        end
    end

    self.rowRefs[path] = ref
end

function Module:_formatNumber(_path, val, schema)
    val = tonumber(val) or 0
    if schema.unit == "%" then return string.format("%d%%", math.floor(val * 100 + 0.5))
    elseif schema.unit == "RPM" then return string.format("%d RPM", math.floor(val + 0.5))
    elseif schema.unit == "x" then return string.format("%.2fx", val)
    else return string.format("%.2f", val) end
end

function Module:_onSettingChange(evt)
    if evt.path == "engineProfile" then
        local all = self.profiles:getAll()
        local prof = all[evt.new]
        if self.activeProfileLbl and prof then
            self.activeProfileLbl.Text = string.format("%s  ·  %d RPM", prof.name, prof.maxRPM)
        end
        for idx, btn in pairs(self.profileChips) do
            local act = (idx == evt.new)
            btn.BackgroundColor3 = act and THEME.accent or THEME.card
            btn.TextColor3 = act and THEME.text or THEME.textDim
        end
    elseif evt.path == "turboStage" then
        for st, btn in pairs(self.turboBtns) do
            local act = (st == evt.new)
            btn.BackgroundColor3 = act and THEME.accent or THEME.track
            btn.TextColor3 = act and THEME.text or THEME.textDim
        end
    end

    local cached = self.rowRefs[evt.path]
    if not cached then return end
    local schema = cached.schema

    if cached.valueLabel then
        cached.valueLabel.Text = self:_formatNumber(evt.path, evt.new, schema)
    end
    if cached.sliderFill and schema.max and schema.min then
        local pct = math.clamp((evt.new - schema.min) / math.max(schema.max - schema.min, 0.001), 0, 1)
        cached.sliderFill.Size = UDim2.new(pct, 0, 1, 0)
        if cached.sliderThumb then
            cached.sliderThumb.Position = UDim2.new(pct, -7, 0.5, -7)
        end
    end
    if cached.toggleTrack and cached.toggleKnob then
        local on = (evt.new == true)
        TweenService:Create(cached.toggleTrack, TweenInfo.new(0.14), {
            BackgroundColor3 = on and THEME.green or THEME.track
        }):Play()
        TweenService:Create(cached.toggleKnob, TweenInfo.new(0.14, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
            Position = on and UDim2.new(1, -19, 0.5, -8) or UDim2.new(0, 3, 0.5, -8)
        }):Play()
    end
    if cached.enumBtns then
        for opt, btn in pairs(cached.enumBtns) do
            local act = (opt == evt.new)
            btn.BackgroundColor3 = act and THEME.accent or THEME.track
            btn.TextColor3 = act and THEME.text or THEME.textDim
        end
    end
end

return Module
