-- ==================== PINNED FOOTER BAR ====================
function Module:_createFooter(parent)
    local footer = Instance.new("Frame")
    footer.Size = UDim2.new(1, -24, 0, 42)
    footer.Position = UDim2.new(0, 12, 1, -50)
    footer.BackgroundColor3 = THEME.card
    footer.BorderSizePixel = 0
    footer.Parent = parent
    local fc = Instance.new("UICorner"); fc.CornerRadius = UDim.new(0, 8); fc.Parent = footer
    local fs = Instance.new("UIStroke"); fs.Color = THEME.border; fs.Thickness = 1; fs.Parent = footer

    local function makeBtn(text, xScale, wScale, bg, fn)
        local b = Instance.new("TextButton")
        b.Size = UDim2.new(wScale, -6, 0, 28)
        b.Position = UDim2.new(xScale, 3, 0.5, -14)
        b.BackgroundColor3 = bg
        b.Text = text
        b.TextColor3 = THEME.text
        b.Font = Enum.Font.GothamBold
        b.TextSize = 11
        b.AutoButtonColor = false
        b.Parent = footer
        local bc = Instance.new("UICorner"); bc.CornerRadius = UDim.new(0, 6); bc.Parent = b
        b.MouseButton1Click:Connect(function() fn(b) end)
        return b
    end

    makeBtn("Save", 0, 0.31, Color3.fromRGB(36, 40, 50), function()
        self.profiles:savePreset("Custom1")
        self:_notify("Preset 'Custom1' saved", 2, "success")
    end)

    makeBtn("Load", 0.31, 0.31, Color3.fromRGB(36, 40, 50), function()
        local ok = self.profiles:loadPreset("Custom1")
        if ok then
            self:_notify("Preset 'Custom1' loaded", 2, "success")
            self:_switchTab(self.activeTab)
        else
            self:_notify("No saved preset found", 2, "warn")
        end
    end)

    local resetBtn
    resetBtn = makeBtn("Reset All", 0.62, 0.38, THEME.accentDark, function()
        local now = os.clock()
        if now > self._resetConfirmUntil then
            self._resetConfirmUntil = now + 2.5
            resetBtn.Text = "Confirm?"
            resetBtn.BackgroundColor3 = THEME.accent
            task.delay(2.6, function()
                if resetBtn.Parent and os.clock() > self._resetConfirmUntil then
                    resetBtn.Text = "Reset All"
                    resetBtn.BackgroundColor3 = THEME.accentDark
                end
            end)
            return
        end
        self._resetConfirmUntil = 0
        resetBtn.Text = "Reset All"
        resetBtn.BackgroundColor3 = THEME.accentDark
        _G.VX.resetAll()
        self:_switchTab(self.activeTab)
        self:_notify("All settings reset", 2, "warn")
    end)
end

-- ==================== OPEN / CLOSE ====================
function Module:open()
    self.openState = true
    if self.slideInSound then pcall(function() self.slideInSound:Play() end) end
    TweenService:Create(self.panel, TweenInfo.new(0.24, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
        Position = UDim2.new(1, -360, 0, 12),
    }):Play()
end

function Module:close()
    self.openState = false
    if self.slideOutSound then pcall(function() self.slideOutSound:Play() end) end
    TweenService:Create(self.panel, TweenInfo.new(0.2, Enum.EasingStyle.Quart, Enum.EasingDirection.In), {
        Position = UDim2.new(1, 20, 0, 12),
    }):Play()
end

function Module:toggle()
    if self.openState then self:close() else self:open() end
end

function Module:isOpen() return self.openState end

-- ==================== TAB SWITCHING ====================
function Module:_switchTab(name)
    self.activeTab = name
    self._layoutOrder = 0
    local info = self.tabButtons[name]
    if info and self.tabUnderline then
        local tabW = 1 / #TABS
        TweenService:Create(self.tabUnderline, TweenInfo.new(0.2, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
            Position = UDim2.new((info.idx - 1) * tabW, 6, 1, -2),
        }):Play()
    end

    for k, entry in pairs(self.tabButtons) do
        entry.btn.TextColor3 = (k == name) and THEME.text or THEME.textMuted
    end

    for _, c in ipairs(self.scroll:GetChildren()) do
        if c:IsA("GuiObject") then c:Destroy() end
    end
    self.rowRefs = {}
    self.profileChips = {}
    self.turboBtns = {}
    self.activeProfileLbl = nil

    if name == "Dynamics" then self:_buildDynamics()
    elseif name == "Engine" then self:_buildEngine()
    elseif name == "Audio" then self:_buildAudio()
    elseif name == "System" then self:_buildSystem() end
end

