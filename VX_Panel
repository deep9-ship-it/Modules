function Module:heartbeat()
    return self._gui ~= nil and self._gui.Parent ~= nil
end

function Module:Stop()
    self:_clearConns()
    if self._slideInSound then pcall(function() self._slideInSound:Destroy() end); self._slideInSound = nil end
    if self._slideOutSound then pcall(function() self._slideOutSound:Destroy() end); self._slideOutSound = nil end
    if self._gui then
        self._gui:Destroy()
        self._gui = nil
    end
    _G.VX.Panel = nil
end

return Module
