--[[
    VX_Panel v3.0.0
    Six-tab settings panel, auto-generated from the registry.

    Depends on: Core, Profiles, Powertrain, DriveSystem, Chassis
    Exposes:
      open()
      close()
      isOpen()

    Design:
      - Slide-in from left, slide-out on close
      - Six tabs: Dynamics, Physics, Audio, Engine, Controls, Lights
      - Auto-generates rows from registry:getAll("settings") by category
      - Special rows: engine profile, turbo stage, weight transfer mode, brake bias
      - Reset Grip button in Dynamics tab
      - Live updates: listens for settings.changed to refresh row values
]]

local VX = _G.VX
if not VX or not VX.Framework then error("VX_Panel requires VX_Kernel") end

local TweenService = game:GetService("TweenService")
local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local Player = Players.LocalPlayer

local Module = VX.Framework.Module.new({
    Name = "Panel",
    Dependencies = { "Core", "Profiles", "Powertrain", "DriveSystem", "Chassis" },
    Version = "3.0.0",
})

-- ==================== STATE ====================
function Module:Construct()
    self.panel = nil
    self.tabBar = nil
    self.contentFrame = nil
    self.tabContents = {}  -- [tabName] = scrolling frame
    self.tabButtons = {}   -- [tabName] = button
    self.activeTab = "Dynamics"
    self.isPanelOpen = false
    self.tweenIn = nil
    self.tweenOut = nil
    self.slideInSound = nil
    self.slideOutSound = nil

    -- Cached rows for live refresh: [key] = { valueLabel, updater }
    self.rowRefs = {}
end

function Module:Init(deps)
    self.core     = deps.Core
    self.profiles = deps.Profiles
    self.powertrain = deps.Powertrain
    self.drive    = deps.DriveSystem
    self.chassis  = deps.Chassis
end

function Module:Start()
    _G.VX.Panel = self

    self:_createSounds()
    self:_createPanel()

    _G.VX.bus:on("settings.changed", function(evt) self:_onSettingChange(evt) end)

    print("[VX] Panel ready")
end

function Module:Stop()
    if self.panel then
        pcall(function() self.panel:Destroy() end)
        self.panel = nil
    end
    if _G.VX.Panel == self then _G.VX.Panel = nil end
end

function Module:heartbeat()
    return true
end

-- ==================== HELPERS ====================
local function corner(obj, r)
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, r or 8)
    c.Parent = obj
    return c
end

local function stroke(obj, col, thick)
    local s = Instance.new("UIStroke")
    s.Color = col or Color3.fromRGB(100, 200, 255)
    s.Thickness = thick or 2
    s.Transparency = 0.3
    s.Parent = obj
    return s
end

function Module:_createSounds()
    local function make(id)
        local s = Instance.new("Sound")
        s.SoundId = "rbxassetid://" .. id
        s.Volume = 0.8
        s.Parent = Player:WaitForChild("PlayerGui")
        return s
    end
    pcall(function()
        self.slideInSound = make("139821129588664")
        self.slideOutSound = make("77985512666301")
    end)
end

-- ==================== PANEL CREATION ====================
function Module:_createPanel()
    local p = Instance.new("Frame")
    p.Name = "VXSettingsPanel"
    p.Size = UDim2.new(0.35, 0, 0.65, 0)
    p.Position = UDim2.new(-0.35, 0, 0.17, 0)
    p.BackgroundColor3 = Color3.fromRGB(8, 8, 12)
    p.BackgroundTransparency = 0.1
    p.BorderSizePixel = 0
    p.ZIndex = 30
    p.Visible = false
    corner(p, 12)
    stroke(p, Color3.fromRGB(100, 200, 255), 2)
    p.Parent = _G.VX.UI.gui

    -- Tab bar
    local tabBar = Instance.new("Frame")
    tabBar.Name = "TabBar"
    tabBar.Size = UDim2.new(1, 0, 0.10, 0)
    tabBar.BackgroundTransparency = 1
    tabBar.ZIndex = 31
    tabBar.Parent = p

    local tabs = { "Dynamics", "Physics", "Audio", "Engine", "Controls", "Lights" }
    local tabWidth = 1 / #tabs
    for i, name in ipairs(tabs) do
        local btn = Instance.new("TextButton")
        btn.Name = name .. "Tab"
        btn.Size = UDim2.new(tabWidth, 0, 1, 0)
        btn.Position = UDim2.new(tabWidth * (i-1), 0, 0, 0)
        btn.Text = name
        btn.TextColor3 = Color3.fromRGB(255, 255, 255)
        btn.BackgroundColor3 = Color3.fromRGB(20, 20, 25)
        btn.BackgroundTransparency = 0.3
        btn.TextScaled = true
        btn.Font = Enum.Font.GothamBold
        btn.AutoButtonColor = false
        btn.ZIndex = 32
        corner(btn, 6)
        btn.Parent = tabBar
        self.tabButtons[name] = btn

        btn.MouseButton1Click:Connect(function()
            self:_switchTab(name)
        end)
    end

    -- Content frame
    local content = Instance.new("Frame")
    content.Name = "Content"
    content.Size = UDim2.new(1, -12, 0.90, -8)
    content.Position = UDim2.new(0, 6, 0.10, 4)
    content.BackgroundTransparency = 1
    content.ZIndex = 31
    content.Parent = p

    -- Scrolling frame per tab
    for _, name in ipairs(tabs) do
        local scroll = Instance.new("ScrollingFrame")
        scroll.Name = name .. "Scroll"
        scroll.Size = UDim2.new(1, 0, 1, 0)
        scroll.BackgroundTransparency = 1
        scroll.BorderSizePixel = 0
        scroll.ScrollBarThickness = 6
        scroll.ScrollBarImageColor3 = Color3.fromRGB(100, 200, 255)
        scroll.CanvasSize = UDim2.new(0, 0, 0, 0)
        scroll.Visible = false
        scroll.ZIndex = 32
        scroll.Parent = content
        self.tabContents[name] = scroll
    end

    -- Close button (top-right corner)
    local close = Instance.new("TextButton")
    close.Size = UDim2.new(0, 28, 0, 28)
    close.Position = UDim2.new(1, -32, 0, 6)
    close.Text = "✕"
    close.TextColor3 = Color3.fromRGB(255, 100, 100)
    close.BackgroundColor3 = Color3.fromRGB(40, 20, 20)
    close.TextScaled = true
    close.Font = Enum.Font.GothamBold
    close.AutoButtonColor = false
    close.ZIndex = 33
    corner(close, 14)
    close.Parent = p
    close.MouseButton1Click:Connect(function() self:close() end)

    self.panel = p
    self.tabBar = tabBar
    self.contentFrame = content

    self:_switchTab("Dynamics")
end

-- ==================== TAB SWITCH ====================
function Module:_switchTab(name)
    self.activeTab = name
    for tabName, btn in pairs(self.tabButtons) do
        btn.BackgroundColor3 = (tabName == name)
            and Color3.fromRGB(60, 160, 255) or Color3.fromRGB(20, 20, 25)
    end
    for tabName, scroll in pairs(self.tabContents) do
        scroll.Visible = (tabName == name)
    end
    self:_buildTab(name)
end

-- ==================== TAB BUILDING ====================
function Module:_buildTab(name)
    local scroll = self.tabContents[name]
    if not scroll then return end

    -- Clear existing
    for _, child in ipairs(scroll:GetChildren()) do
        if child:IsA("Frame") or child:IsA("TextLabel") or child:IsA("TextButton") then
            child:Destroy()
        end
    end
    self.rowRefs = self.rowRefs or {}

    local y = 6

    if name == "Dynamics" then
        y = self:_buildDynamics(scroll, y)
    elseif name == "Physics" then
        y = self:_buildPhysics(scroll, y)
    elseif name == "Audio" then
        y = self:_buildAudio(scroll, y)
    elseif name == "Engine" then
        y = self:_buildEngine(scroll, y)
    elseif name == "Controls" then
        y = self:_buildControls(scroll, y)
    elseif name == "Lights" then
        y = self:_buildLights(scroll, y)
    end

    scroll.CanvasSize = UDim2.new(0, 0, 0, y + 10)
end

