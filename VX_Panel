--[[
    VX_Panel.lua — Left-Side GT3 Tuning Panel (All 45 Settings Across 5 Tabs)
    Version: 3.3.2
]]

local VX = _G.VX
if not VX or not VX.Framework then
    error("[VX_Panel] Requires VX_Kernel")
end

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local Module = VX.Framework.Module.new({
    Name = "Panel",
    Dependencies = { "Core", "Profiles", "Powertrain", "DriveSystem", "Chassis", "UI" },
    Version = "3.3.2",
})

local C = {
    bg = Color3.fromRGB(13, 15, 21),
    panel = Color3.fromRGB(20, 24, 34),
    row = Color3.fromRGB(27, 32, 45),
    rowAlt = Color3.fromRGB(34, 40, 56),
    accent = Color3.fromRGB(0, 190, 255),
    green = Color3.fromRGB(68, 222, 122),
    amber = Color3.fromRGB(255, 185, 48),
    red = Color3.fromRGB(255, 72, 72),
    text = Color3.fromRGB(242, 246, 252),
    muted = Color3.fromRGB(135, 146, 168),
    border = Color3.fromRGB(48, 56, 76),
}

local TABS = { "Dynamics", "Engine", "Audio", "Visuals", "System" }

local function _corner(parent, r)
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, r or 8)
    c.Parent = parent
    return c
end

local function _stroke(parent, col, trans, thickness)
    local s = Instance.new("UIStroke")
    s.Color = col or C.border
    s.Transparency = trans or 0.55
    s.Thickness = thickness or 1
    s.Parent = parent
    return s
end

function Module:_trackConn(conn)
    if conn then table.insert(self._conns, conn) end
    return conn
end

function Module:_clearConns()
    for _, c in ipairs(self._conns) do
        if typeof(c) == "RBXScriptConnection" then
            c:Disconnect()
        elseif type(c) == "table" and c.Disconnect then
            c:Disconnect()
        end
    end
    self._conns = {}
end

function Module:_getSpeed()
    local auth = _G.VX.Authority
    local root = auth and auth:getRoot()
    if root and root.PrimaryPart then
        local raw = root.PrimaryPart.AssemblyLinearVelocity.Magnitude
        local units = _G.VX.getSetting and _G.VX.getSetting("ui.units") or "KMH"
        return (units == "MPH") and (raw * 0.389) or (raw * 0.626), units
    end
    return 0, (_G.VX.getSetting and _G.VX.getSetting("ui.units") or "KMH")
end

function Module:Construct()
    self._conns = {}
    self._gui = nil
    self._panel = nil
    self._toggleBtn = nil
    self._scroll = nil
    self._sysInfoLbl = nil
    self._isOpen = false
    self._activeTab = "Dynamics"
    self._tabBtns = {}
    self._profileCards = {}
    self._rowUpdaters = {}
    self._lastSysUpdate = 0
end

function Module:Init(deps)
    self.core = deps.Core
    self.profiles = deps.Profiles
    self.powertrain = deps.Powertrain
    self.drive = deps.DriveSystem
    self.chassis = deps.Chassis
    self.ui = deps.UI
    _G.VX.Panel = self
end

function Module:Start()
    self:_createPanel()

    self:_trackConn(_G.VX.bus:on("settings.changed", function(evt)
        if evt and evt.path and self._rowUpdaters[evt.path] then
            pcall(self._rowUpdaters[evt.path])
        end
    end))

    self:_trackConn(_G.VX.bus:on("profiles.changed", function()
        self:_refreshProfileCards()
    end))

    self:_trackConn(UserInputService.InputBegan:Connect(function(input, gp)
        if gp then return end
        if input.KeyCode == Enum.KeyCode.F5 then
            self:toggle()
        end
    end))

    self:_trackConn(RunService.Heartbeat:Connect(function()
        if self._isOpen and self._activeTab == "System" and self._sysInfoLbl then
            local now = os.clock()
            if now - self._lastSysUpdate >= 0.3 then
                self._lastSysUpdate = now
                self:_refreshSystemCard()
            end
        end
    end))
end

function Module:setHidden(hidden)
    if self._gui then
        self._gui.Enabled = not hidden
    end
end

function Module:_refreshAllRows()
    for _, fn in pairs(self._rowUpdaters) do
        pcall(fn)
    end
    self:_refreshProfileCards()
end

function Module:_refreshProfileCards()
    local activeIdx = self.profiles:getCurrentIndex()
    for idx, card in pairs(self._profileCards) do
        if card and card.btn and card.btn.Parent then
            local sel = (idx == activeIdx)
            card.btn.BackgroundColor3 = sel and C.accent or C.row
            card.nameLbl.TextColor3 = sel and C.bg or C.text
            card.subLbl.TextColor3 = sel and C.bg or C.muted
        end
    end
end

function Module:_refreshSystemCard()
    if not self._sysInfoLbl or not self._sysInfoLbl.Parent then return end
    local vs = _G.VX.Modules and _G.VX.Modules.VehicleState
    local st = vs and vs:get() or "Unknown"
    local spd, units = self:_getSpeed()
    local prof = self.profiles:current()
    local status = _G.VX.getStatus and _G.VX.getStatus()
    local modCount = (status and status.modules) and #status.modules or 0
    self._sysInfoLbl.Text = string.format(
        "Kernel v%s  |  Modules: %d\nState: %s  |  Speed: %.0f %s\nRPM: %d  |  Gear: %s\nActive Profile: %s",
        tostring(_G.VX.Version),
        modCount,
        st,
        spd,
        units,
        math.floor(self.powertrain.rpm or 0),
        (self.powertrain.gear == -1) and "R" or ((self.powertrain.gear == 0) and "N" or tostring(self.powertrain.gear or 1)),
        prof and prof.name or "Default"
    )
end

function Module:_createPanel()
    local player = Players.LocalPlayer
    local pg = player and player:WaitForChild("PlayerGui", 5)
    if not pg then return end

    local existing = pg:FindFirstChild("VX_Panel")
    if existing then existing:Destroy() end

    local gui = Instance.new("ScreenGui")
    gui.Name = "VX_Panel"
    gui.ResetOnSpawn = false
    gui.IgnoreGuiInset = true
    gui.DisplayOrder = 10
    gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    gui.Parent = pg
    self._gui = gui

    local btn = Instance.new("TextButton")
    btn.Name = "ToggleBtn"
    btn.Size = UDim2.new(0, 44, 0, 44)
    btn.AnchorPoint = Vector2.new(0, 0.5)
    btn.Position = UDim2.new(0, 14, 0.5, 0)
    btn.BackgroundColor3 = C.bg
    btn.BackgroundTransparency = 0.08
    btn.Font = Enum.Font.GothamBlack
    btn.TextSize = 14
    btn.TextColor3 = C.accent
    btn.Text = "VX"
    btn.Parent = gui
    _corner(btn, 10)
    _stroke(btn, C.accent, 0.35, 1.2)
    self._toggleBtn = btn
    self:_trackConn(btn.MouseButton1Click:Connect(function() self:toggle() end))

    local panel = Instance.new("Frame")
    panel.Name = "MainPanel"
    panel.Size = UDim2.new(0, 348, 0.84, 0)
    panel.AnchorPoint = Vector2.new(0, 0.5)
    panel.Position = UDim2.new(0, -368, 0.5, 0)
    panel.BackgroundColor3 = C.bg
    panel.BackgroundTransparency = 0.05
    panel.Visible = false
    panel.Parent = gui
    _corner(panel, 12)
    _stroke(panel, C.accent, 0.45, 1.2)
    self._panel = panel

    local sizeConstraint = Instance.new("UISizeConstraint")
    sizeConstraint.MinSize = Vector2.new(320, 360)
    sizeConstraint.MaxSize = Vector2.new(364, 580)
    sizeConstraint.Parent = panel

    local header = Instance.new("Frame")
    header.Size = UDim2.new(1, 0, 0, 42)
    header.BackgroundColor3 = C.panel
    header.BorderSizePixel = 0
    header.Parent = panel
    _corner(header, 12)

    local title = Instance.new("TextLabel")
    title.Size = UDim2.new(1, -90, 1, 0)
    title.Position = UDim2.new(0, 14, 0, 0)
    title.BackgroundTransparency = 1
    title.Font = Enum.Font.GothamBlack
    title.TextSize = 13
    title.TextXAlignment = Enum.TextXAlignment.Left
    title.TextColor3 = C.text
    title.Text = "VX // GT3 TUNING"
    title.Parent = header

    local hint = Instance.new("TextLabel")
    hint.Size = UDim2.new(0, 36, 0, 20)
    hint.Position = UDim2.new(1, -76, 0, 11)
    hint.BackgroundColor3 = C.row
    hint.Font = Enum.Font.GothamBold
    hint.TextSize = 10
    hint.TextColor3 = C.muted
    hint.Text = "F5"
    hint.Parent = header
    _corner(hint, 4)

    local closeBtn = Instance.new("TextButton")
    closeBtn.Size = UDim2.new(0, 28, 0, 28)
    closeBtn.Position = UDim2.new(1, -34, 0, 7)
    closeBtn.BackgroundColor3 = C.row
    closeBtn.Font = Enum.Font.GothamBold
    closeBtn.TextSize = 13
    closeBtn.TextColor3 = C.muted
    closeBtn.Text = "X"
    closeBtn.Parent = header
    _corner(closeBtn, 6)
    self:_trackConn(closeBtn.MouseButton1Click:Connect(function() self:close() end))

    local tabBar = Instance.new("Frame")
    tabBar.Size = UDim2.new(1, -16, 0, 30)
    tabBar.Position = UDim2.new(0, 8, 0, 48)
    tabBar.BackgroundTransparency = 1
    tabBar.Parent = panel

    local tabLayout = Instance.new("UIListLayout")
    tabLayout.FillDirection = Enum.FillDirection.Horizontal
    tabLayout.Padding = UDim.new(0, 4)
    tabLayout.Parent = tabBar

    for _, tabName in ipairs(TABS) do
        local tBtn = Instance.new("TextButton")
        tBtn.Size = UDim2.new(1 / #TABS, -4, 1, 0)
        tBtn.BackgroundColor3 = C.row
        tBtn.Font = Enum.Font.GothamBold
        tBtn.TextSize = 11
        tBtn.TextColor3 = C.muted
        tBtn.Text = tabName
        tBtn.Parent = tabBar
        _corner(tBtn, 6)
        self._tabBtns[tabName] = tBtn
        self:_trackConn(tBtn.MouseButton1Click:Connect(function()
            self:_switchTab(tabName)
        end))
    end

    local scroll = Instance.new("ScrollingFrame")
    scroll.Size = UDim2.new(1, -16, 1, -134)
    scroll.Position = UDim2.new(0, 8, 0, 84)
    scroll.BackgroundTransparency = 1
    scroll.ScrollBarThickness = 4
    scroll.ScrollBarImageColor3 = C.accent
    scroll.AutomaticCanvasSize = Enum.AutomaticSize.Y
    scroll.CanvasSize = UDim2.new(0, 0, 0, 0)
    scroll.Parent = panel

    local list = Instance.new("UIListLayout")
    list.Padding = UDim.new(0, 6)
    list.Parent = scroll

    local pad = Instance.new("UIPadding")
    pad.PaddingRight = UDim.new(0, 4)
    pad.PaddingBottom = UDim.new(0, 6)
    pad.Parent = scroll
    self._scroll = scroll

    self:_createFooter(panel)
    self:_switchTab("Dynamics")
end

function Module:_createFooter(panel)
    local footer = Instance.new("Frame")
    footer.Size = UDim2.new(1, -16, 0, 36)
    footer.Position = UDim2.new(0, 8, 1, -44)
    footer.BackgroundTransparency = 1
    footer.Parent = panel

    local fLayout = Instance.new("UIListLayout")
    fLayout.FillDirection = Enum.FillDirection.Horizontal
    fLayout.Padding = UDim.new(0, 6)
    fLayout.Parent = footer

    local function footerBtn(text, col, fn)
        local b = Instance.new("TextButton")
        b.Size = UDim2.new(1 / 3, -4, 1, 0)
        b.BackgroundColor3 = C.panel
        b.Font = Enum.Font.GothamBold
        b.TextSize = 11
        b.TextColor3 = col
        b.Text = text
        b.Parent = footer
        _corner(b, 7)
        _stroke(b, col, 0.5)
        self:_trackConn(b.MouseButton1Click:Connect(fn))
    end

    footerBtn("Save", C.green, function()
        if self.profiles:savePreset("Custom1") then
            self.ui:notify("Preset", "Saved Custom1", C.green, 2)
        end
    end)
    footerBtn("Load", C.accent, function()
        if self.profiles:loadPreset("Custom1") then
            self.ui:notify("Preset", "Loaded Custom1", C.accent, 2)
            self:_refreshAllRows()
        else
            self.ui:notify("Preset", "No Custom1 preset saved", C.amber, 2)
        end
    end)
    footerBtn("Reset All", C.amber, function()
        _G.VX.resetAll()
        self.ui:notify("System", "All settings reset to defaults", C.amber, 2)
        self:_refreshAllRows()
    end)
end

function Module:open()
    if not self._panel then return end
    self._isOpen = true
    self._panel.Visible = true
    TweenService:Create(self._panel, TweenInfo.new(0.24, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
        Position = UDim2.new(0, 14, 0.5, 0),
    }):Play()
    if self._toggleBtn then
        TweenService:Create(self._toggleBtn, TweenInfo.new(0.24, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
            Position = UDim2.new(0, 368, 0.5, 0),
        }):Play()
    end
end

function Module:close()
    if not self._panel then return end
    self._isOpen = false
    local tw = TweenService:Create(self._panel, TweenInfo.new(0.22, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
        Position = UDim2.new(0, -368, 0.5, 0),
    })
    tw:Play()
    if self._toggleBtn then
        TweenService:Create(self._toggleBtn, TweenInfo.new(0.22, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
            Position = UDim2.new(0, 14, 0.5, 0),
        }):Play()
    end
    tw.Completed:Once(function()
        if not self._isOpen and self._panel then
            self._panel.Visible = false
        end
    end)
end

function Module:toggle()
    if self._isOpen then self:close() else self:open() end
end

function Module:_switchTab(tabName)
    self._activeTab = tabName
    self._rowUpdaters = {}
    self._profileCards = {}
    self._sysInfoLbl = nil

    for name, b in pairs(self._tabBtns) do
        local sel = (name == tabName)
        b.BackgroundColor3 = sel and C.accent or C.row
        b.TextColor3 = sel and C.bg or C.muted
    end

    for _, child in ipairs(self._scroll:GetChildren()) do
        if not child:IsA("UIListLayout") and not child:IsA("UIPadding") then
            child:Destroy()
        end
    end
    self._scroll.CanvasPosition = Vector2.new(0, 0)

    if tabName == "Dynamics" then
        self:_buildDynamics()
    elseif tabName == "Engine" then
        self:_buildEngine()
    elseif tabName == "Audio" then
        self:_buildAudio()
    elseif tabName == "Visuals" then
        self:_buildVisuals()
    elseif tabName == "System" then
        self:_buildSystem()
    end
end

function Module:_addSection(title)
    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.new(1, 0, 0, 22)
    lbl.BackgroundTransparency = 1
    lbl.Font = Enum.Font.GothamBlack
    lbl.TextSize = 11
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.TextColor3 = C.accent
    lbl.Text = "  " .. string.upper(title)
    lbl.Parent = self._scroll
end

function Module:_addButtonRow(text, col, fn)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, 0, 0, 34)
    btn.BackgroundColor3 = C.row
    btn.Font = Enum.Font.GothamBold
    btn.TextSize = 12
    btn.TextColor3 = col or C.accent
    btn.Text = text
    btn.Parent = self._scroll
    _corner(btn, 7)
    _stroke(btn, col or C.accent, 0.55)
