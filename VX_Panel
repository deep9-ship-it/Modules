function Module:_createFooter(panel)
    local footer = Instance.new("Frame")
    footer.Size = UDim2.new(1, -16, 0, 36)
    footer.Position = UDim2.new(0, 8, 1, -44)
    footer.BackgroundTransparency = 1
    footer.Parent = panel

    local fLayout = Instance.new("UIListLayout")
    fLayout.FillDirection = Enum.FillDirection.Horizontal
    fLayout.Padding = UDim.new(0, 6)
    fLayout.Parent = footer

    local function footerBtn(text, col, fn)
        local b = Instance.new("TextButton")
        b.Size = UDim2.new(1 / 3, -4, 1, 0)
        b.BackgroundColor3 = GT3.carbon
        b.Font = Enum.Font.GothamBold
        b.TextSize = 11
        b.TextColor3 = col
        b.Text = text
        b.Parent = footer
        _corner(b, 6)
        _stroke(b, col, 0.45)
        self:_trackConn(b.MouseButton1Click:Connect(fn))
    end

    footerBtn("Save", GT3.green, function()
        if self:_savePreset("Custom1") then
            self.ui:notify("PRESET", "Saved Custom1", GT3.green, 2)
        end
    end)
    footerBtn("Load", GT3.cyan, function()
        if self:_loadPreset("Custom1") then
            self.ui:notify("PRESET", "Loaded Custom1", GT3.cyan, 2)
            self:_refreshAllRows()
        else
            self.ui:notify("PRESET", "No Custom1 saved", GT3.amber, 2)
        end
    end)
    footerBtn("Reset All", GT3.amber, function()
        _G.VX.resetAll()
        self.ui:notify("SYSTEM", "All settings reset", GT3.amber, 2)
        self:_refreshAllRows()
    end)
end

function Module:open()
    if not self._panel then return end
    self._isOpen = true
    self._panel.Visible = true
    if self._slideInSound then pcall(function() self._slideInSound:Play() end) end
    TweenService:Create(self._panel, TweenInfo.new(0.22, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
        Position = UDim2.new(0, 14, 0.5, 0),
    }):Play()
    if self._toggleBtn then
        TweenService:Create(self._toggleBtn, TweenInfo.new(0.22, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
            Position = UDim2.new(0, 388, 0.5, 0),
        }):Play()
    end
end

function Module:close()
    if not self._panel then return end
    self._isOpen = false
    if self._slideOutSound then pcall(function() self._slideOutSound:Play() end) end
    local tw = TweenService:Create(self._panel, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
        Position = UDim2.new(0, -388, 0.5, 0),
    })
    tw:Play()
    if self._toggleBtn then
        TweenService:Create(self._toggleBtn, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
            Position = UDim2.new(0, 14, 0.5, 0),
        }):Play()
    end
    tw.Completed:Once(function()
        if not self._isOpen and self._panel then
            self._panel.Visible = false
        end
    end)
end

function Module:toggle()
    if self._isOpen then self:close() else self:open() end
end

function Module:_switchTab(tabName)
    self._activeTab = tabName
    self._rowUpdaters = {}
    self._profileCards = {}
    self._sysInfoLbl = nil

    for name, b in pairs(self._tabBtns) do
        local sel = (name == tabName)
        b.BackgroundColor3 = sel and GT3.amber or GT3.carbonCard
        b.TextColor3 = sel and GT3.carbonDeep or GT3.muted
    end

    for _, child in ipairs(self._scroll:GetChildren()) do
        if not child:IsA("UIListLayout") and not child:IsA("UIPadding") then
            child:Destroy()
        end
    end
    self._scroll.CanvasPosition = Vector2.new(0, 0)

    if tabName == "Dynamics" then
        self:_buildDynamics()
    elseif tabName == "Physics" then
        self:_buildPhysics()
    elseif tabName == "Audio" then
        self:_buildAudio()
    elseif tabName == "Engine" then
        self:_buildEngine()
    elseif tabName == "Controls" then
        self:_buildControls()
    elseif tabName == "Lights" then
        self:_buildLights()
    end
end

