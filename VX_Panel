local Players      = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local UIS          = game:GetService("UserInputService")
local Player       = Players.LocalPlayer

local F = _G.VX.Framework
local Module = F.Module.new({
    Name = "Panel",
    Version = "3.2.0",
    Dependencies = { "Core", "Profiles", "Powertrain", "DriveSystem", "Chassis", "UI" },
})

local THEME = {
    bg         = Color3.fromRGB(13, 13, 15),    -- #0D0D0F Carbon Glass
    bgBottom   = Color3.fromRGB(8, 8, 10),
    card       = Color3.fromRGB(22, 22, 27),    -- Setting row card
    cardHover  = Color3.fromRGB(29, 29, 36),
    track      = Color3.fromRGB(40, 40, 50),
    border     = Color3.fromRGB(52, 52, 64),
    accent     = Color3.fromRGB(225, 29, 72),   -- #E11D48 GT3 Crimson
    accentDark = Color3.fromRGB(140, 22, 48),
    amber      = Color3.fromRGB(245, 158, 11),
    green      = Color3.fromRGB(16, 185, 129),
    text       = Color3.fromRGB(248, 250, 252),
    textDim    = Color3.fromRGB(148, 163, 184),
    textMuted  = Color3.fromRGB(100, 116, 139),
}

local SLIDE_IN_ID  = "rbxassetid://9114488953"
local SLIDE_OUT_ID = "rbxassetid://9114488653"
local TABS         = { "Dynamics", "Engine", "Audio", "System" }

function Module:_trackConn(c)
    if c then table.insert(self._conns, c) end
    return c
end

function Module:_clearConns()
    for _, c in ipairs(self._conns) do
        pcall(function()
            if typeof(c) == "RBXScriptConnection" then
                c:Disconnect()
            elseif type(c) == "table" and c.Disconnect then
                c:Disconnect()
            end
        end)
    end
    self._conns = {}
end

function Module:_notify(msg, dur, kind)
    local ui = self.ui or _G.VX.UI
    if ui and ui.notify then
        ui:notify(msg, dur, kind)
    end
end

function Module:_getSpeed()
    local root = _G.VX.Authority and _G.VX.Authority:getRoot()
    if not root then return 0 end
    local v = root.AssemblyLinearVelocity
    return Vector3.new(v.X, 0, v.Z).Magnitude * 0.626
end

function Module:Construct()
    self.gui = nil
    self.panel = nil
    self.scroll = nil
    self.activeTab = "Dynamics"
    self.tabButtons = {}
    self.tabUnderline = nil
    self.rowRefs = {}
    self.profileChips = {}
    self.turboBtns = {}
    self.activeProfileLbl = nil
    self.openState = false
    self._conns = {}
    self._layoutOrder = 0
    self._resetConfirmUntil = 0
end

function Module:Init(deps)
    self.core        = deps.Core
    self.profiles    = deps.Profiles
    self.powertrain  = deps.Powertrain
    self.driveSystem = deps.DriveSystem
    self.chassis     = deps.Chassis
    self.ui          = deps.UI
    _G.VX.Panel = self
end

function Module:Start()
    self:_createPanel()
    self:_trackConn(_G.VX.bus:on("settings.changed", function(evt)
        self:_onSettingChange(evt)
    end))
end

function Module:Stop()
    self:_clearConns()
    if self.slideInSound then pcall(function() self.slideInSound:Destroy() end); self.slideInSound = nil end
    if self.slideOutSound then pcall(function() self.slideOutSound:Destroy() end); self.slideOutSound = nil end
    if self.gui then pcall(function() self.gui:Destroy() end); self.gui = nil end
    self.panel = nil
end

function Module:_nextOrder()
    self._layoutOrder = self._layoutOrder + 1
    return self._layoutOrder
end

