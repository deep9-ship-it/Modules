--[[
    VX_Panel.lua — GT3 Carbon Left-Side Tuning Panel (6 Tabs: Dynamics, Physics, Audio, Engine, Controls, Lights)
    Version: 3.4.2
]]

local VX = _G.VX
if not VX or not VX.Framework then
    error("[VX_Panel] Requires VX_Kernel")
end

local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local Module = VX.Framework.Module.new({
    Name = "Panel",
    Dependencies = { "Core", "Profiles", "Powertrain", "DriveSystem", "Chassis", "UI" },
    Version = "3.4.2",
})

local GT3 = {
    carbonDeep = Color3.fromRGB(10, 11, 14),
    carbon     = Color3.fromRGB(18, 20, 26),
    carbonCard = Color3.fromRGB(26, 29, 38),
    carbonLine = Color3.fromRGB(44, 49, 64),
    amber      = Color3.fromRGB(255, 180, 0),
    cyan       = Color3.fromRGB(0, 212, 255),
    green      = Color3.fromRGB(34, 229, 138),
    crimson    = Color3.fromRGB(255, 42, 60),
    text       = Color3.fromRGB(244, 246, 250),
    muted      = Color3.fromRGB(140, 148, 168),
}

local TABS = { "Dynamics", "Physics", "Audio", "Engine", "Controls", "Lights" }

local function _corner(parent, r)
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, r or 8)
    c.Parent = parent
    return c
end

local function _stroke(parent, col, trans, thickness)
    local s = Instance.new("UIStroke")
    s.Color = col or GT3.carbonLine
    s.Transparency = trans or 0.38
    s.Thickness = thickness or 1
    s.Parent = parent
    return s
end

local function _deepCopy(t)
    if type(t) ~= "table" then return t end
    local c = {}
    for k, v in pairs(t) do c[k] = _deepCopy(v) end
    return c
end

local function _applySettingsTable(tbl, prefix)
    for k, v in pairs(tbl) do
        if k:sub(1, 1) ~= "_" then
            local path = prefix and (prefix .. "." .. k) or k
            if type(v) == "table" then
                _applySettingsTable(v, path)
            elseif _G.VX and type(_G.VX.setSetting) == "function" then
                pcall(_G.VX.setSetting, path, v)
            end
        end
    end
end

function Module:_trackConn(conn)
    if conn then table.insert(self._conns, conn) end
    return conn
end

function Module:_clearConns()
    for _, c in ipairs(self._conns) do
        if typeof(c) == "RBXScriptConnection" then
            c:Disconnect()
        elseif type(c) == "table" and c.Disconnect then
            c:Disconnect()
        end
    end
    self._conns = {}
end

function Module:_getSpeed()
    local handle = _G.VX.Authority and _G.VX.Authority:getHandle()
    local velPart = handle and ((handle.root and handle.root.PrimaryPart) or handle.platform or handle.chassis or handle.seat)
    if not velPart then return 0 end
    local v = velPart.AssemblyLinearVelocity
    return Vector3.new(v.X, 0, v.Z).Magnitude * 0.626
end

function Module:_formatNumber(path, value, schema)
    local v = tonumber(value) or 0
    if path == "horsepower" then
        return string.format("%d HP", math.floor(v + 0.5))
    elseif path == "masterVolume" or path == "engineBoost" then
        return string.format("%d%%", math.floor(v * 100 + 0.5))
    elseif path == "pitchOffset" then
        return string.format("%+d%%", math.floor(v * 100 + 0.5))
    elseif path == "topSpeed" or path == "lightSpeed" or (schema and schema.step and schema.step >= 1) then
        return string.format("%d", math.floor(v + 0.5))
    elseif path == "frontGrip" or path == "rearGrip" then
        return string.format("%.2f", v)
    elseif path == "brakeSpeed" or path == "brakingPower" then
        return string.format("%.1f", v)
    elseif path == "turboCustomMultiplier" then
        return string.format("%.1fx", v)
    elseif schema and schema.unit then
        return string.format("%.2f%s", v, schema.unit)
    end
    return string.format("%.2f", v)
end

function Module:_prettyName(key)
    local s = key:gsub("(%u)", " %1"):gsub("^%s+", "")
    return s:sub(1, 1):upper() .. s:sub(2)
end

function Module:Construct()
    self._conns = {}
    self._gui = nil
    self._panel = nil
    self._toggleBtn = nil
    self._scroll = nil
    self._sysInfoLbl = nil
    self._isOpen = false
    self._activeTab = "Dynamics"
    self._tabBtns = {}
    self._profileCards = {}
    self._rowUpdaters = {}
    self._presets = {}
    self._slideInSound = nil
    self._slideOutSound = nil
    self._lastSysUpdate = 0
end

function Module:Init(deps)
    self.core = deps.Core
    self.profiles = deps.Profiles
    self.powertrain = deps.Powertrain
    self.drive = deps.DriveSystem
    self.chassis = deps.Chassis
    self.ui = deps.UI
    _G.VX.Panel = self
end

function Module:Start()
    self:_createSounds()
    self:_createPanel()

    if _G.VX.getSetting and _G.VX.getSetting("videoMode") == true then
        self:setHidden(true)
    end

    self:_trackConn(_G.VX.bus:on("settings.changed", function(evt)
        if evt and evt.path and self._rowUpdaters[evt.path] then
            pcall(self._rowUpdaters[evt.path])
        end
    end))

    self:_trackConn(_G.VX.bus:on("profiles.changed", function()
        self:_refreshProfileCards()
    end))

    self:_trackConn(UserInputService.InputBegan:Connect(function(input, gp)
        if gp then return end
        if input.KeyCode == Enum.KeyCode.F5 then
            self:toggle()
        end
    end))

    self:_trackConn(RunService.Heartbeat:Connect(function()
        if self._isOpen and self._activeTab == "Lights" and self._sysInfoLbl then
            local now = os.clock()
            if now - self._lastSysUpdate >= 0.3 then
                self._lastSysUpdate = now
                self:_refreshStatusCard()
            end
        end
    end))

    print("[VX] Panel ready (GT3 Carbon)")
end

function Module:_createSounds()
    local pg = Players.LocalPlayer and Players.LocalPlayer:WaitForChild("PlayerGui", 3)
    if not pg then return end
    local function make(name, id)
        local old = pg:FindFirstChild(name)
        if old then old:Destroy() end
        local s = Instance.new("Sound")
        s.Name = name
        s.SoundId = "rbxassetid://" .. id
        s.Volume = 0.8
        s.Parent = pg
        return s
    end
    pcall(function()
        self._slideInSound = make("VX_PanelSlideIn", "139821129588664")
        self._slideOutSound = make("VX_PanelSlideOut", "77985512666301")
    end)
end

function Module:setHidden(hidden)
    if self._gui then
        self._gui.Enabled = not hidden
    end
end

function Module:isOpen()
    return self._isOpen
end

function Module:_refreshAllRows()
    for _, fn in pairs(self._rowUpdaters) do
        pcall(fn)
    end
    self:_refreshProfileCards()
end

function Module:_refreshProfileCards()
    local activeIdx = self.profiles:getCurrentIndex()
    for idx, card in pairs(self._profileCards) do
        if card and card.btn and card.btn.Parent then
            local sel = (idx == activeIdx)
            card.btn.BackgroundColor3 = sel and GT3.amber or GT3.carbonCard
            card.nameLbl.TextColor3 = sel and GT3.carbonDeep or GT3.text
            card.subLbl.TextColor3 = sel and GT3.carbonDeep or GT3.muted
        end
    end
end

function Module:_refreshStatusCard()
    if not self._sysInfoLbl or not self._sysInfoLbl.Parent then return end
    local vs = _G.VX.Modules and _G.VX.Modules.VehicleState
    local st = vs and vs:getVehicleState() or "Unknown"
    local spd = self:_getSpeed()
    local prof = self.profiles:current()
    local rpm = self.powertrain:getRPM() or 0
    local gear = self.powertrain:getGear() or 1
    local gearStr = (gear == -1) and "R" or ((gear == 0) and "N" or tostring(gear))
    local hp = (self.drive and self.drive.getHorsepower and self.drive:getHorsepower()) or 0
    local hpMode = (_G.VX.getSetting and _G.VX.getSetting("customHorsepower")) and "Custom" or "Auto"

    self._sysInfoLbl.Text = string.format(
        "Kernel v%s  |  State: %s\nSpeed: %.0f MPH  |  RPM: %d  |  Gear: %s\nPower: %d HP (%s)  |  Profile: %s",
        tostring(_G.VX.Version), st, spd, math.floor(rpm), gearStr, math.floor(hp + 0.5), hpMode, prof and prof.name or "Default"
    )
end

function Module:_savePreset(name)
    if type(_G.VX.settings) ~= "table" then return false end
    local copy = _deepCopy(_G.VX.settings)
    self._presets[name] = copy
    if type(writefile) == "function" then
        pcall(function()
            writefile("VX_GT3_Preset_" .. name .. ".json", HttpService:JSONEncode(copy))
        end)
    end
    return true
end

function Module:_loadPreset(name)
    local data = self._presets[name]
    if not data and type(readfile) == "function" and type(isfile) == "function" then
        pcall(function()
            local file = "VX_GT3_Preset_" .. name .. ".json"
            if isfile(file) then
                data = HttpService:JSONDecode(readfile(file))
                self._presets[name] = data
            end
        end)
    end
    if type(data) ~= "table" then return false end
    _applySettingsTable(data, nil)
    return true
end

