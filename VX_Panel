function Module:_buildEngine()
    self:_addSection("Engine Profile")

    local grid = Instance.new("Frame")
    grid.Size = UDim2.new(1, 0, 0, 210)
    grid.BackgroundTransparency = 1
    grid.Parent = self._scroll

    local gl = Instance.new("UIGridLayout")
    gl.CellSize = UDim2.new(0.5, -3, 0, 36)
    gl.CellPadding = UDim2.new(0, 6, 0, 6)
    gl.Parent = grid

    for i, prof in ipairs(self.profiles:getAll()) do
        local b = Instance.new("TextButton")
        b.Text = ""
        b.Parent = grid
        _corner(b, 6)
        _stroke(b, C.border, 0.7)

        local nameLbl = Instance.new("TextLabel")
        nameLbl.Size = UDim2.new(1, -10, 0, 18)
        nameLbl.Position = UDim2.new(0, 6, 0, 2)
        nameLbl.BackgroundTransparency = 1
        nameLbl.Font = Enum.Font.GothamBold
        nameLbl.TextSize = 11
        nameLbl.TextXAlignment = Enum.TextXAlignment.Left
        nameLbl.Text = prof.name
        nameLbl.Parent = b

        local subLbl = Instance.new("TextLabel")
        subLbl.Size = UDim2.new(1, -10, 0, 14)
        subLbl.Position = UDim2.new(0, 6, 0, 19)
        subLbl.BackgroundTransparency = 1
        subLbl.Font = Enum.Font.Code
        subLbl.TextSize = 10
        subLbl.TextXAlignment = Enum.TextXAlignment.Left
        subLbl.Text = string.format("%d RPM | %dG", prof.redline, #prof.gearRatios)
        subLbl.Parent = b

        self._profileCards[i] = { btn = b, nameLbl = nameLbl, subLbl = subLbl }
        self:_trackConn(b.MouseButton1Click:Connect(function()
            self.profiles:setCurrent(i)
        end))
    end
    self:_refreshProfileCards()

    self:_addSection("Forced Induction")
    self:_addSettingRow("turboStage")

    self:_addSection("Transmission & Launch")
    self:_addSettingRow("physics.realisticShifting")
    self:_addSettingRow("physics.shiftDelay")
    self:_addSettingRow("physics.revLimiter")
    self:_addSettingRow("physics.launchControl")
    self:_addSettingRow("physics.launchTargetRPM")
    self:_addSettingRow("physics.twostep")
    self:_addSettingRow("physics.coldStart")
    self:_addSettingRow("physics.idleHunting")
    self:_addButtonRow("Trigger Cold Start", C.amber, function()
        self.powertrain:triggerColdStart()
    end)
end

