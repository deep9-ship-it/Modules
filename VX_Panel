end

function Module:_addSettingRow(path, customLabel)
    local reg = _G.VX.registry and _G.VX.registry:get("settings", path)
    local schema = reg and reg.schema or reg
    if not schema then return end

    local t = schema.type
    local isBool = (t == "boolean")
    local isTurboButtons = (path == "turboStage")
    local hasOptions = (t == "enum" and type(schema.options) == "table")
    local hasLabels = (type(schema.enumLabels) == "table")
    local isCycler = hasOptions and (#schema.options > 5)
    local isSegmented = isTurboButtons or (hasOptions and #schema.options <= 5) or (hasLabels and #schema.enumLabels <= 5)
    local isSlider = (t == "number_range" or t == "number_stepped" or t == "float" or t == "int") and not isSegmented

    local row = Instance.new("Frame")
    row.Size = UDim2.new(1, 0, 0, isSlider and 56 or (isSegmented and 58 or 38))
    row.BackgroundColor3 = GT3.carbonCard
    row.Parent = self._scroll
    _corner(row, 7)
    _stroke(row, GT3.carbonLine, 0.55)

    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.new(isSlider and 0.65 or (isSegmented and 1 or 0.62), -14, 0, 22)
    lbl.Position = UDim2.new(0, 10, 0, (isBool or isCycler) and 8 or 4)
    lbl.BackgroundTransparency = 1
    lbl.Font = Enum.Font.GothamSemibold
    lbl.TextSize = 12
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.TextColor3 = GT3.text
    lbl.TextTruncate = Enum.TextTruncate.AtEnd
    lbl.Text = customLabel or schema.label or path
    lbl.Parent = row

    if isBool then
        local switch = Instance.new("TextButton")
        switch.Size = UDim2.new(0, 48, 0, 22)
        switch.Position = UDim2.new(1, -58, 0, 8)
        switch.BackgroundColor3 = GT3.carbon
        switch.Text = ""
        switch.Parent = row
        _corner(switch, 11)

        local knob = Instance.new("Frame")
        knob.Size = UDim2.new(0, 16, 0, 16)
        knob.Position = UDim2.new(0, 3, 0, 3)
        knob.BackgroundColor3 = GT3.text
        knob.Parent = switch
        _corner(knob, 8)

        local function sync(animate)
            local v = _G.VX.getSetting(path) == true
            local targetBg = v and GT3.green or GT3.carbon
            local targetPos = v and UDim2.new(1, -19, 0, 3) or UDim2.new(0, 3, 0, 3)
            if animate then
                TweenService:Create(switch, TweenInfo.new(0.14), { BackgroundColor3 = targetBg }):Play()
                TweenService:Create(knob, TweenInfo.new(0.14), { Position = targetPos }):Play()
            else
                switch.BackgroundColor3 = targetBg
                knob.Position = targetPos
            end
        end
        sync(false)
        self._rowUpdaters[path] = function() sync(true) end

        self:_trackConn(switch.MouseButton1Click:Connect(function()
            _G.VX.setSetting(path, not (_G.VX.getSetting(path) == true))
            sync(true)
        end))

    elseif isCycler then
        local opts = schema.options
        local holder = Instance.new("Frame")
        holder.Size = UDim2.new(0, 138, 0, 24)
        holder.Position = UDim2.new(1, -148, 0, 7)
        holder.BackgroundColor3 = GT3.carbon
        holder.Parent = row
        _corner(holder, 6)

        local prevBtn = Instance.new("TextButton")
        prevBtn.Size = UDim2.new(0, 24, 1, 0)
        prevBtn.BackgroundTransparency = 1
        prevBtn.Font = Enum.Font.GothamBold
        prevBtn.TextSize = 12
        prevBtn.TextColor3 = GT3.amber
        prevBtn.Text = "<"
        prevBtn.Parent = holder

        local valLbl = Instance.new("TextLabel")
        valLbl.Size = UDim2.new(1, -48, 1, 0)
        valLbl.Position = UDim2.new(0, 24, 0, 0)
        valLbl.BackgroundTransparency = 1
        valLbl.Font = Enum.Font.GothamBold
        valLbl.TextSize = 10
        valLbl.TextColor3 = GT3.text
        valLbl.TextTruncate = Enum.TextTruncate.AtEnd
        valLbl.Parent = holder

        local nextBtn = Instance.new("TextButton")
        nextBtn.Size = UDim2.new(0, 24, 1, 0)
        nextBtn.Position = UDim2.new(1, -24, 0, 0)
        nextBtn.BackgroundTransparency = 1
        nextBtn.Font = Enum.Font.GothamBold
        nextBtn.TextSize = 12
        nextBtn.TextColor3 = GT3.amber
        nextBtn.Text = ">"
        nextBtn.Parent = holder

        local function sync()
            valLbl.Text = tostring(_G.VX.getSetting(path) or schema.default)
        end
        sync()
        self._rowUpdaters[path] = sync

        local function stepOpt(dir)
            local cur = _G.VX.getSetting(path) or schema.default
            local idx = 1
            for i, opt in ipairs(opts) do if opt == cur then idx = i; break end end
            idx = ((idx - 1 + dir) % #opts) + 1
            _G.VX.setSetting(path, opts[idx])
            sync()
        end
        self:_trackConn(prevBtn.MouseButton1Click:Connect(function() stepOpt(-1) end))
        self:_trackConn(nextBtn.MouseButton1Click:Connect(function() stepOpt(1) end))

    elseif isSegmented then
        local holder = Instance.new("Frame")
        holder.Size = UDim2.new(1, -20, 0, 24)
        holder.Position = UDim2.new(0, 10, 0, 28)
        holder.BackgroundTransparency = 1
        holder.Parent = row

        local hl = Instance.new("UIListLayout")
        hl.FillDirection = Enum.FillDirection.Horizontal
        hl.Padding = UDim.new(0, 4)
        hl.Parent = holder

        local items = {}
        if isTurboButtons then
            items = {
                { val = 1, label = "Stg 1 (21)" },
                { val = 2, label = "Stg 2 (42)" },
                { val = 3, label = "Stg 3 (78)" },
            }
        elseif hasOptions then
            for _, opt in ipairs(schema.options) do
                table.insert(items, { val = opt, label = tostring(opt) })
            end
        else
            local minV = schema.min or 1
            for idx, txt in ipairs(schema.enumLabels) do
                table.insert(items, { val = minV + idx - 1, label = txt })
            end
        end

        local btns = {}
        for _, item in ipairs(items) do
            local b = Instance.new("TextButton")
            b.Size = UDim2.new(1 / #items, -3, 1, 0)
            b.Font = Enum.Font.GothamBold
            b.TextSize = (#items >= 4) and 10 or 11
            b.Text = item.label
            b.TextTruncate = Enum.TextTruncate.AtEnd
            b.Parent = holder
            _corner(b, 5)
            btns[item.val] = b
            self:_trackConn(b.MouseButton1Click:Connect(function()
                _G.VX.setSetting(path, item.val)
            end))
        end

        local function sync()
            local v = _G.VX.getSetting(path)
            if v == nil then v = schema.default end
            for val, b in pairs(btns) do
                local active = (v == val)
                b.BackgroundColor3 = active and GT3.amber or GT3.carbon
                b.TextColor3 = active and GT3.carbonDeep or GT3.muted
            end
        end
        sync()
        self._rowUpdaters[path] = sync

    elseif isSlider then
        local minV = schema.min or 0
        local maxV = schema.max or 1
        local step = schema.step or 0.05
        local invStep = 1 / step

        local valLbl = Instance.new("TextLabel")
        valLbl.Size = UDim2.new(0.35, -10, 0, 20)
        valLbl.Position = UDim2.new(0.65, 0, 0, 4)
        valLbl.BackgroundTransparency = 1
        valLbl.Font = Enum.Font.Code
        valLbl.TextSize = 12
        valLbl.TextXAlignment = Enum.TextXAlignment.Right
        valLbl.TextColor3 = GT3.amber
        valLbl.Parent = row

        local minusBtn = Instance.new("TextButton")
        minusBtn.Size = UDim2.new(0, 22, 0, 20)
        minusBtn.Position = UDim2.new(0, 10, 0, 29)
        minusBtn.BackgroundColor3 = GT3.carbon
        minusBtn.Font = Enum.Font.GothamBold
        minusBtn.TextSize = 13
        minusBtn.TextColor3 = GT3.muted
        minusBtn.Text = "-"
        minusBtn.Parent = row
        _corner(minusBtn, 5)

        local plusBtn = Instance.new("TextButton")
        plusBtn.Size = UDim2.new(0, 22, 0, 20)
        plusBtn.Position = UDim2.new(1, -32, 0, 29)
        plusBtn.BackgroundColor3 = GT3.carbon
        plusBtn.Font = Enum.Font.GothamBold
        plusBtn.TextSize = 13
        plusBtn.TextColor3 = GT3.muted
        plusBtn.Text = "+"
        plusBtn.Parent = row
        _corner(plusBtn, 5)

        local track = Instance.new("Frame")
        track.Size = UDim2.new(1, -76, 0, 8)
        track.Position = UDim2.new(0, 38, 0, 35)
        track.BackgroundColor3 = GT3.carbon
        track.Parent = row
        _corner(track, 4)

        local fill = Instance.new("Frame")
        fill.BackgroundColor3 = GT3.amber
        fill.Size = UDim2.new(0, 0, 1, 0)
        fill.Parent = track
        _corner(fill, 4)

        local knob = Instance.new("Frame")
        knob.Size = UDim2.new(0, 14, 0, 14)
        knob.AnchorPoint = Vector2.new(0.5, 0.5)
        knob.Position = UDim2.new(0, 0, 0.5, 0)
        knob.BackgroundColor3 = GT3.text
        knob.ZIndex = 3
        knob.Parent = track
        _corner(knob, 7)

        local function sync()
            local v = tonumber(_G.VX.getSetting(path))
            if v == nil then v = schema.default or minV end
            local pct = math.clamp((v - minV) / math.max(0.00001, maxV - minV), 0, 1)
            fill.Size = UDim2.new(pct, 0, 1, 0)
            knob.Position = UDim2.new(pct, 0, 0.5, 0)
            valLbl.Text = self:_formatNumber(path, v, schema)
        end
        sync()
        self._rowUpdaters[path] = sync

        local function snapValue(raw)
            local snapped = math.clamp(math.floor(raw * invStep + 0.5) / invStep, minV, maxV)
            if step >= 1 then snapped = math.floor(snapped + 0.5) end
            return snapped
        end

        local function nudge(delta)
            local cur = tonumber(_G.VX.getSetting(path)) or schema.default or minV
            _G.VX.setSetting(path, snapValue(cur + delta))
            sync()
        end

        self:_trackConn(minusBtn.MouseButton1Click:Connect(function() nudge(-step) end))
        self:_trackConn(plusBtn.MouseButton1Click:Connect(function() nudge(step) end))

        local dragging = false
        local function applyX(x)
            local rel = math.clamp((x - track.AbsolutePosition.X) / math.max(1, track.AbsoluteSize.X), 0, 1)
            _G.VX.setSetting(path, snapValue(minV + rel * (maxV - minV)))
            sync()
        end

        self:_trackConn(track.InputBegan:Connect(function(inp)
            if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then
                dragging = true
                applyX(inp.Position.X)
            end
        end))
        self:_trackConn(UserInputService.InputChanged:Connect(function(inp)
            if dragging and (inp.UserInputType == Enum.UserInputType.MouseMovement or inp.UserInputType == Enum.UserInputType.Touch) then
                applyX(inp.Position.X)
            end
        end))
        self:_trackConn(UserInputService.InputEnded:Connect(function(inp)
            if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then
                dragging = false
            end
        end))
    end
end

