    banner.BackgroundColor3 = THEME.card
    banner.BorderSizePixel = 0
    banner.LayoutOrder = self:_nextOrder()
    banner.Parent = self.scroll
    local bc = Instance.new("UICorner"); bc.CornerRadius = UDim.new(0, 8); bc.Parent = banner
    local bs = Instance.new("UIStroke"); bs.Color = THEME.accent; bs.Thickness = 1; bs.Transparency = 0.4; bs.Parent = banner

    local bLbl = Instance.new("TextLabel")
    bLbl.Size = UDim2.new(1, -20, 1, 0)
    bLbl.Position = UDim2.new(0, 12, 0, 0)
    bLbl.BackgroundTransparency = 1
    bLbl.Text = string.format("%s  ·  %d RPM", activeProf.name, activeProf.maxRPM)
    bLbl.TextColor3 = THEME.text
    bLbl.Font = Enum.Font.GothamBold
    bLbl.TextSize = 12
    bLbl.TextXAlignment = Enum.TextXAlignment.Left
    bLbl.Parent = banner
    self.activeProfileLbl = bLbl

    self:_addSection("Engine Swap (Stop Vehicle)")

    -- Compact 2-Column Grid for Engine Profiles
    local gridWrap = Instance.new("Frame")
    gridWrap.Size = UDim2.new(1, 0, 0, math.ceil(#all / 2) * 34)
    gridWrap.BackgroundTransparency = 1
    gridWrap.LayoutOrder = self:_nextOrder()
    gridWrap.Parent = self.scroll

    local grid = Instance.new("UIGridLayout")
    grid.CellSize = UDim2.new(0.5, -3, 0, 28)
    grid.CellPadding = UDim2.new(0, 6, 0, 6)
    grid.SortOrder = Enum.SortOrder.LayoutOrder
    grid.Parent = gridWrap

    for i, prof in ipairs(all) do
        local isAct = (i == activeIdx)
        local btn = Instance.new("TextButton")
        btn.BackgroundColor3 = isAct and THEME.accent or THEME.card
        btn.Text = prof.name
        btn.TextColor3 = isAct and THEME.text or THEME.textDim
        btn.Font = Enum.Font.GothamBold
        btn.TextSize = 11
        btn.TextTruncate = Enum.TextTruncate.AtEnd
        btn.AutoButtonColor = false
        btn.LayoutOrder = i
        btn.Parent = gridWrap
        local c = Instance.new("UICorner"); c.CornerRadius = UDim.new(0, 6); c.Parent = btn

        btn.MouseButton1Click:Connect(function()
            if self:_getSpeed() > 5 then
                self:_notify("Stop vehicle before swapping engine", 2, "warn")
                return
            end
            _G.VX.setSetting("engineProfile", i)
            self:_notify("Engine: " .. prof.name, 2, "success")
        end)
        self.profileChips[i] = btn
    end

    self:_addSection("Forced Induction")

    -- Turbo Stage Segmented Row
    local tRow = Instance.new("Frame")
    tRow.Size = UDim2.new(1, 0, 0, 56)
    tRow.BackgroundColor3 = THEME.card
    tRow.BorderSizePixel = 0
    tRow.LayoutOrder = self:_nextOrder()
    tRow.Parent = self.scroll
