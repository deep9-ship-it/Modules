local function _deepCopy(t)
    if type(t) ~= "table" then return t end
    local c = {}
    for k, v in pairs(t) do
        c[k] = _deepCopy(v)
    end
    return c
end

local function _flattenAndApply(tbl, prefix)
    for k, v in pairs(tbl) do
        local path = prefix and (prefix .. "." .. k) or k
        if type(v) == "table" then
            _flattenAndApply(v, path)
        elseif _G.VX and type(_G.VX.setSetting) == "function" then
            pcall(_G.VX.setSetting, path, v)
        end
    end
end

function Module:get(idx)
    return PROFILES[math.clamp(math.floor(idx or 1), 1, #PROFILES)]
end

function Module:getCurrentIndex()
    local idx = _G.VX and _G.VX.getSetting and _G.VX.getSetting("engineProfile") or 1
    return math.clamp(math.floor(idx), 1, #PROFILES)
end

function Module:current()
    return self:get(self:getCurrentIndex())
end

function Module:getActive()
    return self:current()
end

function Module:getActiveIndex()
    return self:getCurrentIndex()
end

function Module:setCurrent(idx)
    local clamped = math.clamp(math.floor(idx or 1), 1, #PROFILES)
    local prev = self:getCurrentIndex()
    if _G.VX and _G.VX.setSetting then
        _G.VX.setSetting("engineProfile", clamped)
    end
    local prof = self:get(clamped)
    if prev == clamped and _G.VX and _G.VX.bus then
        _G.VX.bus:emit("profiles.changed", { index = clamped, profile = prof })
    end
    return prof
end

function Module:getAll()
    return PROFILES
end

-- Supports both (rpm, profile) and (profile, rpm)
function Module:getTorqueAtRPM(a, b)
    local prof, rpm
    if type(a) == "table" then
        prof = a
        rpm = tonumber(b) or prof.idleRPM
    else
        rpm = tonumber(a) or 900
        prof = b or self:current()
    end

    local curvePts = TORQUE_CURVES[prof.curve or "default"] or TORQUE_CURVES.default
    local norm = math.clamp((rpm - prof.idleRPM) / math.max(1, prof.maxRPM - prof.idleRPM), 0, 1)

    for i = 1, #curvePts - 1 do
        local p0, p1 = curvePts[i], curvePts[i + 1]
        if norm >= p0[1] and norm <= p1[1] then
            local alpha = (norm - p0[1]) / math.max(0.0001, p1[1] - p0[1])
            return p0[2] + (p1[2] - p0[2]) * alpha
        end
    end
    return curvePts[#curvePts][2]
end

function Module:savePreset(name)
    name = tostring(name or "Custom1")
    local settings = _G.VX and _G.VX.settings
    if type(settings) ~= "table" then return false end

    local copy = _deepCopy(settings)
    self._presets[name] = copy

    if type(writefile) == "function" then
        pcall(function()
            writefile("VX_Preset_" .. name .. ".json", HttpService:JSONEncode(copy))
        end)
    end
    return true
end

function Module:loadPreset(name)
    name = tostring(name or "Custom1")
    local data = self._presets[name]

    if not data and type(readfile) == "function" and type(isfile) == "function" then
        pcall(function()
            local file = "VX_Preset_" .. name .. ".json"
            if isfile(file) then
                data = HttpService:JSONDecode(readfile(file))
                self._presets[name] = data
            end
        end)
    end

    if type(data) ~= "table" then return false end
    _flattenAndApply(data, nil)
    return true
end

function Module:Construct()
    self._presets = {}
    self._conn = nil
end

function Module:Init(deps)
    self.core = deps.Core
    local labels = {}
    for i, p in ipairs(PROFILES) do
        labels[i] = p.name
    end
    local R = _G.VX and _G.VX.registry
    if R then
        pcall(R.set, R, "settings", "engineProfile", {
            type = "int",
            min = 1,
            max = #PROFILES,
            step = 1,
            default = 1,
            label = "Engine Profile",
            enumLabels = labels,
            category = "Engine",
        }, "Profiles")
    end
end

function Module:Start()
    _G.VX.Profiles = self
    self._conn = _G.VX.bus:on("settings.changed", function(evt)
        if evt and evt.path == "engineProfile" then
            local idx = math.clamp(math.floor(evt.new or 1), 1, #PROFILES)
            _G.VX.bus:emit("profiles.changed", { index = idx, profile = PROFILES[idx] })
        end
    end)
end

function Module:Stop()
    if self._conn and self._conn.Disconnect then
        self._conn:Disconnect()
        self._conn = nil
    end
    _G.VX.Profiles = nil
end

function Module:heartbeat()
    return #PROFILES > 0
end

return Module
