function Module:Construct()
    self.list = PROFILES
    self._currentIndex = 1
    self._conn = nil
end

function Module:Init(deps)
    local labels = {}
    for i, p in ipairs(PROFILES) do labels[i] = p.name end

    pcall(function()
        _G.VX.registry:set("settings", "engineProfile", {
            type = "number_stepped",
            default = 1, min = 1, max = #PROFILES, step = 1,
            category = "Engine",
            label = "Engine Profile",
            enumLabels = labels,
            description = "Changes engine sound, gear ratios, torque curve",
        }, "Profiles")
    end)

    local idx = _G.VX.settings.engineProfile or 1
    if not PROFILES[idx] then
        idx = 1
        _G.VX.settings.engineProfile = 1
    end
    self._currentIndex = idx
end

function Module:Start()
    _G.VX.Profiles = self
    self._conn = _G.VX.bus:on("settings.changed", function(evt)
        if evt and evt.path == "engineProfile" and PROFILES[evt.new] then
            self._currentIndex = evt.new
            _G.VX.bus:emit("profiles.changed", {
                index = evt.new,
                profile = PROFILES[evt.new],
            })
        end
    end)
    print("[VX] Profiles loaded: " .. #PROFILES .. " available")
end

function Module:Stop()
    if self._conn and self._conn.Disconnect then
        self._conn:Disconnect()
        self._conn = nil
    end
    if _G.VX.Profiles == self then _G.VX.Profiles = nil end
end

function Module:heartbeat() return true end

function Module:get(index)
    return PROFILES[index or self._currentIndex] or PROFILES[1]
end

function Module:current()
    return self:get(self._currentIndex)
end

function Module:setCurrent(index)
    if not PROFILES[index] then return false end
    _G.VX.setSetting("engineProfile", index)
    return true
end

function Module:getAll()
    return PROFILES
end

function Module:getCurrentIndex()
    return self._currentIndex
end

function Module:getTorqueCurveFor(profile)
    local key = profile and profile.torqueCurve or "default"
    return TORQUE_CURVES[key] or TORQUE_CURVES.default
end

function Module:getTorqueAtRPM(profile, rpm)
    local curve = self:getTorqueCurveFor(profile)
    if #curve == 0 then return 0.70 end
    if rpm <= curve[1][1] then return curve[1][2] end
    if rpm >= curve[#curve][1] then return curve[#curve][2] end
    for i = 1, #curve - 1 do
        local a, b = curve[i], curve[i + 1]
        if rpm >= a[1] and rpm <= b[1] then
            local t = (rpm - a[1]) / (b[1] - a[1])
            return a[2] + (b[2] - a[2]) * t
        end
    end
    return 0.70
end

return Module
