function Module:Construct()
    self._settings = _deepCopy(_defaultSettings)
    self._config = _deepCopy(_defaultConfig)
    self._perfMode = "normal"
    self:_migrateLegacy()
end

function Module:Init()
    local V = _G.VX
    V.settings = self._settings
    V.config = self._config
    V.clamp = clamp
    V.lerp = lerp
    V.smoothstep = smoothstep
    V.log = function(lvl, tag, fmt, ...) self:log(lvl, tag, fmt, ...) end
    V.logBuffer = _logBuffer
    V.getSetting = function(path) return self:getSetting(path) end
    V.setSetting = function(path, val) return self:setSetting(path, val) end
    V.resetSetting = function(path) return self:resetSetting(path) end
    V.resetAll = function() return self:resetAll() end
    self:RegisterCoreSchema()
end

function Module:Start()
    task.spawn(function()
        self._perfMode = self:getPerformanceMode()
        self:log("INFO", "Core", "Started (perf=%s, tick=%dHz)", self._perfMode, self:getTickRate())
    end)
end

function Module:Stop()
    local V = _G.VX
    if V then
        V.clamp = nil
        V.lerp = nil
        V.smoothstep = nil
        V.log = nil
        V.logBuffer = nil
    end
end

function Module:heartbeat()
    return self._settings ~= nil and self._config ~= nil
end

return Module
