function Module:_migrateLegacy()
    local existing = _G.VX and _G.VX.settings
    if type(existing) == "table" then
        self:_deepMerge(self.settings, existing)
        self.settings.brakeBiasEnabled = nil
        self.settings.brakeBias = nil
        self.settings.brakeBiasIntensity = nil
        self.settings.driftStrength = nil
        print("[VX] Preserved existing settings, dropped deprecated keys")
        return
    end
    local old = _G.DeepSec90 and _G.DeepSec90.userSettings
    if not old then return end
    for k, v in pairs(old) do
        if k ~= "brakeBiasEnabled" and k ~= "brakeBias"
           and k ~= "brakeBiasIntensity" and k ~= "driftStrength"
           and self.settings[k] ~= nil then
            self.settings[k] = v
        end
    end
    if type(old.physics) == "table" then
        for k, v in pairs(old.physics) do
            if self.settings.physics[k] ~= nil then
                self.settings.physics[k] = v
            end
        end
    end
    print("[VX] Migrated legacy DeepSec90 settings")
end

function Module:_deepMerge(target, source)
    for k, v in pairs(source) do
        if type(v) == "table" and type(target[k]) == "table" then
            self:_deepMerge(target[k], v)
        elseif target[k] ~= nil then
            target[k] = v
        end
    end
end

function Module:Init(deps)
    _G.VX.settings = self.settings
    _G.VX.config   = self.config

    _G.VX.getSetting = function(path)
        local parts = {}
        for p in path:gmatch("[^%.]+") do table.insert(parts, p) end
        local cur = self.settings
        for _, p in ipairs(parts) do
            if type(cur) ~= "table" then return nil end
            cur = cur[p]
        end
        return cur
    end

    _G.VX.setSetting = function(path, value)
        local parts = {}
        for p in path:gmatch("[^%.]+") do table.insert(parts, p) end
        if #parts == 0 then return end
        local cur = self.settings
        for i = 1, #parts - 1 do
            if type(cur[parts[i]]) ~= "table" then return end
            cur = cur[parts[i]]
        end
        local old = cur[parts[#parts]]
        cur[parts[#parts]] = value
        _G.VX.bus:emit("settings.changed", { path = path, old = old, new = value })
    end

    _G.VX.resetSetting = function(path)
        local defaults = self:_defaultSettings()
        local parts = {}
        for p in path:gmatch("[^%.]+") do table.insert(parts, p) end
        local cur = defaults
        for _, p in ipairs(parts) do
            if type(cur) ~= "table" then return false end
            cur = cur[p]
        end
        if cur == nil then return false end
        _G.VX.setSetting(path, cur)
        return true
    end

    self:_registerCoreSchema()
end

