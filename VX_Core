local function _deepCopy(tbl)
    if type(tbl) ~= "table" then return tbl end
    local copy = {}
    for k, v in pairs(tbl) do
        copy[k] = _deepCopy(v)
    end
    return copy
end

local function _deepGet(tbl, path)
    if type(tbl) ~= "table" or type(path) ~= "string" then return nil end
    local cur = tbl
    for seg in string.gmatch(path, "[^%.]+") do
        if type(cur) ~= "table" then return nil end
        cur = cur[seg]
    end
    return cur
end

local function _deepSet(tbl, path, value)
    if type(tbl) ~= "table" or type(path) ~= "string" then return false end
    local parts = {}
    for seg in string.gmatch(path, "[^%.]+") do
        table.insert(parts, seg)
    end
    if #parts == 0 then return false end
    local cur = tbl
    for i = 1, #parts - 1 do
        local key = parts[i]
        if type(cur[key]) ~= "table" then
            cur[key] = {}
        end
        cur = cur[key]
    end
    cur[parts[#parts]] = value
    return true
end

local function _deepMerge(target, source)
    if type(source) ~= "table" then return target end
    for k, v in pairs(source) do
        if type(v) == "table" and type(target[k]) == "table" then
            _deepMerge(target[k], v)
        elseif target[k] == nil or type(target[k]) == type(v) then
            target[k] = _deepCopy(v)
        end
    end
    return target
end

local function clamp(x, min, max)
    if x < min then return min end
    if x > max then return max end
    return x
end

local function lerp(a, b, t)
    return a + (b - a) * t
end

local function smoothstep(edge0, edge1, x)
    local t = clamp((x - edge0) / (edge1 - edge0), 0, 1)
    return t * t * (3 - 2 * t)
end

local LOG_MAX = 200
local _logBuffer = {}

function Module:log(level, tag, fmt, ...)
    local ok, msg = pcall(string.format, tostring(fmt), ...)
    if not ok then msg = tostring(fmt) end
    local entry = {
        time = os.clock(),
        level = level or "INFO",
        tag = tag or "Core",
        msg = msg,
    }
    table.insert(_logBuffer, entry)
    if #_logBuffer > LOG_MAX then
        table.remove(_logBuffer, 1)
    end
    if level == "ERROR" or level == "WARN" then
        warn(string.format("[VX:%s] %s", entry.tag, entry.msg))
    end
end

function Module:getLogs()
    return _logBuffer
end

function Module:getPerformanceMode()
    local setting = self:getSetting("performanceMode") or "auto"
    if setting ~= "auto" then return setting end
    if UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled then
        return "low"
    end
    local dt = RunService.RenderStepped:Wait()
    if dt > 0.030 then
        return "low"
    elseif dt < 0.018 then
        return "high"
    end
    return "normal"
end

function Module:getTickRate()
    local mode = self._perfMode or "normal"
    if mode == "low" then return 30 end
    return 60
end

function Module:getSetting(path)
    return _deepGet(self._settings, path)
end

function Module:setSetting(path, value)
    local old = _deepGet(self._settings, path)
    if old == value then return true end
    local ok = _deepSet(self._settings, path, value)
    if ok and _G.VX and _G.VX.bus then
        _G.VX.bus:emit("settings.changed", { path = path, old = old, new = value })
    end
    return ok
end

function Module:resetSetting(path)
    local def = _deepGet(_defaultSettings, path)
    if def == nil then return false end
    return self:setSetting(path, _deepCopy(def))
end

function Module:resetAll()
    local R = _G.VX and _G.VX.registry
    if R then
        for key, entry in pairs(R:list("settings")) do
            if not self:resetSetting(key) and entry.schema and entry.schema.default ~= nil then
                self:setSetting(key, _deepCopy(entry.schema.default))
            end
        end
    end
    return true
end

function Module:_migrateLegacy()
    local legacy = _G.DeepSec90
    if type(legacy) == "table" and type(legacy.settings) == "table" then
        _deepMerge(self._settings, legacy.settings)
        self:log("INFO", "Core", "Migrated settings from _G.DeepSec90")
    end
    if type(_G.VX and _G.VX.settings) == "table" then
        _deepMerge(self._settings, _G.VX.settings)
    end
end

