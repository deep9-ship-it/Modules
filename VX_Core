function Module:Start()
    _G.VX.clamp      = function(v, mn, mx) return math.max(mn, math.min(mx, v)) end
    _G.VX.lerp       = function(a, b, t) return a + (b - a) * t end
    _G.VX.smoothstep = function(t) return t * t * (3 - 2 * t) end

    _G.VX.logBuffer = {}
    _G.VX.log = function(msg, level)
        level = level or "info"
        if level == "error" or level == "warn" then warn("[VX] " .. msg)
        else print("[VX] " .. msg) end
        table.insert(_G.VX.logBuffer, { msg = msg, level = level, t = tick() })
        while #_G.VX.logBuffer > 200 do table.remove(_G.VX.logBuffer, 1) end
    end

    local uis = game:GetService("UserInputService")
    if self.settings.performanceMode == "auto" then
        self.settings._effectivePerformance = (uis.TouchEnabled and not uis.KeyboardEnabled) and "low" or "normal"
    else
        self.settings._effectivePerformance = self.settings.performanceMode
    end
    print("[VX] Performance: " .. self.settings._effectivePerformance)

    local events = {
        "vehicle.entered","vehicle.exited","vehicle.stateChanged",
        "vehicle.shift","vehicle.backfire","vehicle.launchStart","vehicle.launchRelease",
        "vehicle.twostepStart","vehicle.twostepEnd",
        "engine.revLimit","engine.coldStartEnd",
        "input.throttle","input.brake","input.steer","input.clutch",
        "settings.changed",
        "authority.lost","authority.verified",
        "turbo.blowoff","turbo.flutter","turbo.spool",
    }
    for _, name in ipairs(events) do _G.VX.bus:on(name, function() end) end
    print("[VX] " .. #events .. " event names registered")
end

function Module:Stop()
    _G.VX.clamp      = nil
    _G.VX.lerp       = nil
    _G.VX.smoothstep = nil
    _G.VX.log        = nil
    _G.VX.logBuffer  = nil
end

function Module:heartbeat() return true end

