function Module:_refreshDiagnostics()
    if not self._diagFrame or not self._diagFrame.Visible then return end
    local now = os.clock()
    if now - self._lastDiagUpdate < 0.25 then return end
    self._lastDiagUpdate = now

    local all = _G.VX.diagnostics and _G.VX.diagnostics.getAll() or {}
    local keys = {}
    for k in pairs(all) do
        table.insert(keys, k)
    end
    table.sort(keys)

    for _, k in ipairs(keys) do
        local entry = all[k]
        local lbl = self._diagLabels[k]
        if not lbl then
            lbl = Instance.new("TextLabel")
            lbl.Size = UDim2.new(1, -8, 0, 18)
            lbl.BackgroundTransparency = 1
            lbl.Font = Enum.Font.Code
            lbl.TextSize = 11
            lbl.TextXAlignment = Enum.TextXAlignment.Left
            lbl.TextColor3 = C.text
            lbl.Parent = self._diagScroll
            self._diagLabels[k] = lbl
        end
        local status = entry.status
        lbl.TextColor3 = (status == "error") and C.red or ((status == "warn") and C.amber or C.text)
        lbl.Text = string.format("%-22s %s %s", entry.schema.label or k, tostring(entry.value), entry.schema.unit or "")
    end
end

function Module:toggleVideoMode()
    local nextVal = not _getSetting("ui.videoMode", false)
    if _G.VX.setSetting then
        _G.VX.setSetting("ui.videoMode", nextVal)
    elseif nextVal then
        self:_enterVideoMode()
    else
        self:_exitVideoMode()
    end
end

function Module:_enterVideoMode()
    if self._videoMode then return end
    self._videoMode = true
    self._hiddenGuis = {}

    if self._dash then self._dash.Visible = false end
    if self._notifContainer then self._notifContainer.Visible = false end
    if self._telFrame then self._telFrame.Visible = false end
    if self._diagFrame then self._diagFrame.Visible = false end

    local player = Players.LocalPlayer
    local pg = player and player:FindFirstChild("PlayerGui")
    if pg then
        for _, child in ipairs(pg:GetChildren()) do
            if child:IsA("ScreenGui") and child ~= self._gui and child.Name ~= "VX_Panel" then
                self._hiddenGuis[child] = child.Enabled
                child.Enabled = false
            end
        end
    end

    if _G.VX.Panel and type(_G.VX.Panel.setHidden) == "function" then
        _G.VX.Panel:setHidden(true)
    end
end

function Module:_exitVideoMode()
    if not self._videoMode then return end
    self._videoMode = false

    for gui, wasEnabled in pairs(self._hiddenGuis) do
        if gui and gui.Parent then
            gui.Enabled = wasEnabled
        end
    end
    self._hiddenGuis = {}

    if self._notifContainer then self._notifContainer.Visible = true end
    if self._telFrame then self._telFrame.Visible = _getSetting("visuals.telemetry", false) end
    if self._diagFrame then self._diagFrame.Visible = _getSetting("ui.diagnostics", false) end

    if _G.VX.Panel and type(_G.VX.Panel.setHidden) == "function" then
        _G.VX.Panel:setHidden(false)
    end
end

function Module:_update()
    if not self._dash then return end
    local st = self.state:get()
    local active = (st ~= "Disabled" and st ~= "Exiting") and (_getSetting("enabled", true) ~= false) and not self._videoMode
    self._dash.Visible = active

    if self._diagFrame and self._diagFrame.Visible then
        self:_refreshDiagnostics()
    end
    if not active then return end

    local auth = _G.VX.Modules and _G.VX.Modules.Authority
    local root = auth and auth:getRoot()
    local rawSpeed = (root and root.PrimaryPart) and root.PrimaryPart.AssemblyLinearVelocity.Magnitude or 0
    local units = _getSetting("ui.units", "KMH")
    local speedVal = (units == "MPH") and (rawSpeed * 0.389) or (rawSpeed * 0.626)

    self._speedLbl.Text = tostring(math.floor(speedVal + 0.5))
    self._unitLbl.Text = (units == "MPH") and "MPH" or "KM/H"

    local gear = self.powertrain.gear or 0
    self._gearLbl.Text = (gear == -1) and "R" or ((gear == 0) and "N" or tostring(gear))

    local prof = self.profiles:current()
    local maxRpm = (prof and prof.maxRPM) or 9000
    local redline = (prof and prof.redline) or 7800
    local rpm = self.powertrain.rpm or 0
    local pct = math.clamp(rpm / maxRpm, 0, 1)
    local redPct = math.clamp(redline / maxRpm, 0.5, 0.98)

    self._rpmLbl.Text = string.format("%d RPM", math.floor(rpm))
    self._rpmFill.Size = UDim2.new(pct, 0, 1, 0)
    self._rpmFill.BackgroundColor3 = (rpm >= redline) and C.red or ((rpm >= redline * 0.86) and C.amber or C.green)
    self._redMark.Position = UDim2.new(redPct, 0, 0, -1)

    local psi = self.drive.boostPSI or 0
    local stg = _getSetting("turboStage", 1)
    local stageCfg = self.core and self.core._config and self.core._config.turboStages and self.core._config.turboStages[stg]
    local maxPsi = (stageCfg and stageCfg.psi) or 21
    self._boostLbl.Text = string.format("%.1f PSI", psi)
    self._boostFill.Size = UDim2.new(math.clamp(psi / maxPsi, 0, 1), 0, 1, 0)

    self._thrFill.Size = UDim2.new(math.clamp(self.powertrain.throttle or 0, 0, 1), 0, 1, 0)
    self._brkFill.Size = UDim2.new(math.clamp(self.powertrain.brake or 0, 0, 1), 0, 1, 0)

    local dt = _getSetting("drivetrain", "RWD")
    local dm = string.upper(_getSetting("physics.driveMode", "Normal"))
    self._metaLbl.Text = string.format("%s  |  %s  |  STG %d  |  %s", dt, dm, stg, prof and prof.name or "Default")

    local flags = {}
    if self.drive.tcsActive then table.insert(flags, "TCS") end
    if self.drive.absActive then table.insert(flags, "ABS") end
    if self.powertrain.isRevLimiting then table.insert(flags, "REV") end
    if self.powertrain.twostepActive then table.insert(flags, "2-STEP") end
    if self.powertrain.launchState == "Armed" or self.powertrain.launchState == "Ready" then
        table.insert(flags, "LC:" .. string.upper(self.powertrain.launchState))
    end
    if self.chassis.isSpinning then table.insert(flags, "SLIP") end
    self._flagsLbl.Text = table.concat(flags, " • ")
    self._flagsLbl.TextColor3 = self.chassis.isSpinning and C.amber or C.green

    local bTemp = self.drive.brakeTemp or 60
    self._brakeTempLbl.Text = string.format("BRK %.0fC", bTemp)
    self._brakeTempLbl.TextColor3 = (bTemp >= 550) and C.red or ((bTemp >= 350) and C.amber or C.muted)

    if self._telFrame and self._telFrame.Visible then
        local tt = self.chassis.tireTemp or {}
        self._telLabels.State.Text = string.format("State:    %s", st)
        self._telLabels.Speed.Text = string.format("Speed:    %.1f %s", speedVal, units)
        self._telLabels.RPM.Text = string.format("RPM:      %d / %d", math.floor(rpm), maxRpm)
        self._telLabels.Gear.Text = string.format("Gear:     %s", self._gearLbl.Text)
        self._telLabels.Boost.Text = string.format("Boost:    %.1f / %d PSI", psi, maxPsi)
        self._telLabels.Inputs.Text = string.format("T/B/S:    %.0f%% / %.0f%% / %.2f", (self.powertrain.throttle or 0) * 100, (self.powertrain.brake or 0) * 100, self.powertrain.steer or 0)
        self._telLabels.Slip.Text = string.format("Slip:     %.2f (%s)", self.chassis.slipRatio or 0, self.chassis.isSpinning and "SPIN" or "GRIP")
        self._telLabels.Slope.Text = string.format("Slope:    %.1f deg", self.chassis.slopeAngle or 0)
        self._telLabels.Friction.Text = string.format("Friction: F:%.2f R:%.2f", self.chassis.frontFriction or 0, self.chassis.rearFriction or 0)
        self._telLabels.Tires.Text = string.format("Tires:    F:%.0fC R:%.0fC", tt.front or 40, tt.rear or 40)
        self._telLabels.Brakes.Text = string.format("Brakes:   %.0f C", bTemp)
    end
end

function Module:heartbeat()
    return self._gui ~= nil and self._gui.Parent ~= nil
end

function Module:Stop()
    self:_exitVideoMode()
    self:_clearConns()
    if self._gui then
        self._gui:Destroy()
        self._gui = nil
    end
    _G.VX.UI = nil
end

return Module
