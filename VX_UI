--[[
    VX_UI v3.0.0
    Dashboard, telemetry HUD, notifications, video mode, diagnostics panel.

    Depends on: Core, Profiles, Powertrain, DriveSystem, Chassis, VehicleState
    Exposes:
      notify(text, duration)
      toggleVideoMode()
      isVideoMode()
      toggleDiagnostics()
      openPanel() / closePanel()  (delegates to Panel module)
      getDashboardRefs()

    Listens:
      vehicle.stateChanged
      settings.changed
      vehicle.shift
      vehicle.launchRelease
]]

local VX = _G.VX
if not VX or not VX.Framework then error("VX_UI requires VX_Kernel") end

local TweenService = game:GetService("TweenService")
local Players = game:GetService("Players")
local Player = Players.LocalPlayer
local PlayerGui = Player:WaitForChild("PlayerGui")

local Module = VX.Framework.Module.new({
    Name = "UI",
    Dependencies = { "Core", "Profiles", "Powertrain", "DriveSystem", "Chassis", "VehicleState" },
    Version = "3.0.0",
})

-- ==================== STATE ====================
function Module:Construct()
    self.gui = nil
    self.dashboard = nil
    self.telemetry = nil
    self.diagnosticsPanel = nil
    self.settingsBtn = nil
    self.notifQueue = {}
    self.notifActive = false

    self.dashboardRefs = {
        root       = nil,
        speedText  = nil,
        unitText   = nil,
        gearText   = nil,
        psiText    = nil,
        rpmFill    = nil,
        rpmFlash   = nil,
        launchInd  = nil,
        lastFill   = 0,
        fillTween  = nil,
        flashPhase = 0,
    }

    self.dashboardVisible = false

    self._loopThread = nil
    self._running = false
    self._updateInterval = 1/20

    -- Video mode
    self.videoMode = false
    self.hiddenElements = {}  -- [instance] = originalVisible
    self.videoModeWatcher = nil

    -- Diagnostics
    self.diagOpen = false
    self.diagRefs = {}

    -- Notifications
    self.notifParent = nil
    self.notifScreen = nil
end

function Module:Init(deps)
    self.core        = deps.Core
    self.profiles    = deps.Profiles
    self.powertrain  = deps.Powertrain
    self.drive       = deps.DriveSystem
    self.chassis     = deps.Chassis
    self.state       = deps.VehicleState
end

function Module:Start()
    _G.VX.UI = self

    self:_createScreenGui()
    self:_createDashboard()
    self:_createSettingsButton()
    self:_createDiagnosticsPanel()

    _G.VX.bus:on("vehicle.stateChanged", function(evt) self:_onStateChange(evt) end)
    _G.VX.bus:on("settings.changed",     function(evt) self:_onSettingChange(evt) end)
    _G.VX.bus:on("vehicle.shift",        function(evt) self:_onShift(evt) end)
    _G.VX.bus:on("vehicle.launchRelease", function(evt) self:_onLaunchRelease(evt) end)

    print("[VX] UI ready")
end

function Module:Stop()
    self:_stopLoop()
    if self.gui then
        pcall(function() self.gui:Destroy() end)
        self.gui = nil
    end
    if _G.VX.UI == self then _G.VX.UI = nil end
end

function Module:heartbeat()
    return true
end

-- ==================== HELPERS ====================
local function corner(obj, r)
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, r or 12)
    c.Parent = obj
    return c
end

local function stroke(obj, col, thick)
    local s = Instance.new("UIStroke")
    s.Color = col or Color3.fromRGB(100, 200, 255)
    s.Thickness = thick or 2
    s.Transparency = 0.3
    s.Parent = obj
    return s
end

