function Module:toggleDiagnostics()
    if not self.diagnosticsPanel then return end
    self.diagOpen = not self.diagOpen
    self.diagnosticsPanel.Visible = self.diagOpen
    if self.diagOpen then self:_refreshDiagnostics() end
end

function Module:_refreshDiagnostics()
    if not self.diagOpen then return end
    local scroll = self.diagRefs.scroll
    if not scroll then return end
    for _, child in ipairs(scroll:GetChildren()) do
        if child:IsA("TextLabel") then child:Destroy() end
    end
    local all = _G.VX.diagnostics.getAll()
    local keys = {}
    for k in pairs(all) do table.insert(keys, k) end
    table.sort(keys)
    local y = 0
    for _, key in ipairs(keys) do
        local diag = all[key]
        local text
        if type(diag.value) == "table" then text = string.format("%s: %s", key, tostring(diag.value.value))
        else text = string.format("%s: %s", key, tostring(diag.value)) end
        local l = Instance.new("TextLabel")
        l.Size = UDim2.new(1,-6,0,16)
        l.Position = UDim2.new(0,0,0,y)
        l.Text = text
        l.TextColor3 = Color3.fromRGB(180,220,255)
        l.BackgroundTransparency = 1
        l.TextXAlignment = Enum.TextXAlignment.Left
        l.TextSize = 11
        l.Font = Enum.Font.Code
        l.ZIndex = 101
        l.Parent = scroll
        y = y + 16
    end
    scroll.CanvasSize = UDim2.new(0,0,0,y+20)
    task.delay(1.0, function() if self.diagOpen then self:_refreshDiagnostics() end end)
end

function Module:_onSettingChange(evt)
    if not evt then return end
    if evt.path == "physics.telemetryHud" then
        if not self.telemetry then self:_createTelemetry() end
        self.telemetry.Visible = evt.new
    elseif evt.path == "videoMode" then
        if evt.new ~= self.videoMode then self:toggleVideoMode() end
    end
end

function Module:_onShift(evt)
    if evt.emergency then self:notify("EMERGENCY DOWNSHIFT", 1.2) end
end

function Module:_onLaunchRelease(evt)
    local q = evt.quality or "miss"
    if q == "perfect" then self:notify("PERFECT LAUNCH!", 1.5)
    elseif q == "good" then self:notify("Good launch", 1.2) end
end

function Module:getDashboardRefs() return self.dashboardRefs end

return Module
