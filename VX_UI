function Module:_onStateChange(evt)
    if evt.to == "Ready" or evt.to == "Idle" then
        self.dashboard.Visible = true
        self.settingsBtn.Visible = true
        self:_startLoop()
    elseif evt.to == "Exiting" or evt.to == "Disabled" then
        self.dashboard.Visible = false
        self.settingsBtn.Visible = false
        self:_stopLoop()
        if self.videoMode then self:toggleVideoMode() end
    end
end

function Module:_startLoop()
    if self._running then return end
    self._running = true
    local perf = self.core.settings._effectivePerformance
    self._updateInterval = (perf == "low") and 0.1 or 0.05
    self._loopThread = task.spawn(function()
        while self._running do
            task.wait(self._updateInterval)
            pcall(function() self:_update() end)
        end
    end)
end

function Module:_stopLoop()
    if not self._running then return end
    self._running = false
    if self._loopThread then pcall(function() task.cancel(self._loopThread) end); self._loopThread = nil end
end

function Module:_update()
    if not self.dashboard or not self.dashboard.Visible then return end
    local speed = 0
    local handle = _G.VX.Authority and _G.VX.Authority:getHandle()
    if handle and handle.root and handle.root.PrimaryPart then
        local v = handle.root.PrimaryPart.AssemblyLinearVelocity
        speed = math.floor(Vector3.new(v.X, 0, v.Z).Magnitude * 0.313)
    end

    local rpm = self.powertrain:getRPM()
    local gear = self.powertrain:getGear()
    local boost = self.drive:getBoost()
    local prof = self.profiles:current()
    local isLimited = self.powertrain:isRevLimiting()

    self.dashboardRefs.speedText.Text = tostring(speed)
    self.dashboardRefs.speedText.TextColor3 = speed > 100 and Color3.fromRGB(255,220,100) or Color3.fromRGB(255,255,255)

    local gearLabel = (gear == -1) and "R" or tostring(gear)
    self.dashboardRefs.gearText.Text = "GEAR " .. gearLabel
    if isLimited then self.dashboardRefs.gearText.TextColor3 = Color3.fromRGB(255,40,40)
    elseif rpm > prof.redlineRPM * 0.9 then self.dashboardRefs.gearText.TextColor3 = Color3.fromRGB(255,200,40)
    else self.dashboardRefs.gearText.TextColor3 = Color3.fromRGB(255,255,255) end

    -- PSI: direct boost value (already in PSI)
    self.dashboardRefs.psiText.Text = string.format("%.1f PSI", boost)
    if boost > 60 then self.dashboardRefs.psiText.TextColor3 = Color3.fromRGB(255,100,100)
    elseif boost > 30 then self.dashboardRefs.psiText.TextColor3 = Color3.fromRGB(240,200,60)
    else self.dashboardRefs.psiText.TextColor3 = Color3.fromRGB(100,200,255) end

    local fillTarget = math.clamp((rpm - prof.idleRPM) / math.max(prof.maxRPM - prof.idleRPM, 1), 0, 1)
    if math.abs(fillTarget - self.dashboardRefs.lastFill) > 0.005 then
        self.dashboardRefs.lastFill = fillTarget
        if self.dashboardRefs.fillTween then pcall(function() self.dashboardRefs.fillTween:Cancel() end) end
        self.dashboardRefs.fillTween = TweenService:Create(self.dashboardRefs.rpmFill, TweenInfo.new(0.06, Enum.EasingStyle.Linear), { Size = UDim2.new(fillTarget, 0, 1, 0) })
        self.dashboardRefs.fillTween:Play()
    end

    if isLimited then
        self.dashboardRefs.flashPhase = self.dashboardRefs.flashPhase + self._updateInterval
        self.dashboardRefs.rpmFlash.BackgroundTransparency = 0.5 + math.sin(self.dashboardRefs.flashPhase * 20) * 0.4
    else
        self.dashboardRefs.rpmFlash.BackgroundTransparency = 1
        self.dashboardRefs.flashPhase = 0
    end

    -- Launch indicator
    if self.powertrain:isTwostepActive and self.powertrain:isTwostepActive() then
        self.dashboardRefs.launchInd.Visible = true
        self.dashboardRefs.launchInd.Text = "2-STEP"
        self.dashboardRefs.launchInd.TextColor3 = Color3.fromRGB(255,100,50)
        self.dashboardRefs.launchInd.TextTransparency = 0.5 + math.sin(os.clock() * 25) * 0.5
    elseif self.powertrain:getLaunchState() == "holding" then
        self.dashboardRefs.launchInd.Visible = true
        self.dashboardRefs.launchInd.Text = "LAUNCH READY"
        self.dashboardRefs.launchInd.TextColor3 = Color3.fromRGB(255,220,60)
        self.dashboardRefs.launchInd.TextTransparency = 0.5 + math.sin(os.clock() * 12) * 0.5
    elseif self.powertrain:getLaunchState() == "releasing" then
        self.dashboardRefs.launchInd.Visible = true
        self.dashboardRefs.launchInd.Text = "GO!"
        self.dashboardRefs.launchInd.TextColor3 = Color3.fromRGB(255,220,60)
        self.dashboardRefs.launchInd.TextTransparency = 0
    else
        self.dashboardRefs.launchInd.Visible = false
    end

    if self.telemetry and self.telemetry.Visible then self:_updateTelemetry() end
end

-- Notifications (abbreviated)
function Module:notify(text, duration)
    if self.videoMode then return end
    duration = duration or 2.5
    local n = Instance.new("TextLabel")
    n.Size = UDim2.new(0.30, 0, 0.06, 0)
    n.Position = UDim2.new(0.35, 0, 0.15, -#self.notifQueue * 60)
    n.BackgroundColor3 = Color3.fromRGB(20,20,25)
    n.BackgroundTransparency = 0.15
    n.TextColor3 = Color3.fromRGB(255,255,255)
    n.TextScaled = true
    n.Font = Enum.Font.GothamBold
    n.Text = text
    n.ZIndex = 55
    corner(n, 12); stroke(n, Color3.fromRGB(100,200,255), 2)
    n.Parent = self.notifScreen
    table.insert(self.notifQueue, n)
    local fade = TweenService:Create(n, TweenInfo.new(0.35), { BackgroundTransparency = 1, TextTransparency = 1 })
    task.delay(duration, function()
        fade:Play(); fade.Completed:Wait(); pcall(function() n:Destroy() end)
        for i, item in ipairs(self.notifQueue) do if item == n then table.remove(self.notifQueue, i); break end end
    end)
end

function Module:_createTelemetry()
    if self.telemetry then return end
    local t = Instance.new("Frame")
    t.Size = UDim2.new(0, 220, 0, 240)
    t.Position = UDim2.new(1, -240, 0.4, 0)
    t.BackgroundColor3 = Color3.fromRGB(10,10,15)
    t.BackgroundTransparency = 0.25
    t.Visible = false
    t.ZIndex = 10
    corner(t, 10); stroke(t, Color3.fromRGB(80,160,200), 1.5)
    t.Parent = self.gui
    local keys = {"RPM","Gear","Slip","Grip Front","Grip Rear","Slope","Shift","Launch","Boost","Tire Temp"}
    local refs = {}
    for i, key in ipairs(keys) do
        local l = Instance.new("TextLabel")
        l.Size = UDim2.new(1,-12,0,14)
        l.Position = UDim2.new(0,6,0,6+(i-1)*14)
        l.Text = key .. ": --"
        l.TextColor3 = Color3.fromRGB(150,220,255)
        l.BackgroundTransparency = 1
        l.TextXAlignment = Enum.TextXAlignment.Left
        l.TextSize = 11
        l.Font = Enum.Font.Code
        l.ZIndex = 11
        l.Parent = t
        refs[key] = l
    end
    t.Visible = self.core.settings.physics.telemetryHud
    self.telemetry = t
    self.telemetryRefs = refs
    self:_makeDraggable(t)
end

function Module:_updateTelemetry()
    if not self.telemetryRefs then return end
    local r = self.telemetryRefs
    r["RPM"].Text = string.format("RPM: %d", math.floor(self.powertrain:getRPM()))
    r["Gear"].Text = string.format("Gear: %s", tostring(self.powertrain:getGear()))
    r["Slip"].Text = string.format("Slip: %.2f", self.chassis:getSlipRatio())
    r["Grip Front"].Text = string.format("Front μ: %.2f", self.chassis:getEffectiveGripFront())
    r["Grip Rear"].Text = string.format("Rear μ: %.2f", self.chassis:getEffectiveGripRear())
    r["Slope"].Text = string.format("Slope: %.1f°", self.chassis:getSlopeAngle())
    r["Shift"].Text = string.format("Shift: %s", self.powertrain:getShiftState())
    r["Launch"].Text = string.format("Launch: %s", self.powertrain:getLaunchState())
    r["Boost"].Text = string.format("Boost: %.1f PSI", self.drive:getBoost())
    r["Tire Temp"].Text = string.format("Tire T: %.2f", self.chassis:getTireTemp("front"))
end

-- ==================== VIDEO MODE (REWRITE) ====================
function Module:toggleVideoMode()
    self.videoMode = not self.videoMode
    _G.VX.setSetting("videoMode", self.videoMode)
    if self.videoMode then self:_enterVideoMode(); self:notify("Video Mode: ON", 1.5)
    else self:_exitVideoMode(); self:notify("Video Mode: OFF", 1.5) end
end

function Module:isVideoMode() return self.videoMode end

function Module:_enterVideoMode()
    self.hiddenElements = {}

    local function tryHide(inst)
        if inst and inst:IsA("GuiObject") and inst.Visible then
            self.hiddenElements[inst] = inst.Visible
            inst.Visible = false
        end
    end

    -- Hide our telemetry, diagnostics, notifications
    if self.telemetry then tryHide(self.telemetry) end
    if self.diagnosticsPanel then tryHide(self.diagnosticsPanel) end
    if self.notifScreen then self.notifScreen.Visible = false end

    -- Hide ALL MainGUIHandler descendants EXCEPT pedals, steering, and their ancestors
    pcall(function()
        local handler = PlayerGui:FindFirstChild("MainGUIHandler")
        if not handler then return end

        local keepRoots = {}
        local function addKeepRoot(inst)
            if inst then keepRoots[inst] = true end
        end

        -- Find Pedals and Steering in current UI
        for _, descendant in ipairs(handler:GetDescendants()) do
            if descendant.Name == "Pedals" or descendant.Name == "Steering" then
                addKeepRoot(descendant)
                local cur = descendant
                while cur and cur ~= handler do
                    addKeepRoot(cur)
                    cur = cur.Parent
                end
            end
        end

        -- Now hide everything else
        for _, descendant in ipairs(handler:GetDescendants()) do
            if descendant:IsA("GuiObject") then
                if not keepRoots[descendant] then
                    -- Make sure it's not a descendant of a kept root
                    local isKept = false
                    for kept, _ in pairs(keepRoots) do
                        if descendant == kept or descendant:IsDescendantOf(kept) then
                            isKept = true
                            break
                        end
                    end
                    if not isKept then
                        tryHide(descendant)
                    end
                end
            end
        end
    end)

    if _G.VX.Panel and _G.VX.Panel:isOpen() then pcall(function() _G.VX.Panel:close() end) end

    self.videoModeWatcher = task.spawn(function()
        while self.videoMode do
            task.wait(1.0)
            if self.videoMode then
                pcall(function()
                    local handler = PlayerGui:FindFirstChild("MainGUIHandler")
                    if not handler then return end
                    for _, descendant in ipairs(handler:GetDescendants()) do
                        if descendant:IsA("GuiObject") and descendant.Visible then
                            -- Skip if part of keep list
                            local isKept = false
                            for kept, _ in pairs(self.hiddenElements) do
                                if descendant == kept or descendant:IsDescendantOf(kept) then
                                    -- Actually hiddenElements stores hidden ones; we need a keep list
                                end
                            end
                        end
                    end
                    -- Simpler re-hide: any newly-visible UI element not in keep list → hide
                    -- Recompute keep roots
                    local keepRoots = {}
                    for _, d in ipairs(handler:GetDescendants()) do
                        if d.Name == "Pedals" or d.Name == "Steering" then
                            keepRoots[d] = true
                            local cur = d
                            while cur and cur ~= handler do
                                keepRoots[cur] = true
                                cur = cur.Parent
                            end
                        end
                    end
                    for _, d in ipairs(handler:GetDescendants()) do
                        if d:IsA("GuiObject") and d.Visible then
                            local isKept = false
                            for kept, _ in pairs(keepRoots) do
                                if d == kept or d:IsDescendantOf(kept) then
                                    isKept = true; break
                                end
                            end
                            if not isKept then
                                self.hiddenElements[d] = d.Visible
                                d.Visible = false
                            end
                        end
                    end
                end)
            end
        end
    end)
end

function Module:_exitVideoMode()
    for inst, wasVisible in pairs(self.hiddenElements) do
        if inst and inst.Parent then inst.Visible = wasVisible end
    end
    self.hiddenElements = {}
    if self.notifScreen then self.notifScreen.Visible = true end
    if self.videoModeWatcher then pcall(function() task.cancel(self.videoModeWatcher) end); self.videoModeWatcher = nil end
end

