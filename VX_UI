function Module:notify(title, msg, color, duration)
    if not self._notifContainer or self._videoMode then return end
    if not _getSetting("visuals.notifications", true) then return end

    local accent = color or C.accent
    local toast = Instance.new("Frame")
    toast.Size = UDim2.new(1, 0, 0, 44)
    toast.BackgroundColor3 = C.bg
    toast.BackgroundTransparency = 0.12
    toast.BorderSizePixel = 0
    toast.Parent = self._notifContainer
    _corner(toast, 8)
    _stroke(toast, accent, 0.35)

    local bar = Instance.new("Frame")
    bar.Size = UDim2.new(0, 4, 1, -10)
    bar.Position = UDim2.new(0, 6, 0, 5)
    bar.BackgroundColor3 = accent
    bar.BorderSizePixel = 0
    bar.Parent = toast
    _corner(bar, 2)

    local titleLbl = Instance.new("TextLabel")
    titleLbl.Size = UDim2.new(1, -24, 0, 16)
    titleLbl.Position = UDim2.new(0, 16, 0, 5)
    titleLbl.BackgroundTransparency = 1
    titleLbl.Font = Enum.Font.GothamBold
    titleLbl.TextSize = 11
    titleLbl.TextXAlignment = Enum.TextXAlignment.Left
    titleLbl.TextColor3 = accent
    titleLbl.Text = string.upper(tostring(title))
    titleLbl.Parent = toast

    local msgLbl = Instance.new("TextLabel")
    msgLbl.Size = UDim2.new(1, -24, 0, 18)
    msgLbl.Position = UDim2.new(0, 16, 0, 21)
    msgLbl.BackgroundTransparency = 1
    msgLbl.Font = Enum.Font.GothamSemibold
    msgLbl.TextSize = 12
    msgLbl.TextXAlignment = Enum.TextXAlignment.Left
    msgLbl.TextColor3 = C.text
    msgLbl.Text = tostring(msg)
    msgLbl.Parent = toast

    task.delay(duration or 2.5, function()
        if toast and toast.Parent then
            TweenService:Create(toast, TweenInfo.new(0.25), { BackgroundTransparency = 1 }):Play()
            TweenService:Create(bar, TweenInfo.new(0.25), { BackgroundTransparency = 1 }):Play()
            TweenService:Create(titleLbl, TweenInfo.new(0.25), { TextTransparency = 1 }):Play()
            TweenService:Create(msgLbl, TweenInfo.new(0.25), { TextTransparency = 1 }):Play()
            task.wait(0.26)
            if toast and toast.Parent then toast:Destroy() end
        end
    end)
end

