--[[
    VX_UI.lua — GT3 Carbon Middle-Bottom Dashboard, Telemetry (F2), Diagnostics (F3) & Video Mode (F4)
    Version: 3.4.1 (Aligned to VX_Core v3.2.0 + VX_Authority v3.0.2 + VX_Powertrain v3.5.0 + VX_DriveSystem v3.5.1)
]]

local VX = _G.VX
if not VX or not VX.Framework then
    error("[VX_UI] Requires VX_Kernel")
end

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local Module = VX.Framework.Module.new({
    Name = "UI",
    Dependencies = { "Core", "Profiles", "Powertrain", "DriveSystem", "Chassis", "VehicleState" },
    Version = "3.4.1",
})

local GT3 = {
    carbonDeep = Color3.fromRGB(10, 11, 14),
    carbon     = Color3.fromRGB(18, 20, 26),
    carbonCard = Color3.fromRGB(26, 29, 38),
    carbonLine = Color3.fromRGB(44, 49, 64),
    amber      = Color3.fromRGB(255, 180, 0),
    cyan       = Color3.fromRGB(0, 212, 255),
    green      = Color3.fromRGB(34, 229, 138),
    crimson    = Color3.fromRGB(255, 42, 60),
    text       = Color3.fromRGB(244, 246, 250),
    muted      = Color3.fromRGB(140, 148, 168),
}

local function _getSetting(path, fallback)
    if _G.VX and type(_G.VX.getSetting) == "function" then
        local v = _G.VX.getSetting(path)
        if v ~= nil then return v end
    end
    return fallback
end

local function _setSetting(path, val)
    if _G.VX and type(_G.VX.setSetting) == "function" then
        _G.VX.setSetting(path, val)
    end
end

local function _corner(parent, r)
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, r or 8)
    c.Parent = parent
    return c
end

local function _stroke(parent, color, trans, thickness)
    local s = Instance.new("UIStroke")
    s.Color = color or GT3.carbonLine
    s.Transparency = trans or 0.35
    s.Thickness = thickness or 1
    s.Parent = parent
    return s
end

function Module:_trackConn(conn)
    if conn then table.insert(self._conns, conn) end
    return conn
end

function Module:_clearConns()
    for _, c in ipairs(self._conns) do
        if typeof(c) == "RBXScriptConnection" then
            c:Disconnect()
        elseif type(c) == "table" and c.Disconnect then
            c:Disconnect()
        end
    end
    self._conns = {}
end

function Module:Construct()
    self._conns = {}
    self._gui = nil
    self._dash = nil
    self._notifContainer = nil
    self._telFrame = nil
    self._diagFrame = nil
    self._shiftLeds = {}
    self._telLabels = {}
    self._diagLabels = {}
    self._hiddenGuis = {}
    self._diagOpen = false
    self._lastDiagUpdate = 0
    self._lastAbsCount = 0
    self._lastAbsTime = 0
    self._videoMode = false
end

function Module:Init(deps)
    self.core = deps.Core
    self.profiles = deps.Profiles
    self.powertrain = deps.Powertrain
    self.drive = deps.DriveSystem
    self.chassis = deps.Chassis
    self.state = deps.VehicleState
    _G.VX.UI = self
end

function Module:Start()
    self:_createGui()

    self:_trackConn(_G.VX.bus:on("vehicle.stateChanged", function(evt)
        if not evt then return end
        if evt.to == "Ready" then
            local prof = self.profiles:current()
            self:notify("GT3 TELEMETRY", (prof and prof.name or "Engine") .. " Online", GT3.amber, 2.4)
        elseif evt.to == "Disabled" then
            if self._dash then self._dash.Visible = false end
        end
    end))

    self:_trackConn(_G.VX.bus:on("vehicle.shift", function(evt)
        if self._gearBox then
            local col = (evt and evt.emergency) and GT3.crimson or GT3.amber
            self._gearBox.BackgroundColor3 = col
            self._gearLbl.TextColor3 = GT3.carbonDeep
            TweenService:Create(self._gearBox, TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                BackgroundColor3 = GT3.carbon,
            }):Play()
            TweenService:Create(self._gearLbl, TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                TextColor3 = GT3.amber,
            }):Play()
        end
    end))

    self:_trackConn(_G.VX.bus:on("vehicle.launchStart", function(evt)
        local target = evt and evt.target or 6500
        self:notify("LAUNCH CONTROL", string.format("Armed @ %d RPM", target), GT3.amber, 1.8)
    end))

    self:_trackConn(_G.VX.bus:on("vehicle.launchRelease", function(evt)
        if evt and evt.quality then
            local q = string.upper(tostring(evt.quality))
            local col = (q == "PERFECT") and GT3.green or ((q == "GOOD") and GT3.cyan or GT3.crimson)
            self:notify("LAUNCH RELEASE", q .. " LAUNCH", col, 2.2)
        end
    end))

    self:_trackConn(_G.VX.bus:on("profiles.changed", function(evt)
        if evt and evt.profile then
            self:notify("ENGINE PROFILE", evt.profile.name, GT3.cyan, 2.0)
        end
    end))

    self:_trackConn(_G.VX.bus:on("settings.changed", function(evt)
        if not evt then return end
        if evt.path == "physics.telemetryHud" and self._telFrame then
            self._telFrame.Visible = (evt.new == true) and not self._videoMode
        elseif evt.path == "videoMode" then
            if evt.new == true then
                self:_enterVideoMode()
            else
                self:_exitVideoMode()
            end
        end
    end))

    self:_trackConn(UserInputService.InputBegan:Connect(function(input, gp)
        if gp then return end
        if input.KeyCode == Enum.KeyCode.F2 then
            self:toggleTelemetry()
        elseif input.KeyCode == Enum.KeyCode.F3 then
            self:toggleDiagnostics()
        elseif input.KeyCode == Enum.KeyCode.F4 then
            self:toggleVideoMode()
        end
    end))

    self:_trackConn(RunService.RenderStepped:Connect(function()
        self:_update()
    end))
end

function Module:_createGui()
    local player = Players.LocalPlayer
    local pg = player and player:WaitForChild("PlayerGui", 5)
    if not pg then return end

    local existing = pg:FindFirstChild("VX_HUD")
    if existing then existing:Destroy() end

    local gui = Instance.new("ScreenGui")
    gui.Name = "VX_HUD"
    gui.ResetOnSpawn = false
    gui.IgnoreGuiInset = true
    gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    gui.DisplayOrder = 5
    gui.Parent = pg
    self._gui = gui
    self.gui = gui

    self:_createDashboard(gui)
    self:_createNotifications(gui)
    self:_createTelemetry(gui)
    self:_createDiagnostics(gui)

    if _getSetting("videoMode", false) then
        self:_enterVideoMode()
    end
end

