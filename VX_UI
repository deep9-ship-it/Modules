        local f = Instance.new("Frame")
        f.Name = "VX_Diagnostics"
        f.Size = UDim2.new(0, 390, 0, 410)
        f.Position = UDim2.new(1, -408, 0, 18)
        f.BackgroundColor3 = THEME.bg
        f.BackgroundTransparency = 0.08
        f.BorderSizePixel = 0
        f.Visible = false
        f.Parent = self.gui
        addGlassStyle(f, 10, THEME.border, 0.25)

        local hdr = Instance.new("TextLabel")
        hdr.Size = UDim2.new(1, -20, 0, 28)
        hdr.Position = UDim2.new(0, 12, 0, 8)
        hdr.BackgroundTransparency = 1
        hdr.Text = "VX // DIAGNOSTICS  (F3)"
        hdr.TextColor3 = THEME.accent
        hdr.Font = Enum.Font.GothamBlack
        hdr.TextSize = 13
        hdr.TextXAlignment = Enum.TextXAlignment.Left
        hdr.Parent = f

        local scroll = Instance.new("ScrollingFrame")
        scroll.Size = UDim2.new(1, -16, 1, -46)
        scroll.Position = UDim2.new(0, 8, 0, 38)
        scroll.BackgroundTransparency = 1
        scroll.ScrollBarThickness = 4
        scroll.ScrollBarImageColor3 = THEME.accent
        scroll.CanvasSize = UDim2.new(0, 0, 0, 0)
        scroll.AutomaticCanvasSize = Enum.AutomaticSize.Y
        scroll.Parent = f
        local layout = Instance.new("UIListLayout")
        layout.Padding = UDim.new(0, 3)
        layout.Parent = scroll

        self.diagScroll = scroll
        self.diagnosticsPanel = f
        self:_makeDraggable(f)
    end

    self.diagOpen = not self.diagOpen
    self.diagnosticsPanel.Visible = self.diagOpen
    self._diagSession = self._diagSession + 1
    if self.diagOpen then
        self:_refreshDiagnostics(self._diagSession)
    end
end

function Module:_refreshDiagnostics(session)
    if not self.diagOpen or session ~= self._diagSession or not self.diagScroll then return end
    for _, c in ipairs(self.diagScroll:GetChildren()) do
        if c:IsA("TextLabel") then c:Destroy() end
    end
    local all = _G.VX.diagnostics and _G.VX.diagnostics.getAll() or {}
    local keys = {}
    for k in pairs(all) do table.insert(keys, k) end
    table.sort(keys)
    for _, k in ipairs(keys) do
        local entry = all[k]
        local lbl = Instance.new("TextLabel")
        lbl.Size = UDim2.new(1, -8, 0, 18)
        lbl.BackgroundTransparency = 1
        lbl.Text = string.format("%-24s %s %s",
            entry.schema.label or k,
            tostring(entry.value),
            entry.schema.unit or "")
        lbl.TextColor3 = entry.value ~= nil and THEME.text or THEME.textMuted
        lbl.Font = Enum.Font.Code
        lbl.TextSize = 11
        lbl.TextXAlignment = Enum.TextXAlignment.Left
        lbl.Parent = self.diagScroll
    end
    task.delay(1.0, function()
        self:_refreshDiagnostics(session)
    end)
end

-- ==================== VIDEO MODE ====================
function Module:toggleVideoMode()
    self.videoMode = not self.videoMode
    _G.VX.setSetting("videoMode", self.videoMode)
    if self.videoMode then
        self:_enterVideoMode()
    else
        self:_exitVideoMode()
        self:notify("Video Mode: OFF", 1.5)
    end
end

function Module:_enterVideoMode()
    self.hiddenElements = {}
    local pg = Player:FindFirstChild("PlayerGui")
    if pg then
        for _, d in ipairs(pg:GetDescendants()) do
            if d:IsA("GuiObject") and d.Visible and not d:IsDescendantOf(self.gui) then
                self.hiddenElements[d] = true
                d.Visible = false
            end
        end
    end
    if self.dashboard then self.dashboard.Visible = false end
    if self.telemetry then self.telemetry.Visible = false end
    if self.diagnosticsPanel then self.diagnosticsPanel.Visible = false end
    if self.notifContainer then self.notifContainer.Visible = false end

    if self._videoWatcher then pcall(task.cancel, self._videoWatcher) end
    self._videoWatcher = task.spawn(function()
        while self.videoMode do
            task.wait(1)
            if not self.videoMode then break end
            local pg2 = Player:FindFirstChild("PlayerGui")
            if pg2 then
                for _, d in ipairs(pg2:GetDescendants()) do
                    if d:IsA("GuiObject") and d.Visible and not d:IsDescendantOf(self.gui) then
                        self.hiddenElements[d] = true
                        d.Visible = false
                    end
                end
            end
        end
    end)
end

function Module:_exitVideoMode()
    if self._videoWatcher then
        pcall(task.cancel, self._videoWatcher)
        self._videoWatcher = nil
    end
    for obj in pairs(self.hiddenElements) do
        pcall(function() if obj and obj.Parent then obj.Visible = true end end)
    end
    self.hiddenElements = {}
    if self.dashboard and self.vehicleState:isReady() then
        self.dashboard.Visible = true
    end
    if self.telemetry and self.core.settings.physics.telemetryHud then
        self.telemetry.Visible = true
    end
    if self.diagnosticsPanel and self.diagOpen then
        self.diagnosticsPanel.Visible = true
    end
    if self.notifContainer then self.notifContainer.Visible = true end
end

-- ==================== STATE & UPDATE ====================
function Module:_onStateChange(evt)
    if evt.to == "Ready" then
        self._running = true
        if not self.telemetry and self.core.settings.physics.telemetryHud then
            self:_createTelemetry()
        end
        if not self.videoMode and self.dashboard then
            self.dashboard.Visible = true
        end
        if self.telemetry and self.core.settings.physics.telemetryHud and not self.videoMode then
            self.telemetry.Visible = true
        end
    elseif evt.to == "Exiting" or evt.to == "Disabled" then
        self._running = false
        if self.dashboard then self.dashboard.Visible = false end
        if self.telemetry then self.telemetry.Visible = false end
        if self.videoMode then self:toggleVideoMode() end
    end
end

function Module:_onSettingChange(evt)
    if evt.path == "physics.telemetryHud" then
        if not self.telemetry then self:_createTelemetry() end
        self.telemetry.Visible = (evt.new == true) and self._running and not self.videoMode
    elseif evt.path == "videoMode" and evt.new ~= self.videoMode then
        self.videoMode = evt.new
        if self.videoMode then self:_enterVideoMode() else self:_exitVideoMode() end
    end
end

local function tireColor(temp)
    if temp < 45 then return THEME.ice
    elseif temp <= 90 then return THEME.green
    elseif temp <= 115 then return THEME.amber
    else return THEME.accent end
end

local function setPill(ind, active, color)
    if not ind then return end
    ind.dot.BackgroundColor3 = active and color or THEME.textMuted
    ind.lbl.TextColor3 = active and THEME.text or THEME.textMuted
    ind.pill.BackgroundColor3 = active and Color3.fromRGB(34, 24, 28) or THEME.card
end

function Module:_update(_dt)
    if self.videoMode or not self.dashboard then return end
    local root = _G.VX.Authority and _G.VX.Authority:getRoot()
    local speed = root and math.floor(Vector3.new(root.AssemblyLinearVelocity.X, 0, root.AssemblyLinearVelocity.Z).Magnitude * 0.626) or 0
    local rpm = self.powertrain:getRPM()
    local redline = math.max(self.powertrain:getEffectiveRedline(), 1000)
    local gear = self.powertrain:getGear()
    local prof = self.profiles:getActive()
    local maxRPM = math.max(prof.maxRPM, redline)
    local now = os.clock()

    self.speedLabel.Text = tostring(speed)
    self.rpmLabel.Text = fmtInt(rpm) .. " RPM"

    -- Gear card
    local gearStr = gear == -1 and "R" or (gear == 0 and "N" or tostring(gear))
    self.gearLabel.Text = gearStr
    if gear == -1 then
        self.gearLabel.TextColor3 = THEME.accent
        self.gearStroke.Color = THEME.accent
    elseif now < self._gearFlashUntil then
        self.gearLabel.TextColor3 = THEME.amber
        self.gearStroke.Color = THEME.amber
    else
        self.gearLabel.TextColor3 = THEME.text
        self.gearStroke.Color = THEME.border
    end

    -- 18-LED Shift Light Bar
    local pct = math.clamp(rpm / maxRPM, 0, 1)
    local litCount = math.floor(pct * LED_COUNT + 0.5)
    local flashing = (rpm >= redline * 0.93) and (math.floor(now * 16) % 2 == 0)
    for i = 1, LED_COUNT do
        local seg = self._rpmLeds[i]
        if flashing then
            seg.BackgroundColor3 = (i % 2 == 0) and THEME.accent or THEME.text
        elseif i <= litCount then
            if i >= 16 then
                seg.BackgroundColor3 = THEME.accent
            elseif i >= 12 then
                seg.BackgroundColor3 = THEME.amber
            else
                seg.BackgroundColor3 = THEME.text
            end
        else
            seg.BackgroundColor3 = THEME.track
        end
    end

    -- Boost bar + PSI
    local boost = self.powertrain:getBoostPSI()
    local maxBoost = math.max(prof.maxBoostPSI or 18, 1)
    local boostRatio = math.clamp(boost / maxBoost, 0, 1)
    self.boostFill.Size = UDim2.new(boostRatio, 0, 1, 0)
    if self.powertrain:isBoostActive() or now < self._shiftFlashUntil then
        self.boostFill.BackgroundColor3 = boostRatio > 0.85 and THEME.accent or THEME.amber
        self.boostLabel.Text = string.format("%.1f PSI", boost)
        self.boostLabel.TextColor3 = THEME.text
    elseif boost > 0.2 then
        self.boostFill.BackgroundColor3 = THEME.textDim
        self.boostLabel.Text = string.format("%.1f PSI", boost)
        self.boostLabel.TextColor3 = THEME.textDim
    else
        self.boostFill.BackgroundColor3 = THEME.track
        self.boostLabel.Text = prof.turboStage > 0 and "0.0 PSI" or "NA"
        self.boostLabel.TextColor3 = THEME.textMuted
    end

    -- 4-Corner Tire Temp Dots + Cold Start badge
    local temps = self.chassis:getTireTemps()
    local fc = tireColor(temps.front or 55)
    local rc = tireColor(temps.rear or 55)
    self.tireFL.BackgroundColor3 = fc
    self.tireFR.BackgroundColor3 = fc
    self.tireRL.BackgroundColor3 = rc
    self.tireRR.BackgroundColor3 = rc
    self.coldBadge.Visible = self.powertrain:isColdStart()

    -- Status pills
    setPill(self.indicators.tcs, self.driveSystem:isTCSActive(), THEME.amber)
    setPill(self.indicators.abs, self.driveSystem:isABSActive(), THEME.amber)
    local lState = self.powertrain:getLaunchState()
    if lState == "holding" then
        local chg = self.powertrain:getLaunchCharge() or 0
        self.indicators.launch.lbl.Text = chg >= 0.95 and "RDY" or "LC"
        setPill(self.indicators.launch, true, THEME.amber)
    elseif lState == "launched" then
        self.indicators.launch.lbl.Text = "BST"
        setPill(self.indicators.launch, true, THEME.green)
    else
        self.indicators.launch.lbl.Text = "LC"
        setPill(self.indicators.launch, false, THEME.textMuted)
    end
    local clutch = _G.VX.Input and _G.VX.Input:isClutchEngaged() or false
    setPill(self.indicators.clutch, clutch, THEME.ice)

    -- Visual Telemetry Card (F2)
    if self.telemetry and self.telemetry.Visible then
        local rawT = _G.VX.Input and _G.VX.Input:getRawThrottle() or 0
        local rawS = _G.VX.Input and _G.VX.Input:getRawSteer() or 0
        self.teleThrottle.Size = UDim2.new(math.clamp(math.max(0, rawT), 0, 1), 0, 1, 0)
        self.teleBrake.Size    = UDim2.new(math.clamp(math.max(0, -rawT), 0, 1), 0, 1, 0)

        local steerNorm = math.clamp(rawS, -1, 1) * 0.5
        if steerNorm >= 0 then
            self.teleSteer.Position = UDim2.new(0.5, 0, 0, 0)
            self.teleSteer.Size = UDim2.new(steerNorm, 0, 1, 0)
        else
            self.teleSteer.Position = UDim2.new(0.5 + steerNorm, 0, 0, 0)
            self.teleSteer.Size = UDim2.new(-steerNorm, 0, 1, 0)
        end

        local wt = self.chassis:getWeightTransfer()
        local fL = (wt.frontMul or 1) * (wt.leftMul or 1)
        local fR = (wt.frontMul or 1) * (wt.rightMul or 1)
        local rL = (wt.rearMul or 1) * (wt.leftMul or 1)
        local rR = (wt.rearMul or 1) * (wt.rightMul or 1)
        self.teleWT.Text = string.format("LOAD\n%.2f|%.2f\n%.2f|%.2f", fL, fR, rL, rR)

        self.teleText.Text = string.format(
            "SPD %3d MPH | GEAR %2s | %d RPM\nBST %4.1f PSI | %s\nGRIP F:%.2f R:%.2f\nTEMP F:%.0fC  R:%.0fC\nSTATE %s",
            speed, gearStr, math.floor(rpm),
            boost, self.powertrain:isColdStart() and "COLD" or "WARM",
            self.chassis:getFrontGrip(), self.chassis:getRearGrip(),
            temps.front or 0, temps.rear or 0,
            self.vehicleState:getVehicleState()
        )
    end
end

return Module
