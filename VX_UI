local LED_COUNT = 18

local function fmtInt(n)
    local s = tostring(math.floor((tonumber(n) or 0) + 0.5))
    return s:reverse():gsub("(%d%d%d)", "%1,"):reverse():gsub("^,", "")
end

local function addGlassStyle(frame, radius, strokeColor, strokeTransp)
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, radius or 10)
    corner.Parent = frame

    local grad = Instance.new("UIGradient")
    grad.Rotation = 90
    grad.Color = ColorSequence.new(THEME.bg, THEME.bgBottom)
    grad.Parent = frame

    local stroke = Instance.new("UIStroke")
    stroke.Color = strokeColor or THEME.border
    stroke.Thickness = 1
    stroke.Transparency = strokeTransp or 0.3
    stroke.Parent = frame
    return stroke
end

function Module:_trackConn(c)
    if c then
        table.insert(self._conns, c)
    end
    return c
end

function Module:_clearConns()
    for _, c in ipairs(self._conns) do
        pcall(function()
            if typeof(c) == "RBXScriptConnection" then
                c:Disconnect()
            elseif type(c) == "table" and c.Disconnect then
                c:Disconnect()
            end
        end)
    end
    self._conns = {}
end

function Module:Construct()
    self.gui = nil
    self.dashboard = nil
    self.telemetry = nil
    self.diagnosticsPanel = nil
    self.notifContainer = nil
    self.videoMode = false
    self.hiddenElements = {}
    self.diagOpen = false
    self._diagSession = 0
    self._running = false
    self._conns = {}
    self._rpmLeds = {}
    self._shiftFlashUntil = 0
    self._gearFlashUntil = 0
    self._lastGear = nil
    self._videoWatcher = nil
end

function Module:Init(deps)
    self.core         = deps.Core
    self.profiles     = deps.Profiles
    self.powertrain   = deps.Powertrain
    self.driveSystem  = deps.DriveSystem
    self.chassis      = deps.Chassis
    self.vehicleState = deps.VehicleState
    _G.VX.UI = self
end

function Module:Start()
    self:_createGui()

    self:_trackConn(_G.VX.bus:on("vehicle.stateChanged", function(evt)
        self:_onStateChange(evt)
    end))
    self:_trackConn(_G.VX.bus:on("settings.changed", function(evt)
        self:_onSettingChange(evt)
    end))
    self:_trackConn(_G.VX.bus:on("vehicle.shift", function()
        self._gearFlashUntil = os.clock() + 0.18
    end))
    self:_trackConn(_G.VX.bus:on("turbo.blowoff", function()
        self._shiftFlashUntil = os.clock() + 0.12
    end))

    self:_trackConn(RunService.RenderStepped:Connect(function(dt)
        if self._running then
            pcall(function() self:_update(dt) end)
        end
    end))
end

function Module:Stop()
    self._running = false
    self.diagOpen = false
    self._diagSession = self._diagSession + 1
    if self.videoMode then
        self:_exitVideoMode()
        self.videoMode = false
    end
    if self._videoWatcher then
        pcall(task.cancel, self._videoWatcher)
        self._videoWatcher = nil
    end
    self:_clearConns()
    if self.gui then
        pcall(function() self.gui:Destroy() end)
        self.gui = nil
    end
end

function Module:_createGui()
    local pg = Player:WaitForChild("PlayerGui")
    local existing = pg:FindFirstChild("VX_UI")
    if existing then existing:Destroy() end

    local sg = Instance.new("ScreenGui")
    sg.Name = "VX_UI"
    sg.ResetOnSpawn = false
    sg.DisplayOrder = 10
    sg.IgnoreGuiInset = true
    sg.Parent = pg
    self.gui = sg

    self:_createDashboard()
    self:_createNotifs()
end

function Module:_makeDraggable(frame)
    local dragging = false
    local startPos, startFramePos

    frame.InputBegan:Connect(function(inp)
        if inp.UserInputType == Enum.UserInputType.MouseButton1
            or inp.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            startPos = inp.Position
            startFramePos = frame.Position
        end
    end)

    self:_trackConn(UIS.InputChanged:Connect(function(inp)
        if not dragging then return end
        if inp.UserInputType == Enum.UserInputType.MouseMovement
            or inp.UserInputType == Enum.UserInputType.Touch then
            local delta = inp.Position - startPos
            frame.Position = UDim2.new(
                startFramePos.X.Scale, startFramePos.X.Offset + delta.X,
                startFramePos.Y.Scale, startFramePos.Y.Offset + delta.Y
            )
        end
    end))

    self:_trackConn(UIS.InputEnded:Connect(function(inp)
        if inp.UserInputType == Enum.UserInputType.MouseButton1
            or inp.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end))
end

