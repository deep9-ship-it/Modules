end

function Module:notify(msg, duration, kind)
    if self.videoMode or not self.notifContainer then return end
    duration = duration or 2.5
    local barColor = THEME.accent
    if kind == "success" then barColor = THEME.green
    elseif kind == "warn" then barColor = THEME.amber end

    local n = Instance.new("Frame")
    n.Size = UDim2.new(1, 0, 0, 32)
    n.Position = UDim2.new(0, 24, 1, -32)
    n.BackgroundColor3 = THEME.bg
    n.BackgroundTransparency = 0.12
    n.BorderSizePixel = 0
    n.Parent = self.notifContainer
    addGlassStyle(n, 7, THEME.border, 0.25)

    local stripe = Instance.new("Frame")
    stripe.Size = UDim2.new(0, 3, 1, -10)
    stripe.Position = UDim2.new(0, 0, 0, 5)
    stripe.BackgroundColor3 = barColor
    stripe.BorderSizePixel = 0
    stripe.Parent = n
    local sc = Instance.new("UICorner"); sc.CornerRadius = UDim.new(0, 2); sc.Parent = stripe

    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.new(1, -16, 1, 0)
    lbl.Position = UDim2.new(0, 10, 0, 0)
    lbl.BackgroundTransparency = 1
    lbl.Text = msg
    lbl.TextColor3 = THEME.text
    lbl.Font = Enum.Font.GothamBold
    lbl.TextSize = 12
    lbl.TextTruncate = Enum.TextTruncate.AtEnd
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.Parent = n

    for _, child in ipairs(self.notifContainer:GetChildren()) do
        if child ~= n and child:IsA("Frame") then
            TweenService:Create(child, TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                Position = child.Position - UDim2.new(0, 0, 0, 38)
            }):Play()
        end
    end

    TweenService:Create(n, TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
        Position = UDim2.new(0, 0, 1, -32)
    }):Play()

    task.delay(duration, function()
        if not n.Parent then return end
        local tw = TweenService:Create(n, TweenInfo.new(0.22), { BackgroundTransparency = 1 })
        TweenService:Create(lbl, TweenInfo.new(0.22), { TextTransparency = 1 }):Play()
        tw:Play()
        tw.Completed:Connect(function()
            if n.Parent then n:Destroy() end
        end)
    end)
end

