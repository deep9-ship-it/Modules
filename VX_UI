-- ==================== STATE CHANGE ====================
function Module:_onStateChange(evt)
    if evt.to == "Ready" or evt.to == "Idle" then
        self.dashboard.Visible = true
        self.settingsBtn.Visible = true
        self:_startLoop()
    elseif evt.to == "Exiting" or evt.to == "Disabled" then
        self.dashboard.Visible = false
        self.settingsBtn.Visible = false
        self:_stopLoop()
        if self.videoMode then self:toggleVideoMode() end
    end
end

-- ==================== UPDATE LOOP ====================
function Module:_startLoop()
    if self._running then return end
    self._running = true

    local perf = self.core.settings._effectivePerformance
    self._updateInterval = (perf == "low") and 0.1 or 0.05

    self._loopThread = task.spawn(function()
        while self._running do
            task.wait(self._updateInterval)
            pcall(self._update, self)
        end
    end)
end

function Module:_stopLoop()
    if not self._running then return end
    self._running = false
    if self._loopThread then
        pcall(function() task.cancel(self._loopThread) end)
        self._loopThread = nil
    end
end

function Module:_update()
    if not self.dashboard or not self.dashboard.Visible then return end

    local speed = 0
    local handle = _G.VX.Authority and _G.VX.Authority:getHandle()
    if handle and handle.root and handle.root.PrimaryPart then
        local v = handle.root.PrimaryPart.AssemblyLinearVelocity
        speed = math.floor(Vector3.new(v.X, 0, v.Z).Magnitude * 0.313)
    end

    local rpm = self.powertrain:getRPM()
    local gear = self.powertrain:getGear()
    local boost = self.drive:getBoost()
    local stage = self.drive:getTurboStage()
    local prof = self.profiles:current()
    local launchState = self.powertrain:getLaunchState()
    local isLimited = self.powertrain:isRevLimiting()

    -- Speed
    self.dashboardRefs.speedText.Text = tostring(speed)
    self.dashboardRefs.speedText.TextColor3 = speed > 100
        and Color3.fromRGB(255, 220, 100) or Color3.fromRGB(255, 255, 255)

    -- Gear
    local gearLabel = (gear == -1) and "R" or tostring(gear)
    self.dashboardRefs.gearText.Text = "GEAR " .. gearLabel
    if isLimited then
        self.dashboardRefs.gearText.TextColor3 = Color3.fromRGB(255, 40, 40)
    elseif rpm > prof.redlineRPM * 0.9 then
        self.dashboardRefs.gearText.TextColor3 = Color3.fromRGB(255, 200, 40)
    else
        self.dashboardRefs.gearText.TextColor3 = Color3.fromRGB(255, 255, 255)
    end

    -- PSI
    local cfgStage = self.core.config.turboStages[stage] or self.core.config.turboStages[1]
    local maxBoost = math.max(cfgStage.maxBoost, 0.01)
    local psi = boost * 25 / maxBoost
    self.dashboardRefs.psiText.Text = string.format("%.1f PSI", psi)
    if psi > 16 then
        self.dashboardRefs.psiText.TextColor3 = Color3.fromRGB(255, 100, 100)
    elseif psi > 8 then
        self.dashboardRefs.psiText.TextColor3 = Color3.fromRGB(240, 200, 60)
    else
        self.dashboardRefs.psiText.TextColor3 = Color3.fromRGB(100, 200, 255)
    end

    -- RPM bar
    local fillTarget = math.clamp(
        (rpm - prof.idleRPM) / math.max(prof.maxRPM - prof.idleRPM, 1), 0, 1
    )
    if math.abs(fillTarget - self.dashboardRefs.lastFill) > 0.005 then
        self.dashboardRefs.lastFill = fillTarget
        if self.dashboardRefs.fillTween then
            pcall(function() self.dashboardRefs.fillTween:Cancel() end)
        end
        self.dashboardRefs.fillTween = TweenService:Create(
            self.dashboardRefs.rpmFill,
            TweenInfo.new(0.06, Enum.EasingStyle.Linear),
            { Size = UDim2.new(fillTarget, 0, 1, 0) }
        )
        self.dashboardRefs.fillTween:Play()
    end

    -- Rev limiter flash
    if isLimited then
        self.dashboardRefs.flashPhase = self.dashboardRefs.flashPhase + self._updateInterval
        self.dashboardRefs.rpmFlash.BackgroundTransparency =
            0.5 + math.sin(self.dashboardRefs.flashPhase * 20) * 0.4
    else
        self.dashboardRefs.rpmFlash.BackgroundTransparency = 1
        self.dashboardRefs.flashPhase = 0
    end

    -- Launch indicator
    if launchState == "holding" then
        self.dashboardRefs.launchInd.Visible = true
        self.dashboardRefs.launchInd.Text = "LAUNCH READY"
        self.dashboardRefs.launchInd.TextTransparency =
            0.5 + math.sin(os.clock() * 12) * 0.5
    elseif launchState == "releasing" then
        self.dashboardRefs.launchInd.Visible = true
        self.dashboardRefs.launchInd.Text = "GO!"
        self.dashboardRefs.launchInd.TextTransparency = 0
    elseif self.drive:getLaunchQuality() ~= "miss" then
        local quality = self.drive:getLaunchQuality()
        self.dashboardRefs.launchInd.Visible = true
        self.dashboardRefs.launchInd.Text = string.upper(quality)
        self.dashboardRefs.launchInd.TextTransparency = 0
        task.delay(1.5, function()
            if self.dashboardRefs.launchInd then
                self.dashboardRefs.launchInd.Visible = false
            end
        end)
    else
        self.dashboardRefs.launchInd.Visible = false
    end

    -- Telemetry
    if self.telemetry and self.telemetry.Visible then
        self:_updateTelemetry()
    end
end

-- ==================== NOTIFICATIONS ====================
function Module:notify(text, duration)
    if self.videoMode then return end
    duration = duration or 2.5

    local n = Instance.new("TextLabel")
    n.Size = UDim2.new(0.30, 0, 0.06, 0)
    n.Position = UDim2.new(0.35, 0, 0.15, -#self.notifQueue * 60)
    n.BackgroundColor3 = Color3.fromRGB(20, 20, 25)
    n.BackgroundTransparency = 0.15
    n.TextColor3 = Color3.fromRGB(255, 255, 255)
    n.TextScaled = true
    n.Font = Enum.Font.GothamBold
    n.Text = text
    n.ZIndex = 55
    corner(n, 12)
    stroke(n, Color3.fromRGB(100, 200, 255), 2)
    n.Parent = self.notifScreen

    table.insert(self.notifQueue, n)

    local fade = TweenService:Create(
        n,
        TweenInfo.new(0.35, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
        { BackgroundTransparency = 1, TextTransparency = 1 }
    )

    task.delay(duration, function()
        fade:Play()
        fade.Completed:Wait()
        pcall(function() n:Destroy() end)
        for i, item in ipairs(self.notifQueue) do
            if item == n then
                table.remove(self.notifQueue, i)
                break
            end
        end
    end)
end

-- ==================== TELEMETRY ====================
function Module:_createTelemetry()
    if self.telemetry then return end

    local t = Instance.new("Frame")
    t.Name = "VXTelemetry"
    t.Size = UDim2.new(0, 220, 0, 240)
    t.Position = UDim2.new(1, -240, 0.4, 0)
    t.BackgroundColor3 = Color3.fromRGB(10, 10, 15)
    t.BackgroundTransparency = 0.25
    t.Visible = false
    t.ZIndex = 10
    corner(t, 10)
    stroke(t, Color3.fromRGB(80, 160, 200), 1.5)
    t.Parent = self.gui

    local keys = {
        "Torque", "Load", "Slip", "Drag",
        "Grip Front", "Grip Rear", "Slope",
        "Shift", "Launch", "TCS",
        "Boost", "Brake Temp", "Spin", "Tire Temp",
        "RPM", "Gear",
    }
    local refs = {}
    for i, key in ipairs(keys) do
        local l = Instance.new("TextLabel")
        l.Size = UDim2.new(1, -12, 0, 14)
        l.Position = UDim2.new(0, 6, 0, 6 + (i-1) * 14)
        l.Text = key .. ": --"
        l.TextColor3 = Color3.fromRGB(150, 220, 255)
        l.BackgroundTransparency = 1
        l.TextXAlignment = Enum.TextXAlignment.Left
        l.TextSize = 11
        l.Font = Enum.Font.Code
        l.ZIndex = 11
        l.Parent = t
        refs[key] = l
    end
    t.Visible = self.core.settings.physics.telemetryHud

    self.telemetry = t
    self.telemetryRefs = refs
    self:_makeDraggable(t)
end

function Module:_updateTelemetry()
    if not self.telemetryRefs then return end
    local r = self.telemetryRefs
    local rpm = self.powertrain:getRPM()
    local gear = self.powertrain:getGear()
    local boost = self.drive:getBoost()
    local slip = self.chassis:getSlipRatio()
    local slope = self.chassis:getSlopeAngle()
    local gf = self.chassis:getEffectiveGripFront()
    local gr = self.chassis:getEffectiveGripRear()
    local wtx = self.chassis:getWeightTransfer()
    local launchState = self.powertrain:getLaunchState()
    local shiftState = self.powertrain:getShiftState()

    r["RPM"].Text = string.format("RPM: %d", math.floor(rpm))
    r["Gear"].Text = string.format("Gear: %s", tostring(gear == -1 and "R" or gear))
    r["Torque"].Text = string.format("Torque: %.2fx", rpm / 8500)
    r["Load"].Text = string.format("Load: %.2f", self.powertrain:getSlopeLoadFactor())
    r["Slip"].Text = string.format("Slip: %.2f", slip)
    r["Drag"].Text = string.format("Drag: --")
    r["Grip Front"].Text = string.format("Front μ: %.2f", gf)
    r["Grip Rear"].Text = string.format("Rear μ: %.2f", gr)
    r["Slope"].Text = string.format("Slope: %.1f°", slope)
    r["Shift"].Text = string.format("Shift: %s", shiftState)
    r["Launch"].Text = string.format("Launch: %s", launchState)
    r["TCS"].Text = string.format("TCS: %s", self.core.settings.physics.tractionControl and "ON" or "OFF")
    r["Boost"].Text = string.format("Boost: %.2f", boost)
    r["Brake Temp"].Text = string.format("Brake T: %.2f", self.drive.brakeTemp or 0)
    r["Spin"].Text = string.format("Spin: %s", self.chassis.spinActive and "YES" or "no")
    r["Tire Temp"].Text = string.format("Tire T: %.2f", self.chassis:getTireTemp("front"))
end

-- ==================== VIDEO MODE ====================
function Module:toggleVideoMode()
    self.videoMode = not self.videoMode
    _G.VX.setSetting("videoMode", self.videoMode)

    if self.videoMode then
        self:_enterVideoMode()
        self:notify("Video Mode: ON", 1.5)
    else
        self:_exitVideoMode()
        self:notify("Video Mode: OFF", 1.5)
    end
end

function Module:isVideoMode() return self.videoMode end

function Module:_enterVideoMode()
    self.hiddenElements = {}

    local function tryHide(inst)
        if inst and inst:IsA("GuiObject") and inst.Visible then
            self.hiddenElements[inst] = inst.Visible
            inst.Visible = false
        end
    end

    -- Hide our telemetry, diagnostics, notifications
    if self.telemetry then tryHide(self.telemetry) end
    if self.diagnosticsPanel then tryHide(self.diagnosticsPanel) end
    if self.notifScreen then self.notifScreen.Visible = false end

    -- Hide game UI (not pedals / steering / exit / dashboard / settings)
    pcall(function()
        local handler = PlayerGui:FindFirstChild("MainGUIHandler")
        if not handler then return end
        local controls = handler:FindFirstChild("VehicleControls")
        if not controls then return end
        local ctrls = controls:FindFirstChild("Controls")
        if not ctrls then return end
        -- Hide buttons frame
        tryHide(ctrls:FindFirstChild("Buttons"))
        -- Hide exit frames
        tryHide(ctrls:FindFirstChild("ExitFrame"))
        tryHide(ctrls:FindFirstChild("Exit2"))
        -- Hide top bar if exists
        tryHide(handler:FindFirstChild("TopBar"))
        tryHide(handler:FindFirstChild("BoostBar"))
        tryHide(handler:FindFirstChild("SpeedBar"))
    end)

    -- Close our panel if open
    if _G.VX.Panel and _G.VX.Panel:isOpen() then
        pcall(function() _G.VX.Panel:close() end)
    end

    -- Watch for game UI to respawn (in case game re-shows)
    self.videoModeWatcher = task.spawn(function()
        while self.videoMode do
            task.wait(1.0)
            if self.videoMode then
                pcall(function()
                    local handler = PlayerGui:FindFirstChild("MainGUIHandler")
                    if handler then
                        local controls = handler:FindFirstChild("VehicleControls")
                        if controls then
                            local ctrls = controls:FindFirstChild("Controls")
                            if ctrls then
                                local btnFrame = ctrls:FindFirstChild("Buttons")
                                if btnFrame and btnFrame.Visible then
                                    btnFrame.Visible = false
                                end
                            end
                        end
                    end
                end)
            end
        end
    end)
end

function Module:_exitVideoMode()
    -- Restore all hidden elements
    for inst, wasVisible in pairs(self.hiddenElements) do
        if inst and inst.Parent then
            inst.Visible = wasVisible
        end
    end
    self.hiddenElements = {}

    if self.notifScreen then self.notifScreen.Visible = true end

    if self.videoModeWatcher then
        pcall(function() task.cancel(self.videoModeWatcher) end)
        self.videoModeWatcher = nil
    end
end

-- ==================== DIAGNOSTICS PANEL ====================
function Module:_createDiagnosticsPanel()
    local p = Instance.new("Frame")
    p.Name = "VXDiagnostics"
    p.Size = UDim2.new(0, 340, 0, 440)
    p.Position = UDim2.new(0, 20, 0.5, -220)
    p.BackgroundColor3 = Color3.fromRGB(8, 8, 12)
    p.BackgroundTransparency = 0.2
    p.Visible = false
    p.ZIndex = 100
    corner(p, 10)
    stroke(p, Color3.fromRGB(80, 160, 200), 1.5)
    p.Parent = self.gui

    local title = Instance.new("TextLabel")
    title.Size = UDim2.new(1, -20, 0, 24)
    title.Position = UDim2.new(0, 10, 0, 6)
    title.Text = "VX Diagnostics (F3)"
    title.TextColor3 = Color3.fromRGB(100, 200, 255)
    title.BackgroundTransparency = 1
    title.TextXAlignment = Enum.TextXAlignment.Left
    title.Font = Enum.Font.GothamBold
    title.TextSize = 13
    title.ZIndex = 101
    title.Parent = p

    local scroll = Instance.new("ScrollingFrame")
    scroll.Size = UDim2.new(1, -12, 1, -36)
    scroll.Position = UDim2.new(0, 6, 0, 32)
    scroll.BackgroundTransparency = 1
    scroll.BorderSizePixel = 0
    scroll.ScrollBarThickness = 4
    scroll.CanvasSize = UDim2.new(0, 0, 0, 0)
    scroll.ZIndex = 101
    scroll.Parent = p

    self.diagnosticsPanel = p
    self.diagRefs.scroll = scroll
    self:_makeDraggable(p)
end

function Module:toggleDiagnostics()
    if not self.diagnosticsPanel then return end
    self.diagOpen = not self.diagOpen
    self.diagnosticsPanel.Visible = self.diagOpen
    if self.diagOpen then
        self:_refreshDiagnostics()
    end
end

function Module:_refreshDiagnostics()
    if not self.diagOpen then return end
    local scroll = self.diagRefs.scroll
    if not scroll then return end

    -- Clear old
    for _, child in ipairs(scroll:GetChildren()) do
        if child:IsA("TextLabel") then child:Destroy() end
    end

    -- Get all diagnostics
    local all = _G.VX.diagnostics.getAll()
    local keys = {}
    for k in pairs(all) do table.insert(keys, k) end
    table.sort(keys)

    local y = 0
    for _, key in ipairs(keys) do
        local diag = all[key]
        local val = diag.value
        local text
        if type(val) == "table" then
            text = string.format("%s: %s", key, tostring(val.value))
        else
            text = string.format("%s: %s", key, tostring(val))
        end

        local l = Instance.new("TextLabel")
        l.Size = UDim2.new(1, -6, 0, 16)
        l.Position = UDim2.new(0, 0, 0, y)
        l.Text = text
        l.TextColor3 = Color3.fromRGB(180, 220, 255)
        l.BackgroundTransparency = 1
        l.TextXAlignment = Enum.TextXAlignment.Left
        l.TextSize = 11
        l.Font = Enum.Font.Code
        l.ZIndex = 101
        l.Parent = scroll
        y = y + 16
    end

    scroll.CanvasSize = UDim2.new(0, 0, 0, y + 20)

    -- Auto-refresh every 1s while open
    task.delay(1.0, function()
        if self.diagOpen then self:_refreshDiagnostics() end
    end)
end

-- ==================== SETTINGS CHANGE ====================
function Module:_onSettingChange(evt)
    if not evt then return end
    if evt.path == "physics.telemetryHud" then
        if not self.telemetry then self:_createTelemetry() end
        self.telemetry.Visible = evt.new
    elseif evt.path == "videoMode" then
        if evt.new ~= self.videoMode then self:toggleVideoMode() end
    end
end

-- ==================== SHIFT / LAUNCH NOTIFICATIONS ====================
function Module:_onShift(evt)
    if evt.emergency then
        self:notify("EMERGENCY DOWNSHIFT", 1.2)
    end
end

function Module:_onLaunchRelease(evt)
    local q = evt.quality or "miss"
    if q == "perfect" then
        self:notify("PERFECT LAUNCH!", 1.5)
    elseif q == "good" then
        self:notify("Good launch", 1.2)
    end
end

-- ==================== PANEL DELEGATION ====================
function Module:openPanel()
    if _G.VX.Panel then _G.VX.Panel:open() end
end

function Module:closePanel()
    if _G.VX.Panel then _G.VX.Panel:close() end
end

-- ==================== PUBLIC ====================
function Module:getDashboardRefs()
    return self.dashboardRefs
end

function Module:getTelemetryRefs()
    if not self.telemetryRefs and self.core.settings.physics.telemetryHud then
        self:_createTelemetry()
    end
    return self.telemetryRefs
end

return Module
