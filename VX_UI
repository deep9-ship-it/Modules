function Module:toggleDiagnostics()
    self._diagOpen = not self._diagOpen
    if self._diagFrame then
        self._diagFrame.Visible = self._diagOpen and not self._videoMode
    end
end

function Module:_refreshDiagnostics()
    if not self._diagFrame or not self._diagFrame.Visible then return end
    local now = os.clock()
    if now - self._lastDiagUpdate < 0.25 then return end
    self._lastDiagUpdate = now

    local all = _G.VX.diagnostics and _G.VX.diagnostics.getAll() or {}
    local keys = {}
    for k in pairs(all) do table.insert(keys, k) end
    table.sort(keys)

    for _, k in ipairs(keys) do
        local entry = all[k]
        local lbl = self._diagLabels[k]
        if not lbl then
            lbl = Instance.new("TextLabel")
            lbl.Size = UDim2.new(1, -8, 0, 18)
            lbl.BackgroundTransparency = 1
            lbl.Font = Enum.Font.Code
            lbl.TextSize = 11
            lbl.TextXAlignment = Enum.TextXAlignment.Left
            lbl.TextColor3 = GT3.text
            lbl.Parent = self._diagScroll
            self._diagLabels[k] = lbl
        end
        local status = entry.status
        lbl.TextColor3 = (status == "error") and GT3.crimson or ((status == "warn") and GT3.amber or GT3.text)
        lbl.Text = string.format("%-22s %s %s", entry.schema.label or k, tostring(entry.value), entry.schema.unit or "")
    end
end

function Module:toggleVideoMode()
    _setSetting("videoMode", not _getSetting("videoMode", false))
end

function Module:_enterVideoMode()
    if self._videoMode then return end
    self._videoMode = true
    self._hiddenGuis = {}

    if self._dash then self._dash.Visible = false end
    if self._notifContainer then self._notifContainer.Visible = false end
    if self._telFrame then self._telFrame.Visible = false end
    if self._diagFrame then self._diagFrame.Visible = false end

    local player = Players.LocalPlayer
    local pg = player and player:FindFirstChild("PlayerGui")
    if pg then
        for _, child in ipairs(pg:GetChildren()) do
            if child:IsA("ScreenGui") and child ~= self._gui and child.Name ~= "VX_Panel" then
                self._hiddenGuis[child] = child.Enabled
                child.Enabled = false
            end
        end
    end

    if _G.VX.Panel and type(_G.VX.Panel.setHidden) == "function" then
        _G.VX.Panel:setHidden(true)
    end
end

function Module:_exitVideoMode()
    if not self._videoMode then return end
    self._videoMode = false

    for gui, wasEnabled in pairs(self._hiddenGuis) do
        if gui and gui.Parent then
            gui.Enabled = wasEnabled
        end
    end
    self._hiddenGuis = {}

    if self._notifContainer then self._notifContainer.Visible = true end
    if self._telFrame then self._telFrame.Visible = _getSetting("physics.telemetryHud", false) end
    if self._diagFrame then self._diagFrame.Visible = self._diagOpen end

    if _G.VX.Panel and type(_G.VX.Panel.setHidden) == "function" then
        _G.VX.Panel:setHidden(false)
    end
end

function Module:_update()
    if not self._dash then return end
    local st = self.state:getVehicleState()
    local active = (st ~= "Disabled" and st ~= "Exiting") and not self._videoMode
    self._dash.Visible = active

    if self._diagFrame and self._diagFrame.Visible then
        self:_refreshDiagnostics()
    end
    if not active then return end

    local auth = _G.VX.Authority
    local handle = auth and auth:getHandle()
    local velPart = handle and ((handle.root and handle.root.PrimaryPart) or handle.platform or handle.chassis or handle.seat)
    local rawSpeed = velPart and velPart.AssemblyLinearVelocity.Magnitude or 0
    local speedMph = rawSpeed * 0.626
    self._speedLbl.Text = tostring(math.floor(speedMph + 0.5))

    local gear = self.powertrain:getGear()
    self._gearLbl.Text = (gear == -1) and "R" or ((gear == 0) and "N" or tostring(gear))

    local prof = self.profiles:current()
    local maxRpm = (prof and prof.maxRPM) or 8500
    local redline = (prof and prof.redlineRPM) or 8200
    local rpm = self.powertrain:getRPM() or 900
    local pct = math.clamp(rpm / maxRpm, 0, 1)
    local redPct = math.clamp(redline / maxRpm, 0.5, 0.98)

    self._rpmLbl.Text = string.format("%d RPM", math.floor(rpm))
    self._rpmFill.Size = UDim2.new(pct, 0, 1, 0)
    self._rpmFill.BackgroundColor3 = (rpm >= redline * 0.96) and GT3.crimson or ((rpm >= redline * 0.82) and GT3.amber or GT3.green)
    self._redMark.Position = UDim2.new(redPct, 0, 0, -1)

    local ledPct = math.clamp((rpm - prof.idleRPM) / math.max(1, redline - prof.idleRPM), 0, 1)
    local litCount = math.floor(ledPct * 12 + 0.3)
    local flashRed = (rpm >= redline * 0.96) and ((os.clock() * 14) % 1 > 0.5)
    for i = 1, 12 do
        local led = self._shiftLeds[i]
        if flashRed then
            led.BackgroundColor3 = GT3.crimson
        elseif i <= litCount then
            led.BackgroundColor3 = (i >= 10) and GT3.crimson or ((i >= 6) and GT3.amber or GT3.green)
        else
            led.BackgroundColor3 = GT3.carbonCard
        end
    end

    local psi = self.drive:getBoost() or 0
    local stg = _getSetting("turboStage", 1)
    local customMult = _getSetting("turboCustomMultiplier", 1.0)
    local stageCfg = self.core.config and self.core.config.turboStages and self.core.config.turboStages[stg]
    local maxPsi = ((stageCfg and stageCfg.targetBoostPSI) or 21) * customMult
    self._boostLbl.Text = string.format("%.1f PSI", psi)
    self._boostFill.Size = UDim2.new(math.clamp(psi / math.max(1, maxPsi), 0, 1), 0, 1, 0)

    local smoothed = self.powertrain:getSmoothedThrottle() or 0
    local thr = math.max(0, smoothed)
    local brk = math.max(0, -smoothed)
    self._thrFill.Size = UDim2.new(math.clamp(thr, 0, 1), 0, 1, 0)
    self._brkFill.Size = UDim2.new(math.clamp(brk, 0, 1), 0, 1, 0)

    local dt = _getSetting("drivetrain", "AWD")
    local dm = string.upper(tostring(_getSetting("weightTransferMode", "Normal")))
    local hp = (self.drive.getHorsepower and self.drive:getHorsepower()) or 0
    self._metaLbl.Text = string.format("%s | %s | STG %d | %dHP | %s", dt, dm, stg, math.floor(hp + 0.5), prof and prof.name or "Default")

    local absCount = self.drive._absActivations or 0
    if absCount > self._lastAbsCount then
        self._lastAbsCount = absCount
        self._lastAbsTime = os.clock()
    end
    local absLive = (os.clock() - self._lastAbsTime) < 0.35

    local spinning = self.chassis.spinActive == true
    local flags = {}
    if _getSetting("physics.tractionControl", false) and spinning then table.insert(flags, "TCS") end
    if absLive then table.insert(flags, "ABS") end
    if self.powertrain:isRevLimiting() then table.insert(flags, "REV") end
    if self.powertrain:isTwostepActive() then table.insert(flags, "2-STEP") end
    if self.powertrain:getShiftState() == "open" then table.insert(flags, "CLUTCH") end
    if self.powertrain:getLaunchState() == "holding" then table.insert(flags, "LAUNCH") end
    if spinning then table.insert(flags, "SLIP") end
    self._flagsLbl.Text = table.concat(flags, " • ")
    self._flagsLbl.TextColor3 = spinning and GT3.amber or GT3.green

    local bNorm = math.clamp(self.drive.brakeTemp or 0, 0, 1)
    local bDeg = 60 + bNorm * 640
    self._brakeTempLbl.Text = string.format("BRK %.0fC", bDeg)
    self._brakeTempLbl.TextColor3 = (bNorm >= 0.75) and GT3.crimson or ((bNorm >= 0.45) and GT3.amber or GT3.muted)

    if self._telFrame and self._telFrame.Visible then
        local fTemp = 40 + (self.chassis:getTireTemp("front") or 0) * 90
        local rTemp = 40 + (self.chassis:getTireTemp("rear") or 0) * 90
        local hpMode = _getSetting("customHorsepower", false) and "Custom" or "Auto"
        self._telLabels.State.Text = string.format("State:    %s", st)
        self._telLabels.Speed.Text = string.format("Speed:    %.1f MPH", speedMph)
        self._telLabels.Power.Text = string.format("Power:    %d HP (%s)", math.floor(hp + 0.5), hpMode)
        self._telLabels.RPM.Text = string.format("RPM:      %d / %d", math.floor(rpm), maxRpm)
        self._telLabels.Gear.Text = string.format("Gear:     %s", self._gearLbl.Text)
        self._telLabels.Boost.Text = string.format("Boost:    %.1f / %.0f PSI", psi, maxPsi)
        self._telLabels.Throttle.Text = string.format("Throttle: %.0f%% | Brk: %.0f%%", thr * 100, brk * 100)
        self._telLabels.Slip.Text = string.format("Slip:     %.2f (%s)", self.chassis.slipRatio or 0, spinning and "SPIN" or "GRIP")
        self._telLabels.Slope.Text = string.format("Slope:    %.1f deg", self.chassis.slopeAngle or 0)
        self._telLabels.Grip.Text = string.format("Grip:     F:%.2f R:%.2f", self.chassis.combinedFrontGrip or 0, self.chassis.combinedRearGrip or 0)
        self._telLabels.Tires.Text = string.format("Tires:    F:%.0fC R:%.0fC", fTemp, rTemp)
        self._telLabels.Brakes.Text = string.format("Brakes:   %.0f C", bDeg)
    end
end

function Module:heartbeat()
    return self._gui ~= nil and self._gui.Parent ~= nil
end

function Module:Stop()
    self:_exitVideoMode()
    self:_clearConns()
    if self._gui then
        self._gui:Destroy()
        self._gui = nil
    end
    self.gui = nil
    _G.VX.UI = nil
end

return Module
